function usb_gadget_is_active () {
  local lunfile=/sys/kernel/config/usb_gadget/sentryusb/configs/c.1/mass_storage.0/lun.0/file
  [ -n "$(cat /sys/kernel/config/usb_gadget/sentryusb/UDC 2>/dev/null)" ] &&
    [ -e "$lunfile" ] &&
    [ -n "$(cat "$lunfile")" ]
}

function check_if_usb_gadget_is_mounted () {
  # Idle recovery only: do not cycle for pending media while the gadget is up
  # (would thrash Travel Mode / stay-connected paths).
  if usb_gadget_is_active
  then
    return
  fi

  log "USB Gadget not mounted. Fixing files and remounting..."
  ensure_usb_drives_connected || log "ERROR: failed to recover inactive USB gadget"
}

function trim_free_space() {
  local mount_point="$1"

  # Make sure the partition is mounted.
  if found=$(findmnt -n --mountpoint "$mount_point")
  then
    loop=$(echo "$found" | awk '{print $2}')
    image=$(losetup -l -n --output=BACK-FILE "$loop")
    log "Trimming free space in $mount_point, which has $(filefrag "$image" | awk '{print $2}') extents"
    if fstrim "$mount_point" >> "$LOG_FILE" 2>&1
    then
      log "Trim complete, image now has $(filefrag "$image" | awk '{print $2}') extents"
    else
      log "Trimming free space in $mount_point failed."
    fi
  else
    log "Could not trim free space in $mount_point. Not Mounted."
  fi
}

# Returns IMAGE_STILL_MOUNTED, and stops, as soon as an image may still be
# mounted by a reclaim. Other fsck problems are logged but not returned.
function fix_errors_in_images () {
  local rc
  for i in cam music boombox lightshow wraps
  do
    img="/backingfiles/${i}_disk.bin"
    if [ -e "$img" ]
    then
      rc=0
      fix_errors_in_image "$img" || rc=$?
      [ "$rc" -ne "$IMAGE_STILL_MOUNTED" ] || return "$IMAGE_STILL_MOUNTED"
    fi
  done
}

function disconnect_usb_drives_from_host () {
  with_gadget_lock disconnect_usb_drives_from_host_locked
}

function disconnect_usb_drives_from_host_locked () {
  status_led_archive working 2>/dev/null || true
  log "Disconnecting usb from host..."
  if /root/bin/disable_gadget.sh
  then
    if ! fix_errors_in_images
    then
      log "ERROR: a disk image may still be mounted; not mounting it again"
      return 1
    fi
  else
    log "ERROR: disable_gadget.sh failed (exit $?), skipping fsck"
    return 1
  fi
  log "Disconnected usb from host."
}

function convert_seconds_to_nice_time () {
  local -r h=$(($1/3600))
  local -r m=$((($1%3600)/60))
  local -r s=$(($1%60))

  if [ $h -gt 0 ]
  then
    printf "%dh%dm%ds" $h $m $s
  elif [ $m -gt 0 ]
  then
    printf "%dm%ds" $m $s
  else
    printf "%ds" $s
  fi
}

function notification_duration {
  local seconds=$1 h m s
  (( seconds < 0 )) && seconds=0
  h=$((seconds / 3600)); m=$((seconds % 3600 / 60)); s=$((seconds % 60))
  if (( h > 0 )); then
    printf '%dh' "$h"
    if (( m > 0 )); then printf ' %dm' "$m"; fi
  elif (( m > 0 )); then
    printf '%dm' "$m"
    if (( s > 0 )); then printf ' %ds' "$s"; fi
  else
    printf '%ds' "$s"
  fi
}

function archive_start_summary {
  local total=$1 completed=${2:-0} original_total=${3:-$1} noun=files
  if [[ $completed -gt 0 ]]; then
    printf '%d/%d Archived, resuming archive after reconnect.' "$completed" "$original_total"
    return
  fi
  if [[ $total -eq 1 ]]; then noun=file; fi
  printf 'Archiving %d %s.' "$total" "$noun"
}

function archive_resume_context () {
  python3 - "$1" "$2" "${3:-/mutable/archive_in_progress.json}" <<'PYRESUME'
import hashlib, json, sys
from pathlib import Path

entries = Path(sys.argv[1]).read_bytes().splitlines()
fingerprint = hashlib.sha256(b"\n".join(sorted(entries))).hexdigest()
total = int(sys.argv[2])
completed, offset, original_total = 0, 0, total
try:
    saved = json.loads(Path(sys.argv[3]).read_text())
    current, previous, original = saved["current"], saved["resume_offset"], saved["resume_total"]
    if (saved["candidate_hash"] == fingerprint and saved["total"] == total == len(entries)
            and all(type(n) is int for n in (saved["total"], current, previous, original))
            and 0 <= current <= total and 0 <= previous <= original <= 2**63 - 1
            and original == previous + total):
        completed, offset, original_total = previous + current, previous, original
except (OSError, ValueError, KeyError, TypeError):
    pass
print(fingerprint, completed, offset, original_total)
PYRESUME
}

function write_archive_checkpoint () {
  local progress="$1" fingerprint="$2" offset="$3" total="$4"
  local checkpoint="${5:-/mutable/archive_in_progress.json}"
  printf '%s,"candidate_hash":"%s","resume_offset":%s,"resume_total":%s}\n' \
    "${progress%\}}" "$fingerprint" "$offset" "$total" > "$checkpoint.tmp" && mv "$checkpoint.tmp" "$checkpoint"
}

function finish_archive_checkpoint () {
  local success="$1" cancelled="$2" remaining_list="$3" remaining="$4" offset="$5" total="$6"
  local checkpoint="${7:-/mutable/archive_in_progress.json}" fingerprint
  if [[ "$success" == true || "$cancelled" == true || "$remaining" -eq 0 ]]; then
    rm -f "$checkpoint"
    return
  fi
  read -r fingerprint _ < <(archive_resume_context "$remaining_list" "$remaining" /dev/null)
  [[ -n "$fingerprint" ]] || return 1
  write_archive_checkpoint "{\"phase\":\"archiving\",\"current\":0,\"total\":$remaining}" \
    "$fingerprint" "$offset" "$total" "$checkpoint"
}

function archive_finish_summary {
  local success=$1 total=$2 completed=$3 elapsed=$4 noun=files remaining
  if [[ $completed -eq 1 ]]; then noun=file; fi
  remaining=$((total - completed))
  if (( remaining < 0 )); then remaining=0; fi
  if [[ $success == true ]]; then
    printf 'Archived %d %s in %s.' "$completed" "$noun" "$(notification_duration "$elapsed")"
  else
    printf 'Archive interrupted — %d %s archived, %d remaining.' "$completed" "$noun" "$remaining"
  fi
}

function filterfile {
  if [ -x /root/bin/archive-filter ]
  then
    /root/bin/archive-filter "$1"
  fi
}

function sortfile {
  touch "$1"
  sort "$1" > /tmp/sort_tmp.$$
  mv /tmp/sort_tmp.$$ "$1"
}

function prunefile {
  sortfile "$1"
  sortfile "$2"
  comm -2 -3 "$1" "$2" > /tmp/prune_tmp.$$
  mv /tmp/prune_tmp.$$ "$1"
}

# True while /backingfiles is a mount point. One fork-free read so the loop
# below can re-prove the mount cheaply. Only the mountpoint field can be a
# space-delimited path (/proc escapes spaces); unreadable proves nothing.
function backingfiles_is_mounted () {
  local mounts
  mounts=$(</proc/self/mounts) || return 1
  case "$mounts" in
    *" /backingfiles "*) return 0 ;;
  esac
  return 1
}

# Classify list entries the stat pass could not read: only entries whose
# source is provably gone are written to $2. Any ambiguous error (EIO,
# ESTALE, permission, mount outage) is left out so it stays counted.
function classify_missing_entries () {
  local -r listfile="$1"
  local -r outfile="$2"
  local -r root="$3"
  local entry err target snap
  local checked=0
  true > "$outfile"
  # A stale directory under an unmounted /backingfiles would look like proof
  # that every snapshot is gone, suppressing the whole backlog. Without a
  # proven mount, drop nothing.
  backingfiles_is_mounted || return 0
  while IFS= read -r entry
  do
    [ -n "$entry" ] || continue
    # Re-prove the mount every 32 entries: an unmount part-way through would
    # make every later entry look absent. The outage may predate any entry
    # already classified, so discard the whole run rather than trust it.
    checked=$((checked + 1))
    if [ $((checked % 32)) -eq 0 ] && ! backingfiles_is_mounted
    then
      true > "$outfile"
      return 0
    fi
    # Readable again since the batch pass: nothing to drop.
    err=$(LC_ALL=C stat -L --format='%s' "${root}/${entry}" 2>&1 >/dev/null) && continue
    # stat prints "stat: cannot stat '<path>': <errno>"; keep only the text
    # after the last ": " so a path containing an errno phrase cannot match.
    case "${err##*: }" in
      "No such file or directory"*) ;;
      *) continue ;;
    esac
    target=""
    if [ -L "${root}/${entry}" ]
    then
      target=$(readlink "${root}/${entry}" || true)
    fi
    case "$target" in
      /backingfiles/snapshots/snap-*|/tmp/snapshots/snap-*)
        snap=${target#/backingfiles/snapshots/}
        snap=${snap#/tmp/snapshots/}
        snap=${snap%%/*}
        if [ ! -d "/backingfiles/snapshots/${snap}" ]
        then
          # The mount is proven above, so an absent snapshot dir is real.
          echo "$entry" >> "$outfile"
        elif [ -d "/backingfiles/snapshots/${snap}/mnt/TeslaCam" ]
        then
          # That probe triggers the autofs mount, so the first stat may have
          # failed only because it had not mounted yet. Re-stat the clip and
          # drop it only if it is still absent.
          err=$(LC_ALL=C stat -L --format='%s' "${root}/${entry}" 2>&1 >/dev/null) && continue
          case "${err##*: }" in
            "No such file or directory"*) echo "$entry" >> "$outfile" ;;
          esac
        fi
        ;;
    esac
  done < "$listfile"
  # Final batch: without this an unmount in the last <32 entries goes unseen.
  if ! backingfiles_is_mounted
  then
    true > "$outfile"
  fi
}

function intersect {
  sortfile "$1"
  sortfile "$2"
  comm -1 -2 "$1" "$2" > /tmp/prune_tmp.$$
  mv /tmp/prune_tmp.$$ "$1"
}

# ── Archive verification ───────────────────────────────────────────────────
#
# After clips are moved to the archive server, check each one by SHA-256:
# hash the copy on the Pi (the snapshot the clip was sent from) and the copy
# on the server, and compare. Results go to a ledger the Snapshots page
# reads to tag snapshots "Verified on archive".
#
#   ARCHIVE_VERIFY_QUEUE   clips still to check, one per line:
#                          "<archive relpath>\t<Pi source path>\t<size>\t<sha256>\t<queued unix>"
#                          size/sha256 are "-" except on re-checks (so a
#                          re-check still works after the source snapshot
#                          is gone). Older lines without the last fields are
#                          read as "-" and stamped when first seen.
#                          Durable, so clips archived just before the car
#                          leaves are checked the next time it's home.
#   ARCHIVE_VERIFY_LEDGER  one line per check:
#                          "<relpath>\t<size>\t<sha256>\t<unix>\t<status>\t<times verified>\t<Pi source path>"
#                          status: ok | ok_quick | converted | converted_unconfirmed |
#                                  mismatch | missing | nosource
#                          ok_quick: matched by the quick check (size, moov
#                          index and video slices; SMB/NFS without Manager's
#                          record). Counts like ok.
#                          converted: Sentry Manager re-encoded the server copy
#                          in place (H.265/AV1), and the original is confirmed
#                          by Manager's checksum record or by an earlier match.
#                          Counts like ok. converted_unconfirmed: re-encoded
#                          before anything could confirm the original. Kept,
#                          never re-sent, never counts toward auto-delete.
#                          ok_basic / converted_basic: matched by the basic
#                          check (ARCHIVE_VERIFY_MODE=basic, SMB/NFS): size,
#                          codec, frame count, duration and every frame's
#                          size from the MP4 index; for converted_basic the
#                          server copy is Manager's re-encode and the frame
#                          count and duration match. The sha256 field then
#                          holds "basic:<fingerprint>". Both count like ok.
#                          "times verified" counts consecutive ok checks of
#                          the same bytes; any failure resets it to 0.
#
# A mismatched server copy is renamed to "<name>.mismatch-<unix>" (never
# deleted) and a missing one is noted; both are dropped from the
# archived-files list so the next archive cycle sends them again from the
# snapshot, and the re-sent copy is verified like any other.
#
# Optional auto-delete (ARCHIVE_AUTO_DELETE_VERIFIED=true, off by default,
# toggled in Settings): once every clip in a snapshot has been verified
# twice, at least ARCHIVE_VERIFY_RECHECK_SECONDS apart, the snapshot is
# released from the Pi. See auto_delete_verified_snapshots for the rules.
#
# sentryusb.conf settings, read fresh each cycle so the Settings toggles
# apply without a restart:
#   ARCHIVE_VERIFY=false              turn verification off (default on)
#   ARCHIVE_AUTO_DELETE_VERIFIED=true delete snapshots verified twice (default off)
#   ARCHIVE_TRUST_UNCONFIRMED_CONVERSIONS=true
#                                     count clips Sentry Manager re-encoded
#                                     before anything confirmed the original
#                                     (converted_unconfirmed) as verified, so
#                                     auto-delete can clear old snapshots.
#                                     Relies on Manager's own conversion
#                                     checks for them (default off)
#   ARCHIVE_VERIFY_MAX_SECONDS        time budget per cycle (default 1800);
#                                     the rest stays queued for next cycle
#   ARCHIVE_VERIFY_RECHECK_SECONDS    minimum gap before the second check
#                                     (default 3600)
ARCHIVE_VERIFY_QUEUE=/mutable/archive_verify_pending
ARCHIVE_VERIFY_LEDGER=/mutable/archive_verified.tsv
ARCHIVE_VERIFY_WORK=/tmp/archive-verify

# Print a setting from sentryusb.conf, read fresh (same file search order
# and isolated-subshell parsing as travel_mode_active).
function archive_conf_value () {
  local conf
  for conf in /root/sentryusb.conf /boot/firmware/sentryusb.conf /boot/sentryusb.conf
  do
    [ -f "$conf" ] || continue
    # shellcheck disable=SC1090 # the device config, absent in the checkout
    ( set +eu; . "$conf" >/dev/null 2>&1; printf '%s' "${!1:-}" )
    return 0
  done
  printf '%s' "${!1:-}"
}

function archive_verify_enabled () {
  [ "${ARCHIVE_SYSTEM:-none}" != "none" ] || return 1
  local v
  v=$(archive_conf_value ARCHIVE_VERIFY)
  case "${v,,}" in
    false|no|0|off) return 1 ;;
  esac
  return 0
}

function archive_auto_delete_enabled () {
  local v
  v=$(archive_conf_value ARCHIVE_AUTO_DELETE_VERIFIED)
  case "${v,,}" in
    true|yes|1|on) return 0 ;;
  esac
  return 1
}

# Record where each clip about to be archived really lives:
# "<relpath>\t<link target>" (target empty for a plain file). find's %l is a
# single-level readlink, so building this never mounts a snapshot.
function record_archive_link_targets () {
  local lower=$1 list=$2 out=$3
  : > "$out" 2>/dev/null || return 0
  archive_verify_enabled || return 0
  [ -s "$list" ] || return 0
  (cd "$lower" && grep -v $'\t' "$list" |
     xargs -r -d '\n' sh -c 'find "$@" -maxdepth 0 -printf "%p\t%l\n"' _) > "$out" 2>/dev/null || true
}

# Queue the clips archived this cycle for verification. $1 lists their
# relpaths, $2 is the record_archive_link_targets output, $3 the link farm.
function queue_archived_for_verification () {
  local archived=$1 targets=$2 lower=$3
  archive_verify_enabled || return 0
  [ -s "$archived" ] || return 0
  [ -e "$targets" ] || : > "$targets"
  awk -F'\t' -v lower="$lower" -v targets="$targets" -v now="$(date +%s)" '
    FILENAME == targets { t[$1] = $2; next }
    $0 != "" {
      target = ($0 in t) ? t[$0] : ""
      if (target == "") {
        target = lower "/" $0
      } else if (substr(target, 1, 1) != "/") {
        dir = $0; sub(/[^\/]*$/, "", dir); target = lower "/" dir target
      }
      print $0 "\t" target "\t-\t-\t" now
    }' "$targets" "$archived" >> "$ARCHIVE_VERIFY_QUEUE" ||
    log "WARNING: could not queue archived clips for verification"
}

# The ssh command used for the rsync archive, as an array in ssh_cmd.
function archive_ssh_command () {
  if [ -n "${RSYNC_RSH:-}" ]; then
    read -r -a ssh_cmd <<< "$RSYNC_RSH"
  else
    ssh_cmd=(ssh -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=3)
    [ -z "${RSYNC_SSH_PORT:-}" ] || ssh_cmd+=(-p "$RSYNC_SSH_PORT")
  fi
}

# Print "<sha256>\t<relpath>" for each relpath in $1 as stored on the
# archive server. A file that isn't there prints nothing. Returns non-zero
# only when the server could not be asked at all, so "not there" is never
# confused with "couldn't check".
function archive_remote_sha256 () {
  local rels=$1 rc=0
  case "${ARCHIVE_SYSTEM:-none}" in
    cifs|nfs)
      # The share is mounted here, so the Pi reads the server's copy back.
      timeout 10 [ -d "${ARCHIVE_MOUNT:-}" ] || return 1
      # Several clips at once, at most one per core: hashing whole clips
      # is CPU work on the Pi. A clip that isn't there is skipped (the
      # caller treats it as absent); a read error fails the batch.
      local par out="$ARCHIVE_VERIFY_WORK/readback-sums"
      par=$(archive_verify_parallel)
      [ "$par" -le 4 ] || par=4
      # shellcheck disable=SC2016 # expanded by the child bash
      xargs -d '\n' -P "$par" -n 1 bash -c '
        f="$0/$1"
        [ -f "$f" ] || exit 0
        if s=$(timeout 900 ionice -c2 -n7 nice -n19 sha256sum < "$f")
        then printf "%s\t%s\n" "${s%% *}" "$1"
        else printf "ERROR\t%s\n" "$1"
        fi' "$ARCHIVE_MOUNT" < "$rels" > "$out" || true
      ! grep -q '^ERROR' "$out" || return 1
      cat "$out"
      ;;
    rsync)
      # The server hashes its own copies; only the hashes cross the network.
      local -a ssh_cmd
      archive_ssh_command
      local remote
      remote="cd $(printf %q "$RSYNC_PATH") && if command -v sha256sum >/dev/null 2>&1; then xargs -0 sha256sum --; else xargs -0 shasum -a 256 --; fi"
      tr '\n' '\0' < "$rels" |
        timeout 1800 "${ssh_cmd[@]}" "$RSYNC_USER@$RSYNC_SERVER" "$remote" > "$ARCHIVE_VERIFY_WORK/rsync-out" 2>/dev/null || rc=$?
      # 123: xargs saw some files fail (not on the server); the rest hashed.
      [ "$rc" = 0 ] || [ "$rc" = 123 ] || return 1
      awk 'substr($0, 65, 2) == "  " && substr($0, 1, 64) ~ /^[0-9a-f]+$/ { print substr($0, 1, 64) "\t" substr($0, 67) }' "$ARCHIVE_VERIFY_WORK/rsync-out"
      ;;
    rclone)
      local -a rc_cmd=(rclone --config /root/.config/rclone/rclone.conf hashsum sha256 --files-from "$rels")
      # Ask the backend for stored SHA-256s first; backends that don't keep
      # them (or leave some blank) are re-checked by downloading.
      if ! timeout 1800 "${rc_cmd[@]}" "$RCLONE_DRIVE:$RCLONE_PATH" > "$ARCHIVE_VERIFY_WORK/rclone-out" 2>/dev/null ||
         awk '!(substr($0, 65, 2) == "  " && substr($0, 1, 64) ~ /^[0-9a-f]+$/) { bad = 1 } END { exit !bad }' "$ARCHIVE_VERIFY_WORK/rclone-out"
      then
        timeout 3600 "${rc_cmd[@]}" --download "$RCLONE_DRIVE:$RCLONE_PATH" > "$ARCHIVE_VERIFY_WORK/rclone-out" 2>/dev/null || rc=$?
        # rclone exits non-zero for missing files too; with no output at all
        # the remote couldn't be read.
        [ "$rc" = 0 ] || [ -s "$ARCHIVE_VERIFY_WORK/rclone-out" ] || return 1
      fi
      awk 'substr($0, 65, 2) == "  " && substr($0, 1, 64) ~ /^[0-9a-f]+$/ { print substr($0, 1, 64) "\t" substr($0, 67) }' "$ARCHIVE_VERIFY_WORK/rclone-out"
      ;;
    *)
      return 1
      ;;
  esac
}

# Rename the server's copy of $1 aside so the next cycle sends a fresh one.
function archive_set_aside_remote () {
  local rel=$1 aside
  aside="$1.mismatch-$(date +%s)"
  case "${ARCHIVE_SYSTEM:-none}" in
    cifs|nfs) timeout 60 mv -f -- "$ARCHIVE_MOUNT/$rel" "$ARCHIVE_MOUNT/$aside" ;;
    rsync)
      local -a ssh_cmd
      archive_ssh_command
      timeout 60 "${ssh_cmd[@]}" "$RSYNC_USER@$RSYNC_SERVER" \
        "cd $(printf %q "$RSYNC_PATH") && mv -f -- $(printf %q "$rel") $(printf %q "$aside")" ;;
    rclone)
      timeout 300 rclone --config /root/.config/rclone/rclone.conf moveto \
        "$RCLONE_DRIVE:$RCLONE_PATH/$rel" "$RCLONE_DRIVE:$RCLONE_PATH/$aside" ;;
    *) return 1 ;;
  esac
}

# Re-encoded footage. Sentry Manager can convert clips on the share to
# H.265/AV1 in place (its "replace" output mode), keeping the name. The
# converted file can't match the Pi's SHA-256, and must not be treated as
# damaged: renaming it aside and re-sending the original would undo the
# conversion and loop forever. A server copy that differs is "converted" when
# its video track is H.265/AV1 and the Pi's copy isn't. The codec is read from
# the MP4 sample-entry tag (hvc1/hev1 for H.265, av01 for AV1) in the first and
# last MiB of the file, where the moov box lives (Tesla writes it last,
# re-encoders usually first), so a check never reads a whole clip.
#
# The tag is matched where the MP4 structure puts it: an `stsd` box name,
# then 12 bytes (version/flags, entry count, the entry's size), then the
# entry's format. Matching the four letters anywhere was not enough: in 2 MiB
# of ordinary H.264 data "hvc1"/"hev1"/"av01" turn up by chance about once
# in 700 clips, which would have marked a good upload as re-encoded. The
# bytes are compared as an od hex dump (one space-separated pair per byte,
# so a match can't straddle two bytes), since grep can't safely match raw
# binary across NUL and newline bytes. grep -c (not -q) reads all of its
# input: -q would stop at the first match and break the pipe, which
# pipefail would report as failure.
ARCHIVE_REENCODED_SAMPLE_ENTRY=' 73 74 73 64( [0-9a-f]{2}){12} (68 76 63 31|68 65 76 31|61 76 30 31)'

# True if the MP4 bytes on stdin hold an H.265/AV1 video sample entry.
function archive_stream_is_reencoded () {
  od -An -v -tx1 | tr -d '\n' | grep -c -E "$ARCHIVE_REENCODED_SAMPLE_ENTRY" >/dev/null
}

# True if the local file $1 is already H.265/AV1.
function archive_local_is_reencoded () {
  [ -f "$1" ] || return 1
  { head -c 1048576 -- "$1"; tail -c 1048576 -- "$1"; } 2>/dev/null |
    archive_stream_is_reencoded
}

# True if the archive server's copy of relpath $1 is H.265/AV1.
function archive_remote_is_reencoded () {
  local rel=$1
  case "${ARCHIVE_SYSTEM:-none}" in
    cifs|nfs)
      # shellcheck disable=SC2016 # $1 is expanded by the inner bash
      timeout 120 bash -c '{ head -c 1048576 -- "$1"; tail -c 1048576 -- "$1"; } 2>/dev/null' _ "$ARCHIVE_MOUNT/$rel" |
        archive_stream_is_reencoded ;;
    rsync)
      local -a ssh_cmd
      archive_ssh_command
      local remote
      remote="cd $(printf %q "$RSYNC_PATH") && { head -c 1048576 -- $(printf %q "$rel"); tail -c 1048576 -- $(printf %q "$rel"); } 2>/dev/null"
      timeout 120 "${ssh_cmd[@]}" "$RSYNC_USER@$RSYNC_SERVER" "$remote" |
        archive_stream_is_reencoded ;;
    rclone)
      local -a rc_cmd=(rclone --config /root/.config/rclone/rclone.conf cat)
      { timeout 120 "${rc_cmd[@]}" --head 1048576 "$RCLONE_DRIVE:$RCLONE_PATH/$rel"
        timeout 120 "${rc_cmd[@]}" --tail 1048576 "$RCLONE_DRIVE:$RCLONE_PATH/$rel"; } 2>/dev/null |
        archive_stream_is_reencoded ;;
    *) return 1 ;;
  esac
}

# Sentry Manager's record of originals it re-encoded in place, at the share
# root, in sha256sum format ("<sha256>  <relpath>", relpath from the share
# root, one line per clip, written BEFORE the original is replaced). With
# it, a clip Manager converted before the Pi could check it is still
# verified by checksum: the Pi's SHA-256 is compared with Manager's hash of
# the original. Absent file or line: the Pi falls back to the codec check.
ARCHIVE_MANAGER_CHECKSUMS=.sentrymanager/original-checksums.sha256

# Manager's record as the first source of truth. When the record exists on
# the share (Manager is converting in place), a clip's line there is the
# SHA-256 Manager computed on the NAS from the uploaded bytes, before
# converting. Comparing it with the Pi's own hash verifies the upload without
# the Pi reading the clip back. That matters on SMB/NFS, where the only other
# way to hash the server copy is to download all of it. A clip with no line
# yet waits in the queue for Manager to get to it, for up to
# ARCHIVE_VERIFY_MANAGER_WAIT_HOURS (default 24; 0 = never wait), then falls
# back to reading it back, which covers clips Manager never converts.
function archive_manager_record_present () {
  case "${ARCHIVE_SYSTEM:-none}" in
    cifs|nfs) timeout 10 [ -f "${ARCHIVE_MOUNT:-}/$ARCHIVE_MANAGER_CHECKSUMS" ] ;;
    rsync)
      local -a ssh_cmd
      archive_ssh_command
      timeout 30 "${ssh_cmd[@]}" "$RSYNC_USER@$RSYNC_SERVER" \
        "cd $(printf %q "$RSYNC_PATH") && test -f $(printf %q "$ARCHIVE_MANAGER_CHECKSUMS")" 2>/dev/null ;;
    rclone)
      timeout 60 rclone --config /root/.config/rclone/rclone.conf lsf \
        "$RCLONE_DRIVE:$RCLONE_PATH/$ARCHIVE_MANAGER_CHECKSUMS" 2>/dev/null | grep -q . ;;
    *) return 1 ;;
  esac
}

# Print "<sha256>\t<relpath>" from Manager's record for the relpaths in $1.
# Prints nothing (and succeeds) when the record doesn't exist.
function archive_manager_original_sums () {
  local rels=$1 out
  out="$ARCHIVE_VERIFY_WORK/manager-sums"
  : > "$out"
  case "${ARCHIVE_SYSTEM:-none}" in
    cifs|nfs)
      [ -f "$ARCHIVE_MOUNT/$ARCHIVE_MANAGER_CHECKSUMS" ] || return 0
      timeout 120 grep -a -F -f "$rels" -- "$ARCHIVE_MOUNT/$ARCHIVE_MANAGER_CHECKSUMS" > "$out" 2>/dev/null ;;
    rsync)
      # The server filters its own record; only matching lines come back.
      local -a ssh_cmd
      archive_ssh_command
      timeout 120 "${ssh_cmd[@]}" "$RSYNC_USER@$RSYNC_SERVER" \
        "cd $(printf %q "$RSYNC_PATH") && if [ -f $(printf %q "$ARCHIVE_MANAGER_CHECKSUMS") ]; then grep -a -F -f - -- $(printf %q "$ARCHIVE_MANAGER_CHECKSUMS"); fi" \
        < "$rels" > "$out" 2>/dev/null ;;
    rclone)
      timeout 300 rclone --config /root/.config/rclone/rclone.conf cat \
        "$RCLONE_DRIVE:$RCLONE_PATH/$ARCHIVE_MANAGER_CHECKSUMS" 2>/dev/null |
        grep -a -F -f "$rels" > "$out" ;;
  esac
  # grep -F matched substrings; keep exact relpaths only (newest line wins).
  awk -v rels="$rels" '
    FILENAME == rels { want[$0] = 1; next }
    substr($0, 65, 2) == "  " && substr($0, 1, 64) ~ /^[0-9a-f]+$/ {
      rel = substr($0, 67); sub(/^\*/, "", rel)
      if (rel in want) print substr($0, 1, 64) "\t" rel
    }' "$rels" "$out"
  return 0
}

# Pre-hashing. A clip's check has two halves: the Pi's copy and the server's.
# The Pi's half (a full SHA-256 read from the SD card, plus the quick-check
# fingerprint on SMB/NFS) doesn't need the server, and snapshot files never
# change. So it's done ahead of time, in the background after each snapshot
# (precompute_local_hashes), and stored here. At home the verification only
# has the server's half left: with Sentry Manager's record that's a pure
# comparison, with nothing read on either side.
#   "<snapshot file path>\t<size>\t<sha256>\t<quick fingerprint or ->"
# A line counts only while the file's size still matches. Lines for released
# snapshots are dropped by checking the snapshot directory, never the file
# (that would mount every snapshot through autofs).
ARCHIVE_LOCAL_SUMS=/mutable/archive_local_sums.tsv

# Print the stored "<size>\t<sha256>\t<fingerprint>" for snapshot file $1 if
# its size still matches $2.
function archive_cached_local_sum () {
  [ -s "$ARCHIVE_LOCAL_SUMS" ] || return 1
  local line
  line=$(awk -F'\t' -v p="$1" -v sz="$2" '$1 == p && $2 == sz { l = $2 "\t" $3 "\t" $4 } END { if (l != "") print l; else exit 1 }' "$ARCHIVE_LOCAL_SUMS") || return 1
  printf '%s\n' "$line"
}

# Hash clips the Pi holds that aren't hashed yet, at idle I/O priority,
# for at most ARCHIVE_PRECHECK_MAX_SECONDS (default 1200) per run. Stops
# early while an archive cycle runs (it would compete with the upload).
# One run at a time; best effort.
function precompute_local_hashes () {
  archive_verify_enabled || return 0
  # The basic check never hashes whole clips, so there's nothing to prepare.
  ! archive_verify_basic_mode || return 0
  (
    flock -n 8 || exit 0
    local lower=/mutable/TeslaCam work=/tmp/archive-precheck
    local max deadline n=0 rel target size sum fp
    max=$(archive_conf_value ARCHIVE_PRECHECK_MAX_SECONDS)
    [[ "$max" =~ ^[0-9]+$ ]] || max=1200
    deadline=$(( $(uptime_seconds) + max ))
    rm -rf "$work"; mkdir -p "$work" || exit 0
    [ -e "$ARCHIVE_LOCAL_SUMS" ] || : > "$ARCHIVE_LOCAL_SUMS" || exit 0
    # Drop lines for snapshots that are gone.
    awk -F'\t' '{ d = $1; sub(/\/mnt\/.*/, "", d); print d }' "$ARCHIVE_LOCAL_SUMS" | sort -u |
      while IFS= read -r d; do [ -d "$d" ] || echo "$d"; done > "$work/gone"
    if [ -s "$work/gone" ]
    then
      awk -F'\t' -v gone="$work/gone" 'FILENAME == gone { g[$0] = 1; next }
        { d = $1; sub(/\/mnt\/.*/, "", d); if (!(d in g)) print }' "$work/gone" "$ARCHIVE_LOCAL_SUMS" > "$ARCHIVE_LOCAL_SUMS.new" &&
        mv "$ARCHIVE_LOCAL_SUMS.new" "$ARCHIVE_LOCAL_SUMS"
    fi
    # Clips in the link farm (what an archive sends), in folders this
    # device archives, whose snapshot file isn't hashed yet. Newest first:
    # they're the ones the next archive sends.
    local folders=""
    [ "${ARCHIVE_SAVEDCLIPS:-true}" != true ] || folders+=" SavedClips"
    [ "${ARCHIVE_SENTRYCLIPS:-true}" != true ] || folders+=" SentryClips"
    [ "${ARCHIVE_RECENTCLIPS:-false}" != true ] || folders+=" RecentClips"
    [ "${ARCHIVE_TRACKMODECLIPS:-true}" != true ] || folders+=" TeslaTrackMode"
    [ -n "$folders" ] || exit 0
    # shellcheck disable=SC2086 # folder names, split on purpose
    # %p keeps the folder name in the relpath. A folder the car hasn't made
    # yet (TeslaTrackMode, often) makes find exit non-zero; that's fine.
    { (cd "$lower" && find $folders -type l -printf '%p\t%l\n' 2>/dev/null) || true; } |
      awk -F'\t' -v have="$ARCHIVE_LOCAL_SUMS" 'FILENAME == have { h[$1] = 1; next }
        substr($2, 1, 1) == "/" && !($2 in h) { print }' "$ARCHIVE_LOCAL_SUMS" - |
      sort -t$'\t' -k1,1r > "$work/todo"
    local todo_n seen=0
    todo_n=$(wc -l < "$work/todo")
    [ "$todo_n" = 0 ] || archive_work_progress prehashing "Pre-hashing clips on the Pi" 0 "$todo_n"
    while IFS=$'\t' read -r rel target
    do
      [ "$(uptime_seconds)" -lt "$deadline" ] || break
      [ ! -e "$ARCHIVE_CONTROL_DIR/archive-cycle" ] || break
      seen=$((seen + 1))
      # Every clip looked at counts toward the progress, hashed or skipped.
      [ $((seen % 5)) -ne 0 ] || archive_work_progress prehashing "Pre-hashing clips on the Pi" "$seen" "$todo_n"
      size=$(stat -L -c %s -- "$target" 2>/dev/null) || continue
      # Short recordings aren't archived.
      if [ "$size" -lt 100000 ] && [[ "$rel" == *.mp4 ]]; then continue; fi
      sum=$(ionice -c3 nice -n19 sha256sum < "$target" 2>/dev/null) || continue
      fp=-
      if archive_verify_quick_mode
      then
        fp=$(archive_lowprio_fn idle archive_quick_fingerprint "$target" 2>/dev/null) || fp=-
      fi
      printf '%s\t%s\t%s\t%s\n' "$target" "$size" "${sum%% *}" "$fp" >> "$ARCHIVE_LOCAL_SUMS"
      n=$((n + 1))
    done < "$work/todo"
    archive_work_done prehashing
    [ "$n" = 0 ] || log "Pre-hashed $n clip(s) on the Pi for archive verification"
    rm -rf "$work"
  ) 8> /tmp/archive-precheck.lock
}

# Quick check for SMB/NFS shares. Without Sentry Manager's record, the only
# way to SHA-256 the share's copy of a clip is to read all of it back over
# the network (about 30-40 MB per clip). The quick check reads about 300 KB
# instead and compares a fingerprint of each copy:
#   - the size;
#   - the SHA-256 of the MP4's moov box, the index that holds every frame's
#     size, timing and position. Identical moov boxes mean the same frame
#     count, frame rate and frame layout, and a cut-off copy can't pass (its
#     moov is missing or points past the end);
#   - the SHA-256 of four 64 KiB slices of the video data (mdat) at 20, 40,
#     60 and 80 %, to catch corruption inside the video.
# It can miss damage confined to video data between the slices; the full
# check can't. ARCHIVE_VERIFY_MODE=full forces the full read-back (Settings).
# Files under 2 MiB, or that aren't readable MP4s on the Pi, are hashed whole.
ARCHIVE_QUICK_WHOLE_BELOW=2097152

# How many clips verification checks at once (ARCHIVE_VERIFY_PARALLEL,
# default 32, the most allowed; 1-32). The basic and quick checks read little per clip, so
# they wait on the network more than they use it; checking several clips
# at once keeps the link and the SD card busy. Full read-back, which
# hashes whole clips on the Pi's CPU, uses at most 4 (one per core).
function archive_verify_parallel () {
  local n
  n=$(archive_conf_value ARCHIVE_VERIFY_PARALLEL)
  [[ "$n" =~ ^[0-9]+$ ]] || n=32
  [ "$n" -ge 1 ] || n=1
  [ "$n" -le 32 ] || n=32
  echo "$n"
}

# Run shell function $2 (args after it) at low priority: $1 is "low"
# (ionice best-effort 7) or "idle" (ionice idle class), both at nice 19.
# ionice, nice and timeout are separate programs and can't see this
# script's functions, so the function is exported and run by a child bash;
# calling "ionice ... some_function" directly fails with "No such file".
# Optional ARCHIVE_LOWPRIO_TIMEOUT (seconds) bounds the run.
function archive_lowprio_fn () {
  local class=$1 fn=$2
  shift 2
  local -a io=(ionice -c2 -n7)
  [ "$class" != idle ] || io=(ionice -c3)
  local -a limit=()
  [ -z "${ARCHIVE_LOWPRIO_TIMEOUT:-}" ] || limit=(timeout "$ARCHIVE_LOWPRIO_TIMEOUT")
  # shellcheck disable=SC2163 # exports the function named by $fn
  export -f "$fn"
  # shellcheck disable=SC2016 # "$@" is expanded by the child bash
  ARCHIVE_QUICK_WHOLE_BELOW=${ARCHIVE_QUICK_WHOLE_BELOW:-2097152} \
  ARCHIVE_VERIFY_THREADS=${ARCHIVE_VERIFY_THREADS:-1} \
    "${limit[@]}" "${io[@]}" nice -n19 bash -c "$fn"' "$@"' _ "$@"
}

# Print a quick fingerprint of file $1, or fail if it can't be read.
# $2=mp4-only: don't fall back to hashing the whole file (for the share's
# copy, when the Pi's copy is an MP4: a share copy that isn't a readable MP4
# is a mismatch, and downloading it to prove that would defeat the point).
function archive_quick_fingerprint () {
  local f=$1 mode=${2:-} size pos=0 hdr len type n=0
  local moov_off="" moov_len="" mdat_off="" mdat_len="" moovsha slicesha k
  size=$(stat -L -c %s -- "$f" 2>/dev/null) || return 1
  if [ "$size" -lt "$ARCHIVE_QUICK_WHOLE_BELOW" ] && [ "$mode" != mp4-only ]
  then
    printf 'whole:%s:%s\n' "$size" "$(sha256sum < "$f" | cut -c1-64)"
    return
  fi
  # Walk the top-level boxes by their headers: 16 bytes each, a few reads.
  while [ "$pos" -lt "$size" ] && [ "$n" -lt 64 ]
  do
    n=$((n + 1))
    hdr=$(dd if="$f" iflag=skip_bytes,count_bytes skip="$pos" count=16 2>/dev/null | od -An -v -tx1 | tr -d ' \n')
    [ "${#hdr}" -ge 16 ] || break
    len=$((16#${hdr:0:8}))
    type=${hdr:8:8}
    if [ "$len" -eq 1 ]
    then
      [ "${#hdr}" -ge 32 ] || break
      len=$((16#${hdr:16:16}))
    elif [ "$len" -eq 0 ]
    then
      len=$((size - pos))
    fi
    [ "$len" -ge 8 ] || break
    case "$type" in
      6d6f6f76) moov_off=$pos moov_len=$len ;;   # moov
      6d646174) mdat_off=$pos mdat_len=$len ;;   # mdat
    esac
    pos=$((pos + len))
  done
  if [ -z "$moov_off" ] || [ -z "$mdat_off" ] || [ $((moov_off + moov_len)) -gt "$size" ]
  then
    if [ "$mode" = mp4-only ]
    then
      printf 'not-mp4:%s\n' "$size"
    else
      printf 'whole:%s:%s\n' "$size" "$(sha256sum < "$f" | cut -c1-64)"
    fi
    return
  fi
  moovsha=$(dd if="$f" iflag=skip_bytes,count_bytes skip="$moov_off" count="$moov_len" 2>/dev/null | sha256sum | cut -c1-64)
  slicesha=$(for k in 1 2 3 4
    do
      dd if="$f" iflag=skip_bytes,count_bytes skip=$((mdat_off + mdat_len * k / 5)) count=65536 2>/dev/null
    done | sha256sum | cut -c1-64)
  printf 'mp4:%s:%s:%s\n' "$size" "$moovsha" "$slicesha"
}

# The Pi copy's fingerprint: pre-hashed if available, else read now.
function archive_local_quick_fingerprint () {
  local size cached fp
  if size=$(stat -L -c %s -- "$1" 2>/dev/null) && cached=$(archive_cached_local_sum "$1" "$size")
  then
    fp=$(cut -f3 <<< "$cached")
    if [ "$fp" != "-" ] && [ -n "$fp" ]; then printf '%s\n' "$fp"; return 0; fi
  fi
  archive_lowprio_fn low archive_quick_fingerprint "$1"
}

# The share copy's fingerprint, bounded so a hung SMB/NFS mount can't stall
# the archive loop. The function and its size limit are exported to the
# timeout's child bash.
function archive_remote_quick_fingerprint () {
  export -f archive_quick_fingerprint
  # shellcheck disable=SC2016 # $1/$2 are expanded by the inner bash
  ARCHIVE_QUICK_WHOLE_BELOW=$ARCHIVE_QUICK_WHOLE_BELOW timeout 300 \
    bash -c 'archive_quick_fingerprint "$1" "$2"' _ "$ARCHIVE_MOUNT/$1" "$2"
}

# Quick-check fingerprints of the share's copies for a list ($1) of
# "<relpath>\t<Pi fingerprint>\t<mode or ->" lines, ARCHIVE_VERIFY_PARALLEL at a
# time. Prints each line with the share's fingerprint appended, or ABSENT
# when it couldn't be read (asked again after a pause by the caller).
function archive_remote_quick_fingerprints () {
  [ -s "$1" ] || return 0
  export -f archive_quick_fingerprint
  # shellcheck disable=SC2016 # expanded by the child bash
  ARCHIVE_MOUNT=$ARCHIVE_MOUNT ARCHIVE_QUICK_WHOLE_BELOW=$ARCHIVE_QUICK_WHOLE_BELOW \
    xargs -d '\n' -P "$(archive_verify_parallel)" -n 1 bash -c '
      IFS=$'"'"'\t'"'"' read -r rel lfp mode <<< "$1"
      m=$mode; [ "$m" != - ] || m=""
      if rfp=$(timeout 300 bash -c '"'"'archive_quick_fingerprint "$1" "$2"'"'"' _ "$ARCHIVE_MOUNT/$rel" "$m")
      then printf "%s\t%s\t%s\t%s\n" "$rel" "$lfp" "$mode" "$rfp"
      else printf "%s\t%s\t%s\tABSENT\n" "$rel" "$lfp" "$mode"
      fi' _ < "$1"
}

# "<relpath>\t<status>" from two fingerprints. A whole-file fingerprint
# (small files) is a full-content comparison, so it counts as plain ok.
function archive_quick_result () {
  if [ "$2" != "$3" ]; then printf '%s\tmismatch\n' "$1"
  elif [ "${2%%:*}" = whole ]; then printf '%s\tok\n' "$1"
  else printf '%s\tok_quick\n' "$1"
  fi
}

# True when this cycle checks SMB/NFS copies with the quick check rather
# than reading them back whole. Read fresh, like the other settings.
function archive_verify_quick_mode () {
  case "${ARCHIVE_SYSTEM:-none}" in cifs|nfs) ;; *) return 1 ;; esac
  local v
  v=$(archive_conf_value ARCHIVE_VERIFY_MODE)
  [ "${v,,}" != full ]
}

# ARCHIVE_VERIFY_MODE=basic on an SMB/NFS share: compare size and frames
# (see archive_basic_fingerprints) instead of SHA-256. Rsync and rclone
# servers compute SHA-256 themselves, so they always use the full check.
function archive_verify_basic_mode () {
  case "${ARCHIVE_SYSTEM:-none}" in cifs|nfs) ;; *) return 1 ;; esac
  local v
  v=$(archive_conf_value ARCHIVE_VERIFY_MODE)
  [ "${v,,}" = basic ]
}

# Basic-check fingerprints for a list of files ($1, one path per line),
# printed as "<path>\t<fingerprint>". One process for the whole list. For an
# MP4 it reads only the box headers and the moov box (the frame index, tens
# of KB), never the video:
#   mp4:<size>:<codec>:<frames>:<duration ms>:<frame-size table hash>
# The top-level boxes must cover the file exactly, so a cut-off copy can't
# parse. Anything else (not an MP4, or an MP4 that doesn't parse) is hashed
# whole: whole:<size>:<sha256>. A file that isn't there: absent.
function archive_basic_fingerprints () {
  python3 - "$1" <<'PYBASIC'
import hashlib, os, struct, sys

def walk(f, start, end):
    """(type, body start, box end) for each box in [start, end); None if they don't tile it."""
    out, pos = [], start
    while pos < end:
        if end - pos < 8:
            return None
        f.seek(pos)
        h = f.read(8)
        if len(h) < 8:
            return None
        size, typ = struct.unpack(">I4s", h)
        hdr = 8
        if size == 1:
            ext = f.read(8)
            if len(ext) < 8:
                return None
            size, hdr = struct.unpack(">Q", ext)[0], 16
        elif size == 0:
            size = end - pos
        if size < hdr or pos + size > end:
            return None
        out.append((typ, pos + hdr, pos + size))
        pos += size
    return out

def child(f, a, b, name):
    for t, s, e in walk(f, a, b) or []:
        if t == name:
            return s, e
    return None

def u32(f, at):
    f.seek(at)
    return struct.unpack(">I", f.read(4))[0]

def mp4(f, size):
    top = walk(f, 0, size)
    if not top:
        return None
    types = {t for t, _, _ in top}
    if b"moov" not in types or b"mdat" not in types:
        return None
    _, ms, me = next(x for x in top if x[0] == b"moov")
    for t, ts, te in walk(f, ms, me) or []:
        if t != b"trak":
            continue
        mdia = child(f, ts, te, b"mdia")
        if not mdia:
            continue
        hdlr = child(f, *mdia, b"hdlr")
        if not hdlr:
            continue
        f.seek(hdlr[0] + 8)
        if f.read(4) != b"vide":
            continue
        mdhd = child(f, *mdia, b"mdhd")
        minf = child(f, *mdia, b"minf")
        stbl = minf and child(f, *minf, b"stbl")
        stsd = stbl and child(f, *stbl, b"stsd")
        stsz = stbl and child(f, *stbl, b"stsz")
        if not (mdhd and stsd and stsz):
            return None
        f.seek(mdhd[0])
        if f.read(1)[0] == 1:
            f.seek(mdhd[0] + 20)
            scale, dur = struct.unpack(">IQ", f.read(12))
        else:
            f.seek(mdhd[0] + 12)
            scale, dur = struct.unpack(">II", f.read(8))
        f.seek(stsd[0] + 12)
        codec = f.read(4).decode("latin-1")
        const, count = u32(f, stsz[0] + 4), u32(f, stsz[0] + 8)
        f.seek(stsz[0] + 12)
        table = f.read(4 * count) if const == 0 else struct.pack(">I", const)
        if const == 0 and len(table) != 4 * count:
            return None
        ms_ = dur * 1000 // scale if scale else 0
        return "%s:%d:%d:%s" % (codec, count, ms_, hashlib.sha256(table).hexdigest()[:16])
    return None

def fingerprint(path):
    try:
        size = os.stat(path).st_size
    except FileNotFoundError:
        return "absent"
    try:
        with open(path, "rb") as f:
            if path.lower().endswith(".mp4"):
                try:
                    r = mp4(f, size)
                except (struct.error, IndexError, StopIteration, ZeroDivisionError):
                    r = None
                if r:
                    return "mp4:%d:%s" % (size, r)
            f.seek(0)
            h = hashlib.sha256()
            for block in iter(lambda: f.read(1 << 20), b""):
                h.update(block)
            return "whole:%d:%s" % (size, h.hexdigest())
    except OSError:
        return "error"

# Several files at once (ARCHIVE_VERIFY_THREADS): each one is a few small
# reads, so over a network share the time is mostly waiting for replies.
from concurrent.futures import ThreadPoolExecutor
with open(sys.argv[1], encoding="utf-8", errors="surrogateescape") as lst:
    paths = [l.rstrip("\n") for l in lst if l.rstrip("\n")]
try:
    threads = max(1, min(32, int(os.environ.get("ARCHIVE_VERIFY_THREADS", "1"))))
except ValueError:
    threads = 1
with ThreadPoolExecutor(max_workers=threads) as pool:
    for p, fp in zip(paths, pool.map(fingerprint, paths)):
        print("%s\t%s" % (p, fp), flush=True)
PYBASIC
}

# Decide one clip from its basic fingerprints: the Pi's ($1) and the
# server's ($2). Prints ok_basic, converted_basic, converted_unconfirmed or
# mismatch.
#  - identical: ok_basic.
#  - the Pi's copy is H.264 and the server's H.265/AV1 (Sentry Manager's
#    in-place re-encode): converted_basic when the frame count matches and
#    the duration is within 100 ms, or when the frame count differs by one
#    and the duration is within three quarters of a frame (the original's
#    average frame length; on real clips the re-encode's duration lands
#    21-25 ms from a 41.6 ms frame, about 0.6 frame). That covers Manager's two
#    known one-frame cases, where total duration is kept: Tesla's encoder
#    skipping a frame_num across the wrap before an IDR (FFmpeg drops the
#    picture after the gap and the previous frame absorbs its duration), and
#    variable-frame-rate clips. A re-encode that lost its last frame is short
#    by a whole frame, so it doesn't pass. Otherwise converted_unconfirmed
#    (kept and never re-sent, so a re-encode that changes frame timing can't
#    loop, but never auto-deleted either).
#  - anything else: mismatch.
function archive_basic_result () {
  awk -v l="$1" -v r="$2" 'BEGIN {
    if (l == r) { print "ok_basic"; exit }
    nl = split(l, a, ":"); nr = split(r, b, ":")
    if (nl == 6 && nr == 6 && a[1] == "mp4" && b[1] == "mp4" && a[3] == "avc1" &&
        (b[3] == "hvc1" || b[3] == "hev1" || b[3] == "av01")) {
      d = a[5] - b[5]; if (d < 0) d = -d
      f = a[4] - b[4]; if (f < 0) f = -f
      if (a[4] == b[4] && d <= 100) ok = 1
      # One frame apart: duration within 3/4 of one frame (average length).
      else if (f == 1 && a[4] > 0 && d * 4 * a[4] <= 3 * a[5]) ok = 1
      else ok = 0
      print ok ? "converted_basic" : "converted_unconfirmed"
      exit
    }
    print "mismatch"
  }'
}

# A basic fingerprint ($1) for a log line: "H.264 avc1, 2160 frames,
# 60.000 s, 41234567 bytes", or the fingerprint itself when it isn't an MP4.
function archive_basic_describe () {
  awk -v f="$1" 'BEGIN {
    n = split(f, a, ":")
    if (n == 6 && a[1] == "mp4") printf "%s, %d frames, %.3f s, %d bytes\n", a[3], a[4], a[5] / 1000, a[2]
    else print f
  }'
}

# The basic check for one batch of queue lines ($1): fingerprint the Pi's
# copies in one pass and the server's copies in another, compare, and record
# results like verify_archive_batch. No SHA-256 of whole clips, no wait for
# Sentry Manager's record. Returns non-zero if the share couldn't be read.
function verify_archive_batch_basic () {
  local batch=$1 rel src ksize ksum lfp rfp status
  local w="$ARCHIVE_VERIFY_WORK"
  timeout 10 [ -d "${ARCHIVE_MOUNT:-}" ] || return 1
  : > "$w/basic-local-list"
  : > "$w/basic-remote-list"
  while IFS=$'\t' read -r rel src _
  do
    [ -z "$src" ] || printf '%s\n' "$src" >> "$w/basic-local-list"
    printf '%s\n' "$ARCHIVE_MOUNT/$rel" >> "$w/basic-remote-list"
  done < "$batch"
  local ARCHIVE_VERIFY_THREADS
  ARCHIVE_VERIFY_THREADS=$(archive_verify_parallel)
  archive_lowprio_fn low archive_basic_fingerprints "$w/basic-local-list" > "$w/basic-local" 2>/dev/null || true
  ARCHIVE_LOWPRIO_TIMEOUT=600 archive_lowprio_fn low archive_basic_fingerprints "$w/basic-remote-list" > "$w/basic-remote" 2>/dev/null ||
    return 1
  # Briefly absent isn't missing (see verify_archive_batch): ask once more.
  awk -F'\t' '$2 == "absent" { print $1 }' "$w/basic-remote" > "$w/basic-absent"
  if [ -s "$w/basic-absent" ]
  then
    sleep "${ARCHIVE_VERIFY_ABSENT_RECHECK_SECONDS:-20}"
    ARCHIVE_LOWPRIO_TIMEOUT=600 archive_lowprio_fn low archive_basic_fingerprints "$w/basic-absent" >> "$w/basic-remote" 2>/dev/null || true
  fi

  : > "$w/results.raw"
  local now
  now=$(date +%s)
  while IFS=$'\t' read -r rel src ksize ksum _
  do
    lfp=""
    if [ -n "$src" ]
    then
      lfp=$(awk -F'\t' -v p="$src" '$1 == p { v = $2 } END { print v }' "$w/basic-local")
    fi
    case "$lfp" in
      mp4:*|whole:*) ksize=$(cut -d: -f2 <<< "$lfp") ;;
      *)
        # No Pi copy any more: a re-check uses the fingerprint from the
        # first check. A SHA-256 from a full check can't be compared.
        if [[ "${ksum:-}" == basic:* ]]; then lfp=${ksum#basic:}; else lfp=""; fi ;;
    esac
    # Newest answer wins (the re-ask after a pause is appended).
    rfp=$(awk -F'\t' -v p="$ARCHIVE_MOUNT/$rel" '$1 == p { v = $2 } END { print v }' "$w/basic-remote")
    if [ -z "$lfp" ]; then status=nosource
    elif [ "$rfp" = absent ] || [ -z "$rfp" ]; then status=missing
    elif [ "$rfp" = error ]; then return 1
    else status=$(archive_basic_result "$lfp" "$rfp")
    fi
    if [ "$status" = converted_unconfirmed ]
    then
      # Say what differed, so a re-encode that keeps failing can be explained.
      log "Archive verification: $rel was re-encoded on the server but its frames don't match the Pi's copy (Pi: $(archive_basic_describe "$lfp"); server: $(archive_basic_describe "$rfp")); kept, not auto-deleted"
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$rel" "${ksize:--}" "${lfp:+basic:$lfp}" "$now" "$status" "$src" >> "$w/results.raw"
  done < "$batch"
  # times verified: consecutive basic matches of the same Pi copy.
  awk -F'\t' -v OFS='\t' -v prev="$w/prev" '
    FILENAME == prev { ps[$1] = $5; ph[$1] = $3; pc[$1] = $6 + 0; next }
    {
      h = ($3 == "") ? "-" : $3
      count = 0
      if ($5 == "ok_basic" || $5 == "converted_basic")
        count = ((ps[$1] == "ok_basic" || ps[$1] == "converted_basic") && ph[$1] == h) ? pc[$1] + 1 : 1
      print $1, $2, h, $4, $5, count, $6
    }' "$w/prev" "$w/results.raw" > "$w/results"
  rm -f "$w/results.raw"
  archive_verify_finish_batch "size and frames"
}

# Check one batch of queue lines ($1) and append the results to the ledger.
# $ARCHIVE_VERIFY_WORK/prev holds each clip's latest ledger line from before
# this run, which carries the "times verified" count forward.
# Returns non-zero if the server couldn't be asked (the batch stays queued).
function verify_archive_batch () {
  # A clip sent from a snapshot that's since been released is checked
  # against its copy in a newer snapshot.
  archive_resolve_batch_sources "$1" || true
  if archive_verify_basic_mode
  then
    verify_archive_batch_basic "$1"
    return
  fi
  local batch=$1 rel src ksize ksum sum size
  local localsums="$ARCHIVE_VERIFY_WORK/local" rels="$ARCHIVE_VERIFY_WORK/rels"
  local pre="$ARCHIVE_VERIFY_WORK/manager-pre" todo="$ARCHIVE_VERIFY_WORK/todo"
  local readback="$ARCHIVE_VERIFY_WORK/readback"
  : > "$localsums"
  : > "$pre"
  : > "$todo"
  : > "$readback"
  cut -f1 "$batch" > "$rels"

  # With Manager's record on the share: clips with a line are judged from
  # it (no read-back); clips without one wait for Manager, up to the wait
  # limit, and only then are read back. The decision comes before hashing,
  # so a waiting clip costs nothing this pass.
  if [ "${ARCHIVE_MANAGER_RECORD:-0}" = 1 ]
  then
    archive_manager_original_sums "$rels" > "$pre"
    local wait_h
    wait_h=$(archive_conf_value ARCHIVE_VERIFY_MANAGER_WAIT_HOURS)
    [[ "$wait_h" =~ ^[0-9]+$ ]] || wait_h=24
    awk -F'\t' -v pre="$pre" -v now="$(date +%s)" -v wait="$((wait_h * 3600))" \
        -v todo="$todo" -v deferred="$ARCHIVE_VERIFY_WORK/deferred" -v readback="$readback" '
      FILENAME == pre { have[$2] = 1; next }
      {
        ks = ($3 == "") ? "-" : $3; kh = ($4 == "") ? "-" : $4
        q = ($5 ~ /^[0-9]+$/) ? $5 : now
        line = $1 "\t" $2 "\t" ks "\t" kh "\t" q
        # >> : the deferred list collects across batches; todo and
        # readback were emptied above for this batch.
        if ($1 in have) { print line >> todo }
        else if (now - q < wait) { print line >> deferred }
        else { print line >> todo; print $1 >> readback }
      }' "$pre" "$batch"
  else
    cp "$batch" "$todo"
    cp "$rels" "$readback"
  fi

  # Hash the Pi's copy: the snapshot file the clip was sent from. A re-check
  # whose snapshot is gone falls back to the hash taken the first time.
  while IFS=$'\t' read -r rel src ksize ksum _
  do
    [ "${ksum:-}" != "-" ] || ksum=""
    # A basic-check fingerprint (from before a switch to full) isn't a SHA-256.
    [[ "${ksum:-}" != basic:* ]] || ksum=""
    [ "${ksize:-}" != "-" ] || ksize=""
    local cached=""
    if [ -n "$src" ] && size=$(stat -L -c %s -- "$src" 2>/dev/null) &&
       cached=$(archive_cached_local_sum "$src" "$size")
    then
      # Pre-hashed after the snapshot: no need to read the clip again.
      printf '%s\t%s\t%s\t%s\n' "$rel" "$size" "$(cut -f2 <<< "$cached")" "$src" >> "$localsums"
    elif [ -n "$src" ] && [ -f "$src" ] &&
       sum=$(ionice -c2 -n7 nice -n19 sha256sum < "$src") &&
       size=$(stat -L -c %s -- "$src")
    then
      printf '%s\t%s\t%s\t%s\n' "$rel" "$size" "${sum%% *}" "$src" >> "$localsums"
    elif [ -n "${ksum:-}" ]
    then
      printf '%s\t%s\t%s\t%s\n' "$rel" "$ksize" "$ksum" "$src" >> "$localsums"
    else
      printf '%s\t-\t-\t%s\n' "$rel" "$src" >> "$localsums"
    fi
  done < "$todo"
  rm -f "$todo"

  # A clip Manager already re-encoded without recording it (before its
  # record existed) can't match whatever the Pi reads back, so don't
  # download it to find out: its codec, read from 2 MiB at most, says so.
  # Those go straight to the re-encode classification below. Only with
  # Manager's record present, where re-encoded clips are expected.
  local codec_only="$ARCHIVE_VERIFY_WORK/codec-only"
  : > "$codec_only"
  if [ "${ARCHIVE_MANAGER_RECORD:-0}" = 1 ] && [ -s "$readback" ]
  then
    local still="$ARCHIVE_VERIFY_WORK/readback-still"
    : > "$still"
    while IFS= read -r rel
    do
      if archive_remote_is_reencoded "$rel"; then echo "$rel" >> "$codec_only"; else echo "$rel" >> "$still"; fi
    done < "$readback"
    mv "$still" "$readback"
  fi

  # Quick check (SMB/NFS): fingerprint both copies instead of reading the
  # share's copy back. Needs the Pi's copy; a re-check whose snapshot is gone
  # stays on the full read-back.
  local quick="$ARCHIVE_VERIFY_WORK/quick"
  : > "$quick"
  if [ -s "$readback" ] && archive_verify_quick_mode
  then
    timeout 10 [ -d "${ARCHIVE_MOUNT:-}" ] || return 1
    local still="$ARCHIVE_VERIFY_WORK/readback-still" lfp rfp qrel qsum qsrc qabsent="" rmode
    local qtodo="$ARCHIVE_VERIFY_WORK/quick-todo"
    : > "$still"
    : > "$qtodo"
    # The Pi's halves first (usually stored by pre-hashing)...
    while IFS=$'\t' read -r qrel _ qsum qsrc
    do
      grep -qxF -- "$qrel" "$readback" || continue
      # No Pi copy and no stored hash: nothing to compare (nosource), so
      # don't read the share's copy at all.
      [ "$qsum" != "-" ] || continue
      if [ -z "$qsrc" ] || [ ! -f "$qsrc" ] ||
         ! lfp=$(archive_local_quick_fingerprint "$qsrc")
      then
        echo "$qrel" >> "$still"
        continue
      fi
      # "-" for no mode: read with IFS=tab merges an empty field away.
      rmode=-
      [ "${lfp%%:*}" != mp4 ] || rmode=mp4-only
      printf '%s\t%s\t%s\n' "$qrel" "$lfp" "$rmode" >> "$qtodo"
    done < "$localsums"
    # ...then the share's, several clips at once.
    archive_remote_quick_fingerprints "$qtodo" > "$qtodo.out"
    while IFS=$'\t' read -r qrel lfp rmode rfp
    do
      [ -n "$qrel" ] || continue
      [ "$rmode" != - ] || rmode=""
      if [ "$rfp" = ABSENT ]
      then
        qabsent+="$qrel"$'\t'"$lfp"$'\t'"$rmode"$'\n'
        continue
      fi
      archive_quick_result "$qrel" "$lfp" "$rfp" >> "$quick"
    done < "$qtodo.out"
    # Briefly absent isn't missing (see the read-back case below).
    if [ -n "$qabsent" ]
    then
      sleep "${ARCHIVE_VERIFY_ABSENT_RECHECK_SECONDS:-20}"
      while IFS=$'\t' read -r qrel lfp rmode
      do
        [ -n "$qrel" ] || continue
        if rfp=$(archive_remote_quick_fingerprint "$qrel" "$rmode")
        then
          archive_quick_result "$qrel" "$lfp" "$rfp" >> "$quick"
        else
          printf '%s\tmissing\n' "$qrel" >> "$quick"
        fi
      done <<< "$qabsent"
    fi
    mv "$still" "$readback"
  fi

  : > "$ARCHIVE_VERIFY_WORK/remote"
  if [ -s "$readback" ]
  then
    archive_remote_sha256 "$readback" > "$ARCHIVE_VERIFY_WORK/remote" || return 1
  fi

  # A clip that's briefly absent isn't missing. Sentry Manager replaces a
  # clip in place when it converts it; on a share without hard links, its
  # fallback removes the original a moment before renaming the converted
  # copy in. Calling that "missing" would re-send the original over
  # Manager's work. Ask once more after a pause before deciding.
  local absent="$ARCHIVE_VERIFY_WORK/absent"
  awk -F'\t' -v remote="$ARCHIVE_VERIFY_WORK/remote" -v readback="$readback" '
    FILENAME == readback { asked[$0] = 1; next }
    FILENAME == remote { seen[$2] = 1; next }
    $3 != "-" && ($1 in asked) && !($1 in seen) { print $1 }' "$readback" "$ARCHIVE_VERIFY_WORK/remote" "$localsums" > "$absent"
  if [ -s "$absent" ]
  then
    sleep "${ARCHIVE_VERIFY_ABSENT_RECHECK_SECONDS:-20}"
    archive_remote_sha256 "$absent" >> "$ARCHIVE_VERIFY_WORK/remote" || true
  fi

  # Manager's line (pre) decides clips that have one: equal to the Pi's hash
  # means the share held exactly the uploaded bytes when Manager converted
  # them ("converted"); different goes on as a mismatch, which the
  # reclassification below explains as a bad-source conversion.
  awk -F'\t' -v now="$(date +%s)" -v remote="$ARCHIVE_VERIFY_WORK/remote" -v prev="$ARCHIVE_VERIFY_WORK/prev" -v pre="$pre" -v codec="$codec_only" -v quick="$quick" '
    FILENAME == prev   { ps[$1] = $5; ph[$1] = $3; pc[$1] = $6 + 0; next }
    FILENAME == pre    { m[$2] = $1; next }
    FILENAME == codec  { reenc[$0] = 1; next }
    FILENAME == quick  { qs[$1] = $2; next }
    FILENAME == remote { r[$2] = $1; next }
    {
      if ($3 == "-")          status = "nosource"
      else if ($1 in m)       status = (m[$1] == $3) ? "converted" : "mismatch"
      else if ($1 in reenc)   status = "mismatch"   # classified as a re-encode below
      else if ($1 in qs)      status = qs[$1]
      else if (!($1 in r))    status = "missing"
      else if (r[$1] == $3)   status = "ok"
      else                    status = "mismatch"
      count = 0
      if (status == "ok" || status == "ok_quick")
        count = ((ps[$1] == "ok" || ps[$1] == "ok_quick") && ph[$1] == $3) ? pc[$1] + 1 : 1
      else if (status == "converted")
        count = (ps[$1] == "ok" || ps[$1] == "ok_quick" || ps[$1] == "converted") ? pc[$1] + 1 : 1
      print $1 "\t" $2 "\t" $3 "\t" now "\t" status "\t" count "\t" $4
    }' "$ARCHIVE_VERIFY_WORK/prev" "$pre" "$codec_only" "$quick" "$ARCHIVE_VERIFY_WORK/remote" "$localsums" > "$ARCHIVE_VERIFY_WORK/results"

  # A mismatch that is Sentry Manager's in-place re-encode (server copy
  # H.265/AV1, Pi copy not) is never renamed aside or re-sent as damage:
  # that would undo the conversion and loop forever. It is:
  #  - converted: Manager's record of the original's SHA-256 matches the
  #    Pi's, or (no record) the clip already matched by checksum before it
  #    was converted. "Times verified" keeps counting;
  #  - mismatch: Manager's record exists but doesn't match the Pi's copy, so
  #    Manager converted a bad upload; re-send the original as usual;
  #  - converted_unconfirmed: no record and never matched before conversion.
  #    Kept, but it never counts toward auto-delete.
  # A re-check whose Pi copy is gone is judged by its stored hash.
  local reclass="$ARCHIVE_VERIFY_WORK/reclass" manager_sums="$ARCHIVE_VERIFY_WORK/manager"
  : > "$reclass"
  if grep -q $'\tmismatch\t' "$ARCHIVE_VERIFY_WORK/results"
  then
    awk -F'\t' '$5 == "mismatch" { print $1 }' "$ARCHIVE_VERIFY_WORK/results" > "$ARCHIVE_VERIFY_WORK/mismatched"
    archive_manager_original_sums "$ARCHIVE_VERIFY_WORK/mismatched" > "$manager_sums"
    local orig prev_status
    while IFS=$'\t' read -r rel _ sum _ status _ src
    do
      [ "$status" = mismatch ] || continue
      archive_remote_is_reencoded "$rel" || continue
      ! archive_local_is_reencoded "$src" || continue
      orig=$(awk -F'\t' -v r="$rel" '$2 == r { s = $1 } END { print s }' "$manager_sums")
      prev_status=$(awk -F'\t' -v r="$rel" '$1 == r { s = $5 } END { print s }' "$ARCHIVE_VERIFY_WORK/prev")
      if [ -n "$orig" ] && [ "$orig" = "$sum" ]; then
        printf '%s\tconverted\n' "$rel" >> "$reclass"
      elif [ -n "$orig" ]; then
        log "ERROR: archive verification: Sentry Manager re-encoded $rel from a copy that doesn't match the Pi's (SHA-256); renaming its output aside and sending the original again"
      elif [ "$prev_status" = ok ] || [ "$prev_status" = ok_quick ] || [ "$prev_status" = converted ]; then
        printf '%s\tconverted\n' "$rel" >> "$reclass"
      else
        printf '%s\tconverted_unconfirmed\n' "$rel" >> "$reclass"
      fi
    done < "$ARCHIVE_VERIFY_WORK/results"
  fi
  if [ -s "$reclass" ]
  then
    awk -F'\t' -v OFS='\t' -v prev="$ARCHIVE_VERIFY_WORK/prev" -v rc="$reclass" '
      FILENAME == prev { ps[$1] = $5; pc[$1] = $6 + 0; next }
      FILENAME == rc { to[$1] = $2; next }
      ($1 in to) && $5 == "mismatch" {
        $5 = to[$1]
        if ($5 == "converted") $6 = (ps[$1] == "ok" || ps[$1] == "ok_quick" || ps[$1] == "converted") ? pc[$1] + 1 : 1
        else $6 = 0
      }
      { print }' "$ARCHIVE_VERIFY_WORK/prev" "$reclass" "$ARCHIVE_VERIFY_WORK/results" > "$ARCHIVE_VERIFY_WORK/results.new" &&
      mv "$ARCHIVE_VERIFY_WORK/results.new" "$ARCHIVE_VERIFY_WORK/results"
  fi

  archive_verify_finish_batch "SHA-256"
}

# Shared end of a batch: rename mismatched server copies aside, send them and
# missing ones again next cycle, and record $ARCHIVE_VERIFY_WORK/results.
# $1 names the check in log lines ("SHA-256", "size and frames").
function archive_verify_finish_batch () {
  local how=${1:-SHA-256} rel status
  # Send mismatched and missing clips again next cycle.
  local resend="$ARCHIVE_VERIFY_WORK/resend"
  : > "$resend"
  while IFS=$'\t' read -r rel _ _ _ status _
  do
    case "$status" in
      mismatch)
        if archive_set_aside_remote "$rel"
        then
          log "ERROR: archive verification: $rel on the archive server doesn't match the Pi's copy ($how); renamed it aside and will send it again"
        else
          log "ERROR: archive verification: $rel on the archive server doesn't match the Pi's copy ($how), and it couldn't be renamed aside; will send it again"
        fi
        echo "$rel" >> "$resend" ;;
      missing)
        log "ERROR: archive verification: $rel isn't on the archive server after archiving; will send it again"
        echo "$rel" >> "$resend" ;;
    esac
  done < "$ARCHIVE_VERIFY_WORK/results"
  if [ -s "$resend" ] && [ -e /mutable/sentry_files_archived ]
  then
    cp /mutable/sentry_files_archived "$ARCHIVE_VERIFY_WORK/archived"
    prunefile "$ARCHIVE_VERIFY_WORK/archived" "$resend"
    cp "$ARCHIVE_VERIFY_WORK/archived" /mutable/sentry_files_archived.new &&
      mv /mutable/sentry_files_archived.new /mutable/sentry_files_archived
  fi

  cat "$ARCHIVE_VERIFY_WORK/results" >> "$ARCHIVE_VERIFY_LEDGER"
  cat "$ARCHIVE_VERIFY_WORK/results" >> "$ARCHIVE_VERIFY_WORK/results-all"
}

# Keep the newest ledger line per clip, and only for clips some snapshot on
# the Pi still holds, so the ledger never outgrows the snapshots it explains.
function prune_archive_verify_ledger () {
  [ -s "$ARCHIVE_VERIFY_LEDGER" ] || return 0
  local -a tocs=(/backingfiles/snapshots/snap-*/snap.bin.toc)
  # No TOCs at all (drive not mounted?) proves nothing: keep everything.
  [ -e "${tocs[0]}" ] || return 0
  awk -F'\t' -v ledger="$ARCHIVE_VERIFY_LEDGER" '
    function key(p,   n, a) {
      sub(/^TeslaCam\//, "", p)
      if (p ~ /^RecentClips\//) { n = split(p, a, "/"); p = "RecentClips/" a[n] }
      return p
    }
    FILENAME != ledger { p = $0; sub(/^[0-9]+ /, "", p); keep[key(p)] = 1; next }
    key($1) in keep { last[$1] = $0; order[$1] = FNR }
    END { for (r in last) print order[r] "\t" last[r] }' "${tocs[@]}" "$ARCHIVE_VERIFY_LEDGER" |
    sort -n | cut -f2- > "$ARCHIVE_VERIFY_LEDGER.new" &&
    mv "$ARCHIVE_VERIFY_LEDGER.new" "$ARCHIVE_VERIFY_LEDGER"
}

# With auto-delete on, queue the second check for clips verified once at
# least ARCHIVE_VERIFY_RECHECK_SECONDS ago. The queue line carries the first
# check's size and hash, so it still works if the source snapshot is gone.
function queue_archive_rechecks () {
  archive_auto_delete_enabled || return 0
  [ -s "$ARCHIVE_VERIFY_LEDGER" ] || return 0
  local gap
  gap=$(archive_conf_value ARCHIVE_VERIFY_RECHECK_SECONDS)
  [[ "$gap" =~ ^[0-9]+$ ]] || gap=3600
  awk -F'\t' -v cutoff="$(( $(date +%s) - gap ))" -v now="$(date +%s)" '
    { last[$1] = $0 }
    END {
      for (r in last) {
        split(last[r], f, "\t")
        if ((f[5] == "ok" || f[5] == "ok_quick" || f[5] == "converted" || f[5] == "ok_basic" || f[5] == "converted_basic") && f[6] + 0 == 1 && f[4] + 0 <= cutoff)
          print f[1] "\t" f[7] "\t" f[2] "\t" f[3] "\t" now
      }
    }' "$ARCHIVE_VERIFY_LEDGER" >> "$ARCHIVE_VERIFY_QUEUE"
}

# Decide whether one snapshot's footage is all verified twice on the archive
# server. Prints "yes <clips>" or "no <clips> <unverified> <not archived>".
# Every clip (an .mp4 of at least 100000 bytes, the same short-recording
# cutoff the archive uses) must be in a folder this device archives AND
# have a ledger line that is ok, verified at least twice, and at least as
# large as the snapshot's copy. One clip from a folder that isn't archived
# (e.g. RecentClips with ARCHIVE_RECENTCLIPS off) keeps the snapshot.
function snapshot_verified_twice () {
  local toc=$1 trust=false v
  # Opt-in (Settings): count clips Sentry Manager re-encoded before anything
  # confirmed the original as verified. Default off.
  v=$(archive_conf_value ARCHIVE_TRUST_UNCONFIRMED_CONVERSIONS)
  case "${v,,}" in true|yes|1|on) trust=true ;; esac
  awk -F'\t' -v ledger="$ARCHIVE_VERIFY_LEDGER" -v trust="$trust" \
      -v saved="${ARCHIVE_SAVEDCLIPS:-true}" -v sentry="${ARCHIVE_SENTRYCLIPS:-true}" \
      -v recent="${ARCHIVE_RECENTCLIPS:-false}" -v track="${ARCHIVE_TRACKMODECLIPS:-true}" '
    function key(p,   n, a) {
      sub(/^TeslaCam\//, "", p)
      if (p ~ /^RecentClips\//) { n = split(p, a, "/"); p = "RecentClips/" a[n] }
      return p
    }
    FILENAME == ledger {
      if ((($5 == "ok" || $5 == "ok_quick" || $5 == "converted" || $5 == "ok_basic" || $5 == "converted_basic") && $6 + 0 >= 2) || ($5 == "converted_unconfirmed" && trust == "true")) {
        k = key($1); if (!(k in vs) || $2 + 0 > vs[k]) vs[k] = $2 + 0
      }
      next
    }
    {
      sp = index($0, " ")
      if (sp < 2) next
      size = substr($0, 1, sp - 1) + 0
      p = substr($0, sp + 1)
      sub(/^TeslaCam\//, "", p)
      if (tolower(p) !~ /\.mp4$/ || size < 100000) next
      cat = p; sub(/\/.*/, "", cat)
      on = "false"
      if (cat == "SavedClips") on = saved
      else if (cat == "SentryClips") on = sentry
      else if (cat == "RecentClips") on = recent
      else if (cat == "TeslaTrackMode") on = track
      if (on != "true") { notarchived++; next }
      clips++
      k = key(p)
      if (!(k in vs) || vs[k] < size) unverified++
    }
    END {
      if (clips > 0 && unverified + 0 == 0 && notarchived + 0 == 0) print "yes " clips
      else print "no " clips + 0 " " unverified + 0 " " notarchived + 0
    }' "$ARCHIVE_VERIFY_LEDGER" "$toc"
}

# Release snapshots whose footage is all verified twice on the archive
# server (only with ARCHIVE_AUTO_DELETE_VERIFIED=true).
#
# Runs while holding the snapshots-dir lock, the same lock make_snapshot.sh,
# Clips refresh and the space manager take, so no snapshot is being created,
# linked or released while this decides; each snapshot is re-checked under
# the lock immediately before it's released. Verification itself runs
# without the lock (hashing can take many minutes, and holding the lock that
# long would delay the hourly snapshot and lose RecentClips); it only reads
# snapshots, and a snapshot removed mid-read just fails to hash and is
# recorded as unverified, never as verified.
#
# Never released: the newest snapshot (by slot and by time, the one the
# next snapshot is compared against), a snapshot still owed links
# (snap.bin.relink_pending), and any snapshot without a TOC.
function auto_delete_verified_snapshots () {
  archive_auto_delete_enabled || return 0
  [ -s "$ARCHIVE_VERIFY_LEDGER" ] || return 0
  (
    if ! flock -x -w 60 9
    then
      log "Auto-delete: snapshots are busy; will try again next cycle"
      exit 0
    fi
    local newest_slot="" newest_time="" dir verdict released=0
    local -a dirs=()
    # Slot names are zero-padded, so glob order is slot order.
    for dir in /backingfiles/snapshots/snap-*
    do
      [ -d "$dir" ] || continue
      dirs+=("$dir")
      newest_slot=$dir
      if [ -e "$dir/snap.bin" ] && { [ -z "$newest_time" ] || [ "$dir/snap.bin" -nt "$newest_time/snap.bin" ]; }
      then
        newest_time=$dir
      fi
    done
    for dir in "${dirs[@]}"
    do
      if [ "$dir" = "$newest_slot" ] || [ "$dir" = "$newest_time" ]; then continue; fi
      if [ ! -e "$dir/snap.bin" ] || [ ! -s "$dir/snap.bin.toc" ]; then continue; fi
      if [ -e "$dir/snap.bin.relink_pending" ]; then continue; fi
      archive_cancel_requested && break
      verdict=$(snapshot_verified_twice "$dir/snap.bin.toc")
      case "$verdict" in
        yes\ *)
          log "Auto-delete: releasing ${dir##*/}; all ${verdict#yes } clip(s) in it are verified twice on the archive server"
          if /root/bin/release_snapshot.sh "$dir"
          then
            released=$((released + 1))
          else
            log "ERROR: Auto-delete: could not release ${dir##*/}"
          fi
          ;;
      esac
    done
    [ "$released" = 0 ] || log "Auto-delete: released $released snapshot(s) verified twice on the archive server"
  ) 9< "$SNAPSHOT_LOCK_DIR"
}

# Where the Pi holds a clip now: the file the link farm's link for $1
# (archive relpath) points to, if that file exists. Every snapshot is a full
# copy of the car's drive, so a clip first sent from a snapshot that has
# since been released is usually still in a newer one.
function archive_current_source () {
  local link="/mutable/TeslaCam/$1" target
  target=$(readlink -- "$link" 2>/dev/null) || return 1
  [ "${target:0:1}" = / ] || target="$(dirname -- "$link")/$target"
  [ -f "$target" ] || return 1
  printf '%s\n' "$target"
}

# Rewrite a batch of queue lines ($1) in place so each clip's Pi source is
# a file that exists: a source in a released snapshot is replaced by the
# clip's current copy (archive_current_source), when there is one.
function archive_resolve_batch_sources () {
  local batch=$1 line rel rest src tail alt
  while IFS= read -r line || [ -n "$line" ]
  do
    rel=${line%%$'\t'*}
    if [ "$rel" = "$line" ]; then printf '%s\n' "$line"; continue; fi
    rest=${line#*$'\t'}
    src=${rest%%$'\t'*}
    if [ "$src" = "$rest" ]; then tail=""; else tail=$'\t'${rest#*$'\t'}; fi
    if [ -n "$src" ] && [ ! -e "$src" ] && alt=$(archive_current_source "$rel")
    then
      src=$alt
    fi
    printf '%s\t%s%s\n' "$rel" "$src" "$tail"
  done < "$batch" > "$batch.resolved" && mv "$batch.resolved" "$batch"
}

# Version of archive_basic_result's rule. When it changes, clips the basic
# check left converted_unconfirmed (and, in basic mode, ones a full check
# left unconfirmed) are checked once more under the new rule.
ARCHIVE_BASIC_RULE_VERSION=2
ARCHIVE_BASIC_RULE_FILE=/mutable/archive_basic_rule

function requeue_unconfirmed_for_basic_rule () {
  archive_verify_basic_mode || return 0
  [ "$(cat "$ARCHIVE_BASIC_RULE_FILE" 2>/dev/null)" != "$ARCHIVE_BASIC_RULE_VERSION" ] || return 0
  if [ -s "$ARCHIVE_VERIFY_LEDGER" ]
  then
    local n
    n=$({ cut -f1 "$ARCHIVE_VERIFY_QUEUE" 2>/dev/null || true; } |
      awk -F'\t' -v now="$(date +%s)" -v queue="$ARCHIVE_VERIFY_QUEUE.add" '
        FILENAME == "-" { q[$0] = 1; next }
        { last[$1] = $0 }
        END {
          for (r in last) {
            split(last[r], f, "\t")
            if (f[5] == "converted_unconfirmed" && !(r in q)) { print r "\t" f[7] "\t-\t-\t" now > queue; n++ }
          }
          print n + 0
        }' - "$ARCHIVE_VERIFY_LEDGER")
    if [ -s "$ARCHIVE_VERIFY_QUEUE.add" ]
    then
      cat "$ARCHIVE_VERIFY_QUEUE.add" >> "$ARCHIVE_VERIFY_QUEUE"
      log "Queueing $n re-encoded file(s) left unconfirmed for another basic check (rule version $ARCHIVE_BASIC_RULE_VERSION)"
    fi
    rm -f "$ARCHIVE_VERIFY_QUEUE.add"
  fi
  echo "$ARCHIVE_BASIC_RULE_VERSION" > "$ARCHIVE_BASIC_RULE_FILE" || true
}

# Clips whose latest check found no Pi copy ("nosource"), because the
# snapshot they were sent from was released, are checked again when the Pi
# still holds them in another snapshot. Only when that copy is a different
# file from the one recorded, so a clip really gone isn't queued forever.
function requeue_nosource_with_copy () {
  [ -s "$ARCHIVE_VERIFY_LEDGER" ] || return 0
  local work=/tmp/archive-verify-nosource rel src alt n=0
  rm -rf "$work"
  mkdir -p "$work" || return 1
  { cut -f1 "$ARCHIVE_VERIFY_QUEUE" 2>/dev/null || true; } > "$work/queued"
  awk -F'\t' -v queued="$work/queued" '
    FILENAME == queued { q[$0] = 1; next }
    { last[$1] = $0 }
    END {
      for (r in last) {
        split(last[r], f, "\t")
        if (f[5] == "nosource" && !(r in q)) print f[1] "\t" f[7]
      }
    }' "$work/queued" "$ARCHIVE_VERIFY_LEDGER" > "$work/nosource"
  local now
  now=$(date +%s)
  while IFS=$'\t' read -r rel src
  do
    [ -n "$rel" ] || continue
    alt=$(archive_current_source "$rel") || continue
    [ "$alt" != "$src" ] || continue
    printf '%s\t%s\t-\t-\t%s\n' "$rel" "$alt" "$now" >> "$ARCHIVE_VERIFY_QUEUE"
    n=$((n + 1))
  done < "$work/nosource"
  [ "$n" = 0 ] || log "Queueing $n file(s) checked earlier without a Pi copy: the Pi still has them in a newer snapshot"
  rm -rf "$work"
}

# Clips archived before verification existed (or while it was turned off)
# are on the archived-files list but have no ledger line, so nothing would
# ever check them, their snapshots would never show as verified, and
# auto-delete would never release them. Queue every such clip. Its link in
# the link farm still points at the snapshot copy, so it can be hashed like
# a fresh upload. Idempotent: a clip leaves this set as soon as it has a
# ledger line or a queue entry, so a large backlog simply drains over
# several cycles within ARCHIVE_VERIFY_MAX_SECONDS each.
function queue_unverified_archived () {
  local archived=/mutable/sentry_files_archived lower=/mutable/TeslaCam
  local work=/tmp/archive-verify-backfill
  [ -s "$archived" ] || return 0
  rm -rf "$work"
  mkdir -p "$work" || return 1
  # Either file may not exist yet; mawk (the Pi's awk) stops on a missing
  # input file, so read them through cat.
  cat "$ARCHIVE_VERIFY_LEDGER" "$ARCHIVE_VERIFY_QUEUE" 2>/dev/null | cut -f1 > "$work/known"
  awk -v known="$work/known" '
    FILENAME == known { seen[$0] = 1; next }
    $0 != "" && !($0 in seen)' "$work/known" "$archived" > "$work/todo" || true
  [ -s "$work/todo" ] || { rm -rf "$work"; return 0; }
  # Only clips the link farm still holds: a released snapshot takes its
  # links with it, and its clips leave the archived list at the next
  # archive pass. There is no Pi copy left to compare them with.
  record_archive_link_targets "$lower" "$work/todo" "$work/targets"
  awk -F'\t' '$2 != ""' "$work/targets" > "$work/linked"
  [ -s "$work/linked" ] || { rm -rf "$work"; return 0; }
  cut -f1 "$work/linked" > "$work/todo"
  log "Queueing $(wc -l < "$work/todo") previously archived file(s) for their first checksum check"
  queue_archived_for_verification "$work/todo" "$work/linked" "$lower"
  rm -rf "$work"
}

# Live progress of the current verification pass, for the Snapshots page:
# {"running": bool, "checked": N, "total": N, "stopped": "<reason>"|null,
#  "updated_unix": N}. Written atomically after each batch of 50 and at the
# end of a pass. Best effort.
ARCHIVE_VERIFY_PROGRESS=/tmp/archive-verify-progress.json

function archive_verify_progress () {
  local running=$1 checked=$2 total=$3 stopped=$4 reason=null
  [ -z "$stopped" ] || reason=$(json_string "$stopped")
  printf '{"running": %s, "checked": %s, "total": %s, "stopped": %s, "updated_unix": %s}\n' \
    "$running" "$(json_int "$checked")" "$(json_int "$total")" "$reason" "$(date +%s)" \
    > "$ARCHIVE_VERIFY_PROGRESS.new" 2>/dev/null &&
    mv -f "$ARCHIVE_VERIFY_PROGRESS.new" "$ARCHIVE_VERIFY_PROGRESS" 2>/dev/null
  return 0
}

# The long task running right now, for the Dashboard's archive card (which
# otherwise only knows the upload and said "Preparing the next phase…"):
# {"phase": "verifying"|"prehashing"|"waiting_manager", "label": "...",
#  "done": N, "total": N, "detail": "..."|null, "next_check_unix": N|null,
#  "started_unix": N, "updated_unix": N, "eta_seconds": N|null}
# The estimate is the pace so far in this phase applied to what's left.
# Written atomically; removed when the phase ends (only by the phase that
# wrote it, so a background pre-hash finishing can't erase a check's status).
ARCHIVE_WORK_PROGRESS=/tmp/archive-work-progress.json

# archive_work_progress <phase> <label> <done> <total> [detail] [next_check_unix]
function archive_work_progress () {
  local phase=$1 label=$2 done=$3 total=$4 detail=${5:-} next=${6:-} now eta=null d=null n=null
  now=$(date +%s)
  if [ "${ARCHIVE_WORK_PHASE:-}" != "$phase" ]
  then
    ARCHIVE_WORK_PHASE=$phase
    ARCHIVE_WORK_STARTED=$now
  fi
  if [ "$done" -gt 0 ] && [ "$total" -gt "$done" ]
  then
    eta=$(( (now - ARCHIVE_WORK_STARTED) * (total - done) / done ))
  elif [ "$total" -gt 0 ] && [ "$done" -ge "$total" ]
  then
    eta=0
  fi
  [ -z "$detail" ] || d=$(json_string "$detail")
  [ -z "$next" ] || n=$(json_int "$next")
  printf '{"phase": %s, "label": %s, "done": %s, "total": %s, "detail": %s, "next_check_unix": %s, "started_unix": %s, "updated_unix": %s, "eta_seconds": %s}\n' \
    "$(json_string "$phase")" "$(json_string "$label")" "$(json_int "$done")" "$(json_int "$total")" \
    "$d" "$n" "$ARCHIVE_WORK_STARTED" "$now" "$eta" > "$ARCHIVE_WORK_PROGRESS.new" 2>/dev/null &&
    mv -f "$ARCHIVE_WORK_PROGRESS.new" "$ARCHIVE_WORK_PROGRESS" 2>/dev/null
  return 0
}

# archive_work_done <phase>: clear the status if this phase wrote it.
function archive_work_done () {
  if grep -q "\"phase\": \"$1\"" "$ARCHIVE_WORK_PROGRESS" 2>/dev/null
  then
    rm -f "$ARCHIVE_WORK_PROGRESS"
  fi
  [ "${ARCHIVE_WORK_PHASE:-}" != "$1" ] || ARCHIVE_WORK_PHASE=""
  return 0
}

# How this pass's clips were checked so far, for the progress detail.
# Optional second argument: the list of clips set aside to wait for
# Sentry Manager's checksum line; their count is added at the end.
function archive_verify_methods () {
  local waiting=0
  [ -z "${2:-}" ] || [ ! -s "$2" ] || waiting=$(wc -l < "$2")
  awk -F'\t' -v w="$waiting" '
    $5 == "converted" { m++ } $5 == "ok_quick" { q++ } $5 == "ok" { r++ }
    $5 == "ok_basic" || $5 == "converted_basic" { k++ }
    $5 == "mismatch" || $5 == "missing" { b++ } $5 == "converted_unconfirmed" { u++ }
    END {
      s = ""
      if (m) s = s sprintf("%s%d via Sentry Manager'"'"'s record", (s ? " · " : ""), m)
      if (q) s = s sprintf("%s%d by quick check", (s ? " · " : ""), q)
      if (k) s = s sprintf("%s%d by size and frames", (s ? " · " : ""), k)
      if (r) s = s sprintf("%s%d read back", (s ? " · " : ""), r)
      if (u) s = s sprintf("%s%d unconfirmed", (s ? " · " : ""), u)
      if (b) s = s sprintf("%s%d to re-send", (s ? " · " : ""), b)
      if (w + 0) s = s sprintf("%s%d waiting for Sentry Manager'"'"'s checksum", (s ? " · " : ""), w)
      print s
    }' "$1" 2>/dev/null
}

# Clips this pass has gone through: checked (results-all) plus set aside to
# wait for Sentry Manager's checksum line (deferred).
function archive_verify_gone_through () {
  local checked=0 waiting=0
  [ ! -s "$ARCHIVE_VERIFY_WORK/results-all" ] || checked=$(wc -l < "$ARCHIVE_VERIFY_WORK/results-all")
  [ ! -s "$ARCHIVE_VERIFY_WORK/deferred" ] || waiting=$(wc -l < "$ARCHIVE_VERIFY_WORK/deferred")
  echo $(( checked + waiting ))
}

# Verify queued archived clips against the archive server, then (if turned
# on) release snapshots verified twice. Runs with the archive connected and
# the car's USB drive already back online.
function verify_archived_clips () {
  if ! archive_verify_enabled
  then
    rm -f "$ARCHIVE_VERIFY_QUEUE"
    return 0
  fi
  queue_unverified_archived || log "WARNING: could not queue previously archived files for verification"
  requeue_nosource_with_copy || log "WARNING: could not re-queue files checked without a Pi copy"
  requeue_unconfirmed_for_basic_rule || log "WARNING: could not re-queue unconfirmed re-encodes"
  queue_archive_rechecks || log "WARNING: could not queue archive re-checks"
  if [ ! -s "$ARCHIVE_VERIFY_QUEUE" ]
  then
    auto_delete_verified_snapshots || log "WARNING: auto-delete of verified snapshots failed"
    return 0
  fi
  rm -rf "$ARCHIVE_VERIFY_WORK"
  mkdir -p "$ARCHIVE_VERIFY_WORK" || return 1
  : > "$ARCHIVE_VERIFY_WORK/results-all"
  : > "$ARCHIVE_VERIFY_WORK/deferred"
  ARCHIVE_MANAGER_RECORD=0
  if ! archive_verify_basic_mode && archive_manager_record_present
  then
    ARCHIVE_MANAGER_RECORD=1
  fi

  # Each clip's latest ledger line, to carry its "times verified" forward.
  if [ -s "$ARCHIVE_VERIFY_LEDGER" ]
  then
    awk -F'\t' '{ last[$1] = $0 } END { for (r in last) print last[r] }' "$ARCHIVE_VERIFY_LEDGER" > "$ARCHIVE_VERIFY_WORK/prev"
  else
    : > "$ARCHIVE_VERIFY_WORK/prev"
  fi

  # One line per clip (the newest), oldest first.
  awk -F'\t' 'NF >= 2 && $1 != "" { last[$1] = $0; order[$1] = NR }
    END { for (r in last) print order[r] "\t" last[r] }' "$ARCHIVE_VERIFY_QUEUE" |
    sort -n | cut -f2- > "$ARCHIVE_VERIFY_WORK/queue"
  local total
  total=$(wc -l < "$ARCHIVE_VERIFY_WORK/queue")
  local method="SHA-256"
  ! archive_verify_basic_mode || method="size and frames"
  log "Verifying $total archived file(s) against the archive server ($method)"
  archive_verify_progress true 0 "$total" ""
  archive_work_progress verifying "Verifying archived clips" 0 "$total"

  local max
  max=$(archive_conf_value ARCHIVE_VERIFY_MAX_SECONDS)
  [[ "$max" =~ ^[0-9]+$ ]] || max=1800
  local deadline batch stopped=""
  deadline=$(( $(uptime_seconds) + max ))
  # Basic checks are quick, so larger batches (fewer passes over the queue
  # files); 50 otherwise, so a full read-back batch stays bounded.
  local batch_size=50
  ! archive_verify_basic_mode || batch_size=200
  split -l "$batch_size" -d -a 6 "$ARCHIVE_VERIFY_WORK/queue" "$ARCHIVE_VERIFY_WORK/batch-"
  for batch in "$ARCHIVE_VERIFY_WORK"/batch-*
  do
    [ -e "$batch" ] || continue
    if archive_cancel_requested; then stopped="archive cancelled"; break; fi
    if [ "$(uptime_seconds)" -ge "$deadline" ]; then stopped="time limit of ${max}s reached"; break; fi
    if ! archive_is_reachable; then stopped="archive server unreachable"; break; fi
    if ! verify_archive_batch "$batch"
    then
      stopped="couldn't read checksums from the archive server"
      break
    fi
    rm -f "$batch"
    # Clips set aside to wait for Manager's line have been gone through
    # too, so they count toward "N of M"; otherwise a pass that is mostly
    # waiting reads "1 of 6,742" right to the end.
    archive_verify_progress true "$(archive_verify_gone_through)" "$total" ""
    archive_work_progress verifying "Verifying archived clips" "$(archive_verify_gone_through)" "$total" \
      "$(archive_verify_methods "$ARCHIVE_VERIFY_WORK/results-all" "$ARCHIVE_VERIFY_WORK/deferred")"
  done

  # Whatever wasn't checked, or is waiting for Manager's line, stays queued.
  cat "$ARCHIVE_VERIFY_WORK"/batch-* "$ARCHIVE_VERIFY_WORK/deferred" > "$ARCHIVE_VERIFY_QUEUE.new" 2>/dev/null || true
  if [ -s "$ARCHIVE_VERIFY_QUEUE.new" ]
  then
    mv "$ARCHIVE_VERIFY_QUEUE.new" "$ARCHIVE_VERIFY_QUEUE"
  else
    rm -f "$ARCHIVE_VERIFY_QUEUE.new" "$ARCHIVE_VERIFY_QUEUE"
  fi
  prune_archive_verify_ledger || log "WARNING: could not prune the archive verification ledger"

  local ok quickok basicok bad nosource converted left=0 waiting
  waiting=$(wc -l < "$ARCHIVE_VERIFY_WORK/deferred")
  ok=$(awk -F'\t' '$5 == "ok"' "$ARCHIVE_VERIFY_WORK/results-all" | wc -l)
  quickok=$(awk -F'\t' '$5 == "ok_quick"' "$ARCHIVE_VERIFY_WORK/results-all" | wc -l)
  basicok=$(awk -F'\t' '$5 == "ok_basic" || $5 == "converted_basic"' "$ARCHIVE_VERIFY_WORK/results-all" | wc -l)
  converted=$(awk -F'\t' '$5 == "converted" || $5 == "converted_unconfirmed"' "$ARCHIVE_VERIFY_WORK/results-all" | wc -l)
  bad=$(awk -F'\t' '$5 == "mismatch" || $5 == "missing"' "$ARCHIVE_VERIFY_WORK/results-all" | wc -l)
  nosource=$(awk -F'\t' '$5 == "nosource"' "$ARCHIVE_VERIFY_WORK/results-all" | wc -l)
  [ ! -s "$ARCHIVE_VERIFY_QUEUE" ] || left=$(wc -l < "$ARCHIVE_VERIFY_QUEUE")
  log "Archive verification: $ok matched, $quickok matched by quick check, $basicok matched by size and frames, $converted re-encoded on the server by Sentry Manager, $bad to re-send, $nosource with no Pi copy left to compare, $left still queued ($waiting waiting for Sentry Manager's checksum)${stopped:+ ($stopped)}"
  ARCHIVE_VERIFY_WAITING=$waiting
  archive_verify_progress false "$(archive_verify_gone_through)" "$total" "$stopped"
  archive_work_done verifying
  ARCHIVE_VERIFY_RAN=1
  ARCHIVE_VERIFY_MATCHED=$((ok + quickok + basicok))
  ARCHIVE_VERIFY_CONVERTED=$converted
  ARCHIVE_VERIFY_RESEND=$bad
  ARCHIVE_VERIFY_NOSOURCE=$nosource
  ARCHIVE_VERIFY_LEFT=$left
  ARCHIVE_VERIFY_STOPPED=$stopped

  # Only release snapshots after a complete, clean pass.
  if [ -z "$stopped" ]
  then
    auto_delete_verified_snapshots || log "WARNING: auto-delete of verified snapshots failed"
  fi
  [ -z "$stopped" ] || [ "$stopped" = "archive cancelled" ]
}

# ── Status file on the archive share ──────────────────────────────────────
#
# After each archive cycle, write .sentryusb/archive-status.json at the root
# of the archive destination, so tools that read the share (Sentry Manager)
# can show what the Pi last did. The folder is dot-prefixed and the file
# isn't an .mp4, so footage scanners skip it. The file is replaced
# atomically: a reader sees the old or the new version, never half of one.
#
# Format (schema 1; counts are integers, times are Unix seconds):
# {
#   "schema": 1,
#   "device": "<hostname>",
#   "written_unix": 1762646400,
#   "archive": {
#     "result": "in_progress" | "ok" | "failed" | "nothing_new",
#                                 failed: some files didn't move; they are
#                                 retried next cycle (files_not_archived)
#     "started_unix": ..., "finished_unix": ...,
#     "files_archived": N,        files moved to the share this cycle
#     "files_not_archived": N,    files that should have moved but didn't
#     "last_clip": "RecentClips/2026-11-08/2026-11-08_12-59-00-front.mp4" | null
#   },
#   "verification": {
#     "enabled": true|false,      SHA-256 check of archived clips is on
#     "ran": true|false,          a check ran this cycle
#     "matched": N,               server copy matched the Pi's (this cycle)
#     "converted": N,             re-encoded in place by Sentry Manager; kept
#     "resending": N,             mismatched or missing; sent again next cycle
#     "no_pi_copy": N,            snapshot gone before it could be compared
#     "still_queued": N,          left for the next cycle
#     "stopped": "<reason>" | null
#   },
#   "auto_delete_enabled": true|false,
#   "state": "transferring" | "idle",
#   "transfer": null | {          the transfer this cycle started
#     "started_unix": ...,
#     "files": N, "bytes": N,     what is being sent
#     "first_clip": "<relpath>",  oldest clip in the transfer, by clip name
#     "last_clip": "<relpath>",   newest clip in the transfer, by clip name
#     "expected_finish_unix": ...,
#     "give_up_unix": ...
#   }
# }
#
# The file is written twice per cycle: with "state": "transferring" just
# before the clips start moving, and with "state": "idle" (and the results
# above) once the cycle's archive and checksum steps are done.
#
# How a reader should treat a transfer: clips between first_clip and
# last_clip are on their way, so a missing minute in that range isn't a gap
# yet. If the file still says "transferring" after give_up_unix, the car most
# likely drove off or the Pi lost its connection mid-transfer: nothing is
# lost (the clips stay on the Pi and the transfer resumes the next time it
# reaches the archive), so keep waiting rather than reporting the range as
# missing. expected_finish_unix is estimated from the throughput of the last
# successful transfer (2 MB/s until one has been measured, doubled in Travel
# Mode); give_up_unix adds half that time again, at least 15 minutes.
SHARE_STATUS_DIR=.sentryusb
SHARE_STATUS_NAME=archive-status.json

function json_string () {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\t'/\\t}
  s=${s//$'\n'/\\n}
  s=${s//$'\r'/\\r}
  printf '"%s"' "$s"
}

function json_int () {
  if [[ "${1:-}" =~ ^[0-9]+$ ]]; then printf '%s' "$1"; else printf 'null'; fi
}

function json_bool () {
  if "$@" >/dev/null 2>&1; then printf 'true'; else printf 'false'; fi
}

# Snapshot log, written by make_snapshot (bash or Rust), one line per run:
# "<name>\t<unix time taken>\t1" for a kept snapshot (lines kept after the
# snapshot is released), "-\t<unix time>\t0" for a run discarded as
# identical to the previous one (the car wrote nothing new). Lines from
# before the third column existed are kept snapshots.
SNAPSHOT_LOG=/mutable/snapshot_log.tsv

# Bring the snapshot log up to date for the status file: add snapshots on
# the Pi that it doesn't list yet (taken before the log existed; their time
# is the image's mtime, set when it was copied), and drop lines older than 8
# days so it stays small. Prints the "snapshots" JSON array: every snapshot
# run in the last 7 days, oldest first, at most 1000, one per name and time.
# Kept snapshots: {"name", "started_unix", "kept": true}; runs discarded as
# identical: {"started_unix", "kept": false}.
function snapshot_log_json () {
  local toc dir name taken
  for toc in /backingfiles/snapshots/snap-[0-9]*/snap.bin.toc
  do
    [ -e "$toc" ] || continue
    dir=${toc%/snap.bin.toc}
    name=${dir##*/}
    grep -q "^$name"$'\t' "$SNAPSHOT_LOG" 2>/dev/null && continue
    taken=$(stat -c %Y "$dir/snap.bin" 2>/dev/null || stat -c %Y "$toc" 2>/dev/null) || continue
    printf '%s\t%s\t1\n' "$name" "$taken" >> "$SNAPSHOT_LOG" 2>/dev/null || true
  done
  local now
  now=$(date +%s)
  if [ -s "$SNAPSHOT_LOG" ] &&
     awk -F'\t' -v cut=$((now - 8 * 86400)) '$2 + 0 >= cut' "$SNAPSHOT_LOG" > "$SNAPSHOT_LOG.new" 2>/dev/null
  then
    mv -f "$SNAPSHOT_LOG.new" "$SNAPSHOT_LOG" 2>/dev/null || rm -f "$SNAPSHOT_LOG.new"
  fi
  { cat "$SNAPSHOT_LOG" 2>/dev/null || true; } |
    awk -F'\t' -v cut=$((now - 7 * 86400)) '
      ($1 ~ /^snap-[0-9]+$/ || ($1 == "-" && $3 == "0")) && $2 ~ /^[0-9]+$/ && $2 + 0 >= cut &&
      !seen[$1 "\t" $2]++ { print $2 "\t" $1 "\t" ($1 == "-" ? 0 : 1) }' |
    sort -n | tail -n 1000 |
    awk -F'\t' 'BEGIN { printf "[" }
      {
        if ($3 == 1) e = sprintf("{ \"name\": \"%s\", \"started_unix\": %s, \"kept\": true }", $2, $1)
        else e = sprintf("{ \"started_unix\": %s, \"kept\": false }", $1)
        printf "%s\n    %s", (NR > 1 ? "," : ""), e
      }
      END { printf (NR ? "\n  ]" : "]") }'
}

function build_share_status_json () {
  local clip=null stopped=null ran=false
  [ -z "${ARCHIVE_LAST_CLIP:-}" ] || clip=$(json_string "$ARCHIVE_LAST_CLIP")
  [ -z "${ARCHIVE_VERIFY_STOPPED:-}" ] || stopped=$(json_string "$ARCHIVE_VERIFY_STOPPED")
  [ "${ARCHIVE_VERIFY_RAN:-0}" != 1 ] || ran=true
  printf '{\n'
  printf '  "schema": 1,\n'
  printf '  "device": %s,\n' "$(json_string "$(hostname 2>/dev/null || echo sentryusb)")"
  printf '  "written_unix": %s,\n' "$(date +%s)"
  printf '  "archive": {\n'
  printf '    "result": %s,\n' "$(json_string "${ARCHIVE_LAST_RESULT:-nothing_new}")"
  printf '    "started_unix": %s,\n' "$(json_int "${ARCHIVE_LAST_START:-}")"
  printf '    "finished_unix": %s,\n' "$(json_int "${ARCHIVE_LAST_END:-}")"
  printf '    "files_archived": %s,\n' "$(json_int "${ARCHIVE_LAST_ARCHIVED:-0}")"
  printf '    "files_not_archived": %s,\n' "$(json_int "${ARCHIVE_LAST_LEFT:-0}")"
  printf '    "last_clip": %s\n' "$clip"
  printf '  },\n'
  printf '  "verification": {\n'
  printf '    "enabled": %s,\n' "$(json_bool archive_verify_enabled)"
  printf '    "ran": %s,\n' "$ran"
  printf '    "matched": %s,\n' "$(json_int "${ARCHIVE_VERIFY_MATCHED:-0}")"
  printf '    "converted": %s,\n' "$(json_int "${ARCHIVE_VERIFY_CONVERTED:-0}")"
  printf '    "resending": %s,\n' "$(json_int "${ARCHIVE_VERIFY_RESEND:-0}")"
  printf '    "no_pi_copy": %s,\n' "$(json_int "${ARCHIVE_VERIFY_NOSOURCE:-0}")"
  printf '    "still_queued": %s,\n' "$(json_int "${ARCHIVE_VERIFY_LEFT:-0}")"
  printf '    "stopped": %s\n' "$stopped"
  printf '  },\n'
  printf '  "auto_delete_enabled": %s,\n' "$(json_bool archive_auto_delete_enabled)"
  printf '  "state": %s,\n' "$(json_string "${ARCHIVE_SHARE_STATE:-idle}")"
  local interval="${SNAPSHOT_INTERVAL:-3480}"
  [[ "$interval" =~ ^[0-9]+$ ]] && [ "$interval" -gt 0 ] || interval=3480
  printf '  "snapshot_interval_s": %s,\n' "$interval"
  printf '  "snapshots": %s,\n' "$(snapshot_log_json)"
  if [ -n "${ARCHIVE_PLAN_START:-}" ]
  then
    printf '  "transfer": {\n'
    printf '    "started_unix": %s,\n' "$(json_int "$ARCHIVE_PLAN_START")"
    printf '    "files": %s,\n' "$(json_int "${ARCHIVE_PLAN_FILES:-0}")"
    printf '    "bytes": %s,\n' "$(json_int "${ARCHIVE_PLAN_BYTES:-0}")"
    printf '    "first_clip": %s,\n' "$(if [ -n "${ARCHIVE_PLAN_FIRST:-}" ]; then json_string "$ARCHIVE_PLAN_FIRST"; else printf null; fi)"
    printf '    "last_clip": %s,\n' "$(if [ -n "${ARCHIVE_PLAN_LAST:-}" ]; then json_string "$ARCHIVE_PLAN_LAST"; else printf null; fi)"
    printf '    "expected_finish_unix": %s,\n' "$(json_int "${ARCHIVE_PLAN_FINISH:-}")"
    printf '    "give_up_unix": %s\n' "$(json_int "${ARCHIVE_PLAN_GIVE_UP:-}")"
    printf '  }\n'
  else
    printf '  "transfer": null\n'
  fi
  printf '}\n'
}

# Bytes per second of the last successful transfer (see
# record_archive_throughput); used to estimate when the next one finishes.
ARCHIVE_THROUGHPUT_FILE=/mutable/archive_throughput

# Plan the transfer about to start, for the "transferring" status file:
# $1 is the archive list, $2 the directory its paths are relative to.
function plan_share_transfer () {
  local list=$1 root=$2 rate secs
  ARCHIVE_PLAN_START=$(date +%s)
  ARCHIVE_PLAN_FILES=$(wc -l < "$list")
  # Sizes through the links; the earlier short-recording pass already
  # mounted the same snapshots, so this is a cheap second stat.
  ARCHIVE_PLAN_BYTES=$( (cd "$root" && xargs -a "$list" -d '\n' stat -L -c %s 2>/dev/null) |
    awk '{ t += $1 } END { printf "%d", t }')
  local range
  range=$(awk -F/ '$NF ~ /\.mp4$/ { print $NF "\t" $0 }' "$list" | LC_ALL=C sort | cut -f2-)
  ARCHIVE_PLAN_FIRST=$(head -1 <<< "$range")
  ARCHIVE_PLAN_LAST=$(tail -1 <<< "$range")
  rate=$(cat "$ARCHIVE_THROUGHPUT_FILE" 2>/dev/null || true)
  [[ "$rate" =~ ^[0-9]+$ ]] && [ "$rate" -gt 0 ] || rate=2000000
  secs=$(( ARCHIVE_PLAN_BYTES / rate + 60 ))
  if travel_mode_active; then secs=$((secs * 2)); fi
  ARCHIVE_PLAN_FINISH=$((ARCHIVE_PLAN_START + secs))
  local grace=$((secs / 2))
  [ "$grace" -ge 900 ] || grace=900
  ARCHIVE_PLAN_GIVE_UP=$((ARCHIVE_PLAN_FINISH + grace))
}

# After a fully successful transfer of at least 30 s, remember its
# throughput for the next estimate. Short or failed transfers say little.
function record_archive_throughput () {
  local secs=$(( ${ARCHIVE_LAST_END:-0} - ${ARCHIVE_PLAN_START:-0} ))
  [ "${ARCHIVE_LAST_RESULT:-}" = ok ] || return 0
  [ "$secs" -ge 30 ] && [ "${ARCHIVE_PLAN_BYTES:-0}" -gt 0 ] || return 0
  echo $(( ARCHIVE_PLAN_BYTES / secs )) > "$ARCHIVE_THROUGHPUT_FILE.new" &&
    mv "$ARCHIVE_THROUGHPUT_FILE.new" "$ARCHIVE_THROUGHPUT_FILE"
}

# Write the status file to the archive destination. Best effort: a failure
# is logged and never fails the archive cycle.
function write_share_status () {
  [ "${ARCHIVE_SYSTEM:-none}" != "none" ] || return 0
  local stage=/tmp/archive-share-status
  rm -rf "$stage"
  mkdir -p "$stage/$SHARE_STATUS_DIR" || return 1
  build_share_status_json > "$stage/$SHARE_STATUS_DIR/$SHARE_STATUS_NAME" || return 1
  case "$ARCHIVE_SYSTEM" in
    cifs|nfs)
      # Copy to a dot-named temp file beside it, then rename over the old one.
      local dest="$ARCHIVE_MOUNT/$SHARE_STATUS_DIR"
      timeout 30 mkdir -p "$dest" &&
        timeout 30 cp "$stage/$SHARE_STATUS_DIR/$SHARE_STATUS_NAME" "$dest/.$SHARE_STATUS_NAME.tmp" &&
        timeout 30 mv -f "$dest/.$SHARE_STATUS_NAME.tmp" "$dest/$SHARE_STATUS_NAME"
      ;;
    rsync)
      # rsync writes a dot-named temp file and renames it into place.
      local -a ssh_cmd
      archive_ssh_command
      timeout 60 rsync -r --no-perms --omit-dir-times -e "${ssh_cmd[*]}" \
        "$stage/$SHARE_STATUS_DIR" "$RSYNC_USER@$RSYNC_SERVER:$RSYNC_PATH/"
      ;;
    rclone)
      timeout 120 rclone --config /root/.config/rclone/rclone.conf copyto \
        "$stage/$SHARE_STATUS_DIR/$SHARE_STATUS_NAME" "$RCLONE_DRIVE:$RCLONE_PATH/$SHARE_STATUS_DIR/$SHARE_STATUS_NAME"
      ;;
    *)
      return 0
      ;;
  esac
}

function write_archive_status () {
  echo "$1" > /tmp/archive_status.json.tmp
  mv /tmp/archive_status.json.tmp /tmp/archive_status.json
}

function clear_archive_status () {
  rm -f /tmp/archive_status.json /tmp/archive_status.json.tmp
}

# RATE_MILLI and ETA_SECONDS belong to one monitor/job, never to a UI session.
function archive_eta_sample () {
  local completed="$1" total="$2" elapsed="$3" recent_done="$4" recent_elapsed="$5" idle="$6"
  ETA_SECONDS=null
  ETA_STATE=estimating
  if [ "$completed" -ge "$total" ]; then ETA_SECONDS=0; ETA_STATE=complete; return; fi
  if [ "$idle" -ge 60 ]; then ETA_STATE=stalled; return; fi
  if [ "$elapsed" -lt 30 ] || [ "$completed" -lt 3 ] || [ "$recent_elapsed" -le 0 ]; then return; fi
  local recent_rate=$((recent_done * 1000 / recent_elapsed))
  local overall_rate=$((completed * 1000 / elapsed))
  local measured=$(((recent_rate * 3 + overall_rate) / 4))
  if [ "$measured" -gt 0 ]; then
    if [ "${RATE_MILLI:-0}" -gt 0 ]; then RATE_MILLI=$(((RATE_MILLI * 3 + measured) / 4)); else RATE_MILLI=$measured; fi
    ETA_SECONDS=$(((total - completed) * 1000 / RATE_MILLI))
    ETA_STATE=ready
  fi
}

function archive_progress_monitor () {
  local total="$1" listfile="$2" overlay="$3" push_counter=0
  local resume_hash="${4:-}" resume_offset="${5:-0}" resume_total="${6:-$1}"
  local start_time sampled_at start_tick now_tick done=0 last_done=0 last_change=0
  local RATE_MILLI=0 ETA_SECONDS=null ETA_STATE=estimating
  local -a pending remaining sample_times=(0) sample_counts=(0)
  mapfile -t pending < "$listfile"
  start_time=$(date +%s)
  read -r start_tick _ < /proc/uptime
  start_tick=${start_tick%.*}

  while true; do
    sleep 5
    remaining=()
    for line in "${pending[@]}"; do
      if [ -L "$overlay/$line" ]; then remaining+=("$line"); else done=$((done + 1)); fi
    done
    pending=("${remaining[@]}")
    sampled_at=$(date +%s)
    read -r now_tick _ < /proc/uptime
    now_tick=$((${now_tick%.*} - start_tick))
    if [ "$done" -gt "$last_done" ]; then last_change=$now_tick; last_done=$done; fi
    sample_times+=("$now_tick")
    sample_counts+=("$done")
    while [ "${#sample_times[@]}" -gt 2 ] && [ "$((now_tick - sample_times[1]))" -ge 120 ]; do
      sample_times=("${sample_times[@]:1}")
      sample_counts=("${sample_counts[@]:1}")
    done
    archive_eta_sample "$done" "$total" "$now_tick" "$((done - sample_counts[0]))" "$((now_tick - sample_times[0]))" "$((now_tick - last_change))"
    local progress="{\"phase\":\"archiving\",\"job_id\":\"${ARCHIVE_CYCLE_ID:-$start_time}\",\"current\":$done,\"total\":$total,\"started_at\":$start_time,\"sampled_at\":$sampled_at,\"eta_seconds\":$ETA_SECONDS,\"eta_state\":\"$ETA_STATE\"}"
    write_archive_status "$progress"
    write_archive_checkpoint "$progress" "$resume_hash" "$resume_offset" "$resume_total" || true

    push_counter=$((push_counter + 1))
    if [ $((push_counter % 6)) -eq 0 ]; then
      /root/bin/send-live-activity update archiving "$done" "$total" "${ETA_SECONDS/null/0}" || true
    fi
  done
}

function clean_empty_cam_directories {
  local root
  local -a roots=()
  for root in "$CAM_MOUNT/TeslaCam/RecentClips" "$CAM_MOUNT/TeslaCam/SavedClips" \
    "$CAM_MOUNT/TeslaCam/SentryClips" "$CAM_MOUNT/TeslaTrackMode"; do
    [ ! -d "$root" ] || roots+=("$root")
  done
  [ "${#roots[@]}" -gt 0 ] || return 0
  archive_run_command find "${roots[@]}" -mindepth 1 -type d -empty -delete
}

function clean_cam_mount {
  archive_cancel_requested && return 0
  if [ -e "${CAM_CLEANUP_DEFERRED:-/mutable/sentryusb_cam_cleanup_deferred}" ]; then
    log "Skipping cam cleanup until a later archive succeeds after user cancellation"
    return 0
  fi

  local mode="${1:-}"

  if [ "$mode" = "freespace" ]
  then
    # Durable cleanup obligations must not be suppressed by the throttle.
    if [ ! -e "$CAM_CLEANUP_PENDING" ] && [ -e /tmp/last_clean_time ]
    then
      read -r -d . last < /tmp/last_clean_time
      read -r -d . now < /proc/uptime
      if (( (now - last) < 300 ))
      then
        log "skipping cleaning cam mount"
        return
      fi
    fi
    cat /proc/uptime > /tmp/last_clean_time
  fi

  log "cleaning cam mount"
  ensure_cam_file_is_mounted || return 1

  # Delete the files that fsck "recovered". These are generally files
  # that were deleted previously by the car or teslausb
  archive_run_command find "${CAM_MOUNT}" \( \( -type f -name FSCK\*.REC \) -o \( -type f -name "*~[0-9].MP4" \) \) -exec rm -rf -- {} + || { ARCHIVE_ALL_STAGES_OK=0; [ -z "${ARCHIVE_STAGE_FAILURE_FILE:-}" ] || touch "$ARCHIVE_STAGE_FAILURE_FILE"; }
  # exFAT counterpart: orphans rescued by "fsck.exfat -s". fix_errors_in_image
  # normally deletes these already; this catches a manual fsck or an
  # interrupted reclaim.
  if [ -d "${CAM_MOUNT}/LOST+FOUND" ]
  then
    archive_run_command rm -rf -- "${CAM_MOUNT}/LOST+FOUND" || { ARCHIVE_ALL_STAGES_OK=0; [ -z "${ARCHIVE_STAGE_FAILURE_FILE:-}" ] || touch "$ARCHIVE_STAGE_FAILURE_FILE"; }
  fi

  # Delete short recordings
  archive_run_command find "${CAM_MOUNT}" -type f -name \*.mp4 -size -100000c -delete || { ARCHIVE_ALL_STAGES_OK=0; [ -z "${ARCHIVE_STAGE_FAILURE_FILE:-}" ] || touch "$ARCHIVE_STAGE_FAILURE_FILE"; }

  if [ "$mode" = "freespace" ] && ! archive_cancel_requested
  then
    # Remove files, oldest first, until there is at least 20GB of free space
 
    (cd "${CAM_MOUNT}"; find . -type f -a \( -path './TeslaCam/*' -o -path './TeslaTrackMode/*' \) -printf '%P\0') > /tmp/rmcandidates.txt
    if [ -s /tmp/rmcandidates.txt ]
    then
      (cd "${CAM_MOUNT}"; xargs -a /tmp/rmcandidates.txt -0 ls -cr1) > /tmp/rmcandidatesbytime.txt
    else
      true > /tmp/rmcandidatesbytime.txt
    fi
 
    local freespace
    while read -r line
    do
      archive_cancel_requested && break
      freespace=$(eval "$(stat --file-system --format="echo \$((%f*%S))" "${CAM_MOUNT}/.")")
      if ((freespace > 20000000000))
      then
        break;
      fi
      archive_cancel_requested && break
      rm "${CAM_MOUNT}/$line" || ARCHIVE_ALL_STAGES_OK=0
    done < /tmp/rmcandidatesbytime.txt
    # Clean up temp files from RAM-backed /tmp
    rm -f /tmp/rmcandidates.txt /tmp/rmcandidatesbytime.txt
  fi

  # delete directories that are now empty
  clean_empty_cam_directories || { ARCHIVE_ALL_STAGES_OK=0; [ -z "${ARCHIVE_STAGE_FAILURE_FILE:-}" ] || touch "$ARCHIVE_STAGE_FAILURE_FILE"; }

  # Trim the camera archive to reduce the number of blocks in the snapshot.
  if ! archive_cancel_requested; then trim_free_space "$CAM_MOUNT" || ARCHIVE_ALL_STAGES_OK=0; fi

  unmount_cam_file

  log "done cleaning cam mount"
  if [ "$mode" = "freespace" ] && ! archive_cancel_requested
  then
    clear_cam_cleanup_pending
  fi
}

# Retire snapshot-farm links for short recordings only after live-image
# cleanup succeeds. The immutable snapshot itself remains available.
function retire_short_recording_links_locked () {

  local ignorelist="$1"
  local index_root="$2"
  local path link size
  local -i retired=0

  while IFS= read -r path
  do
    archive_cancel_requested && return 0
    link="$index_root/$path"
    if [ -L "$link" ] &&
       size=$(stat -Lc '%s' -- "$link" 2>/dev/null) &&
       [ "$size" -lt 100000 ] && ! archive_cancel_requested
    then
      if rm -f -- "$link"
      then
        retired=$((retired + 1))
      else
        log "ERROR: failed to retire cleaned short recording link $link"
        return 1
      fi
    fi
  done < "$ignorelist"

  archive_run_command find "$index_root/RecentClips" "$index_root/SavedClips" \
    "$index_root/SentryClips" "$index_root/TeslaTrackMode" \
    -mindepth 1 -depth -type d -empty -delete 2>/dev/null || true

  if [ "$retired" -gt 0 ]
  then
    log "Retired $retired cleaned short recording link(s) from snapshot index"
  fi
}

function retire_short_recording_links () {

  local ignorelist="$1"
  local index_root="${2:-/mutable/TeslaCam}"

  [ -s "$ignorelist" ] || return 0
  (
    if ! flock -x -w 30 9
    then
      log "ERROR: snapshot lock busy; short recording links remain pending"
      exit 1
    fi
    retire_short_recording_links_locked "$ignorelist" "$index_root"
  ) 9< "$SNAPSHOT_LOCK_DIR"
}

# Directory structure car uses:
# TeslaCam/
#   RecentClips/
#      videos.mp4
#   SavedClips/
#     datetime/
#       videos.mp4
#       event.json
#       thumb.png
#   SentryClips/
#     datetime/
#       videos.mp4
#       event.json
#       thumb.png
# TeslaTrackMode/
#   lapvideo.mp4
#   laptelemetry.csv
# Read the SoC temperature directly from the thermal zone, formatted to match the
# temperature_monitor output. Echoes nothing on devices with no thermal sensor.
# Called inline at the moment of an archive failure so the value reflects the
# temperature *before* the chip cools: overheating (WiFi drop / throttling) is a
# common cause of archive failures, and the periodic monitor only samples once a
# minute, so by the time it logs the chip has already cooled.
# Matches the dashboard's saved system-temperature override, falling back to
# the main temperature unit when no override is set.
function soc_temperature () {
  local zone=/sys/class/thermal/thermal_zone0/temp
  [ -e "$zone" ] || return 0
  local raw
  raw=$(cat "$zone" 2>/dev/null) || return 0
  [ -n "$raw" ] || return 0
  if [ "$(system_temperature_unit)" = "F" ]; then
    awk -v r="$raw" 'BEGIN { printf "%.1f°F", r/1000 * 9/5 + 32 }'
  else
    awk -v r="$raw" 'BEGIN { printf "%.1f°C", r/1000 }'
  fi
}

function archive_teslacam_clips () {
  log "Checking saved folder count..."

  local -r overlaylower=/mutable/TeslaCam
  local -r overlayupper=/tmp/cam/upper
  local -r overlaywork=/tmp/cam/work
  local -r overlaymerged=/tmp/cam/merged

  rm -rf "$overlayupper" "$overlaywork" "$overlaymerged"
  mkdir -p "$overlayupper" "$overlaywork" "$overlaymerged"

  if ! mount -t overlay overlay -o "lowerdir=$overlaylower,upperdir=$overlayupper,workdir=$overlaywork" "$overlaymerged"; then
    log "ERROR: failed to mount overlay (lower=$overlaylower upper=$overlayupper merged=$overlaymerged)"
    return 1
  fi

  # Build list of the files to be archived.
  local -r sentrylist=/tmp/sentry_files
  local -r sentrylist_archived=/tmp/sentry_files_archived
  local -r sentrylist_previously_archived=/mutable/sentry_files_archived
  local -r ignorelist=/tmp/ignore_files

  # Find files by name only. Don't follow the symlinks yet, since that
  # would cause all snapshots to be mounted.
  local -a savedclipsopt
  local -a sentryclipsopt
  local -a trackmodeclipsopt
  local -a recentclipsopt
  if [ "${ARCHIVE_SAVEDCLIPS:-true}" = "true" ]
  then
    savedclipsopt=("-path" "./SavedClips/*")
  else
    savedclipsopt=("-false")
  fi
  if [ "${ARCHIVE_SENTRYCLIPS:-true}" = "true" ]
  then
    sentryclipsopt=("-o" "-path" "./SentryClips/*")
  fi
  if [ "${ARCHIVE_TRACKMODECLIPS:-true}" = "true" ]
  then
    trackmodeclipsopt=("-o" "-path" "./TeslaTrackMode/*")
  fi
  if [ "${ARCHIVE_RECENTCLIPS:-false}" = "true" ]
  then
    recentclipsopt=("-o" "-path" "./RecentClips/*")
  fi
  (cd "$overlaylower"; find . \( \( "${savedclipsopt[@]}" "${sentryclipsopt[@]}" "${trackmodeclipsopt[@]}" "${recentclipsopt[@]}" \) -type l \) \
        -a -fprintf "$sentrylist" '%P\n')

  # Copy lists of previously-archived files from /mutable
  if [ -r "${sentrylist_previously_archived}" ]
  then
    cp "${sentrylist_previously_archived}" "${sentrylist_archived}"
  fi

  # Remove files that no longer exist in snapshots from the
  # "previously archived" list, so the list doesn't keep growing.
  intersect "${sentrylist_archived}" "${sentrylist}"

  # Remove previously-archived files from the archive candidate list
  prunefile "${sentrylist}" "${sentrylist_archived}"

  # ${sentrylist} is now a list of files that haven't been archived yet.
  # Remove short recordings (.mp4 under 100000 bytes) from this list.
  # This requires following the links and looking at the files
  # themselves. One batched `stat -L` does the whole list; the previous
  # xargs|echo|eval pipeline re-parsed file paths as shell text, so a
  # clip name with spaces broke the filter and shell metacharacters in
  # a crafted filename on the cam volume would have been EXECUTED.
  # `-d '\n'` keeps each line one path; broken symlinks just drop out
  # (stat errors to /dev/null), matching the old find -L behavior.
  # The same stat pass also records every readable entry; the unreadable
  # remainder is re-checked one by one below, since a failed stat alone
  # does not prove the source is gone.
  local -r presentlist=/tmp/present_files
  if [ -s "${sentrylist}" ]
  then
    (cd "$overlaymerged"; xargs -a "${sentrylist}" -d '\n' stat -L --format='%s %n' 2>/dev/null) \
      | awk -v ignore="${ignorelist}" -v present="${presentlist}" '
          BEGIN { printf "" > ignore; printf "" > present }
          { line = $0; sub(/^[0-9]+ /, "", line); print line > present
            if ($1 < 100000 && line ~ /\.mp4$/) print line > ignore }'
  else
    true > "${ignorelist}"
    true > "${presentlist}"
  fi

  # remove the short files from the list of files to be archived
  prunefile "${sentrylist}" "${ignorelist}"

  # Drop entries whose source is PROVABLY gone: rsync --ignore-missing-args
  # skips them silently, so counting them reports files that will never
  # move (e.g. clips the car relocated into an event folder). Entries that
  # merely failed to stat stay counted — under-counting hides real work.
  local -r missinglist=/tmp/missing_files
  local -r absentlist=/tmp/absent_files
  cp "${sentrylist}" "${missinglist}"
  prunefile "${missinglist}" "${presentlist}"
  true > "${absentlist}"
  if [ -s "${missinglist}" ]
  then
    classify_missing_entries "${missinglist}" "${absentlist}" "${overlaymerged}"
  fi
  local stale_count unknown_count
  stale_count=$(wc -l < "${sentrylist}")
  prunefile "${sentrylist}" "${absentlist}"
  stale_count=$((stale_count - $(wc -l < "${sentrylist}")))
  unknown_count=$(($(wc -l < "${missinglist}") - $(wc -l < "${absentlist}")))

  # apply custom removals/additions
  filterfile "${sentrylist}"

  local -r sentry_count=$(grep -c -v TeslaTrackMode "$sentrylist")
  local -r trackmode_count=$(grep -c TeslaTrackMode "$sentrylist")
  local -r ignore_count=$(wc -l < "$ignorelist")
  local -r total_count=$((sentry_count + trackmode_count))

  # extract some noteworthy info from the file list
  local -r saved_event_count=$(grep 'SavedClips/' < "$sentrylist" | sed 's/[^\/]\+$//' | sort -u  | wc -l)
  local -r sentry_event_count=$(grep 'SentryClips/' < "$sentrylist" | sed 's/[^\/]\+$//' | sort -u  | wc -l)

  local -r event_count=$((saved_event_count + sentry_event_count))

  log "There are $event_count event folder(s) with $sentry_count file(s) and $trackmode_count track mode file(s) to move." \
      " $ignore_count short recording(s) will be skipped."
  if [ "$stale_count" -gt 0 ]
  then
    log "Ignoring $stale_count stale list entry(s) whose source files no longer exist"
  fi
  if [ "$unknown_count" -gt 0 ]
  then
    log "Keeping $unknown_count list entry(s) counted: source status could not be determined"
  fi

  local archive_success=true
  # Results for the status file on the share (write_share_status). Reset
  # here so a cycle with nothing new reports that, not the previous cycle.
  ARCHIVE_LAST_RESULT=nothing_new
  ARCHIVE_LAST_START=$(date +%s)
  ARCHIVE_LAST_END=$ARCHIVE_LAST_START
  ARCHIVE_LAST_ARCHIVED=0
  ARCHIVE_LAST_LEFT=0
  ARCHIVE_LAST_CLIP=""
  ARCHIVE_PLAN_START="" ARCHIVE_SHARE_STATE=idle
  if [[ "$total_count" -gt 0 ]]
  then
    log "Starting recording archiving"
    local -r start_ts=$(date --utc --date "now" +%s)

    local message="Archiving "
    local fail_temp=""
    if [[ $sentry_count -gt 0 && $trackmode_count -gt 0 ]]
    then
      message+="$trackmode_count track mode file(s) and $sentry_count file(s) including $event_count event folder(s)"
    elif [[ $sentry_count -gt 0 && $event_count -gt 0 ]]
    then
      message+="$sentry_count file(s) including $event_count event folder(s)"
    elif [[ $sentry_count -gt 0 ]]
    then
      message+="$sentry_count file(s)"
    else
      message+="$trackmode_count track mode file(s)"
    fi

    # Only carry progress across attempts when their candidate lists match.
    local resume_hash prior_done resume_offset resume_total
    read -r resume_hash prior_done resume_offset resume_total <<< \
      "$(archive_resume_context "$sentrylist" "$total_count" || printf 'unknown 0 0 %s' "$total_count")"
    if [[ $prior_done -gt 0 ]]; then
      message+=" ($prior_done/$resume_total archived, resuming archive after reconnect)"
    fi

    message+=" starting at $(date)"
    if [ "${ARCHIVE_RETRY_ATTEMPT:-0}" = "1" ]; then
      # Retry attempt after a failed cycle: the user already got the
      # failure push; don't re-announce the start every minute.
      log "Retry attempt: suppressing archive-start notification"
    else
      ARCHIVE_TOTAL_COUNT=$total_count /root/bin/send-push-message "$NOTIFICATION_TITLE:" "$message" start archive_start "$(archive_start_summary "$total_count" "$prior_done" "$resume_total")" || log "failed to send mobile app notification"
      /root/bin/send-live-activity start "$total_count" || true
      LIVE_ACTIVITY_ACTIVE=1
    fi

    # setup trigger files
    local -r triggerdir=/tmp/triggers
    local -r triggerlist=/tmp/triggers.txt
    rm -rf "${triggerdir}"
    mkdir -p "${triggerdir}/SentryClips"
    mkdir -p "${triggerdir}/SavedClips"
    mkdir -p "${triggerdir}/RecentClips"
    true > "${triggerlist}"
    if [ -n "${TRIGGER_FILE_SAVED+x}" ]
    then
      touch "${triggerdir}/SavedClips/${TRIGGER_FILE_SAVED}"
      echo "SavedClips/${TRIGGER_FILE_SAVED}" >> "${triggerlist}"
    fi
    if [ -n "${TRIGGER_FILE_SENTRY+x}" ]
    then
      touch "${triggerdir}/SentryClips/${TRIGGER_FILE_SENTRY}"
      echo "SentryClips/${TRIGGER_FILE_SENTRY}" >> "${triggerlist}"
    fi
    if [ -n "${TRIGGER_FILE_RECENT+x}" ]
    then
      touch "${triggerdir}/RecentClips/${TRIGGER_FILE_RECENT}"
      echo "RecentClips/${TRIGGER_FILE_RECENT}" >> "${triggerlist}"
    fi
    if [ -n "${TRIGGER_FILE_ANY+x}" ]
    then
      touch "${triggerdir}/${TRIGGER_FILE_ANY}"
      echo "${TRIGGER_FILE_ANY}" >> "${triggerlist}"
    fi

    write_archive_status "{\"phase\":\"archiving\",\"job_id\":\"${ARCHIVE_CYCLE_ID:-$start_ts}\",\"current\":0,\"total\":$total_count,\"started_at\":$start_ts,\"sampled_at\":$start_ts,\"eta_seconds\":null,\"eta_state\":\"estimating\"}"
    archive_progress_monitor "$total_count" "${sentrylist}" "$overlaymerged" "$resume_hash" "$resume_offset" "$resume_total" &
    local progress_pid=$!

    # Note which snapshot file each clip is sent from, so it can be
    # checksummed against the archive server's copy afterwards.
    local -r linktargets=/tmp/archive_link_targets
    record_archive_link_targets "$overlaylower" "${sentrylist}" "$linktargets"

    # Tell tools reading the share a transfer is starting: which clips, and
    # when it should be done (see the status file notes above).
    plan_share_transfer "${sentrylist}" "$overlaymerged"
    ARCHIVE_SHARE_STATE=transferring ARCHIVE_LAST_RESULT=in_progress
    write_share_status || log "WARNING: could not write $SHARE_STATUS_DIR/$SHARE_STATUS_NAME to the archive"
    ARCHIVE_SHARE_STATE=idle

    local travel_active=0
    if travel_mode_active; then travel_active=1; fi
    if TRAVEL_MODE_ACTIVE="$travel_active" archive_run_command /root/bin/archive-clips.sh "$overlaymerged" "${sentrylist}" "${triggerdir}" "${triggerlist}"
    then
      message="Archiving completed successfully. "
      rm -f "$ARCHIVE_DEST_FULL_MARKER" || true
    else
      local arc_exit=$?
      message="Error during archiving (archive-clips.sh exit code $arc_exit). "
      archive_success=false
      if [ "$arc_exit" = 75 ]; then ARCHIVE_RSYNC_TIMEOUT=1; fi
      if archive_cancel_requested; then
        message="Archiving cancelled by user. "
        log "Archive transfer cancelled by user"
      else
      log "ERROR: archive-clips.sh failed with exit code $arc_exit"
      # Capture SoC temperature immediately, before the chip cools, to help
      # diagnose overheating-related archive failures.
      fail_temp=$(soc_temperature)
      if [ -n "$fail_temp" ]; then
        log "SoC temperature at archive failure: $fail_temp"
      fi
      if [ -e /tmp/rsynclog ]; then
        log "--- rsync output ---"
        tail -20 /tmp/rsynclog >> "$LOG_FILE"
        log "--- end rsync output ---"
      fi
      if [ -e /tmp/archive-rsync-cmd.log ]; then
        log "--- rsync cmd log (last 10 lines) ---"
        tail -10 /tmp/archive-rsync-cmd.log >> "$LOG_FILE"
        log "--- end rsync cmd log ---"
      fi
      if archive_destination_is_full; then
        ARCHIVE_DEST_FULL=1
        log "Archive destination is out of space; automatic retries pause until space is freed"
      fi
      fi
    fi

    kill "$progress_pid" 2>/dev/null || true
    wait "$progress_pid" 2>/dev/null || true

    local -i sentry_archived=0
    local -i trackmode_archived=0
    local -r remaining_list=/tmp/sentry_files_remaining
    local remaining_list_valid=true
    if ! true > "$remaining_list"; then remaining_list_valid=false; fi
    local -r newly_archived=/tmp/archive_newly_archived
    true > "$newly_archived" || true

    while read -r line
    do
      if [[ ! -L "$overlaymerged/$line" ]]
      then
        case $line in
          TeslaTrackMode*)
            trackmode_archived=$((trackmode_archived + 1))
            ;;
          *)
            sentry_archived=$((sentry_archived + 1))
            ;;
        esac
        echo "$line" >> "${sentrylist_archived}"
        echo "$line" >> "$newly_archived" || true
      elif [[ "$remaining_list_valid" == true ]] && ! printf '%s\n' "$line" >> "$remaining_list"; then
        remaining_list_valid=false
      fi
    done < ${sentrylist}

    # Cleanup still owed after files left the overlay (even if the car leaves
    # before free-space cleanup). Publish before the durable ledger so a
    # power cut cannot leave archived clips on cam with no cleanup obligation.
    ARCHIVE_NEW_FILES=$((sentry_archived + trackmode_archived))
    if [ "$sentry_archived" -gt 0 ] || [ "$trackmode_archived" -gt 0 ]
    then
      mark_cam_cleanup_pending || true
    fi

    # Queue what actually moved this cycle for SHA-256 verification.
    queue_archived_for_verification "$newly_archived" "$linktargets" "$overlaylower"

    # copy the list of archived files back to /mutable if it has changed
    if ! diff -q -N "${sentrylist_archived}" "${sentrylist_previously_archived}" > /dev/null
    then
        cp "${sentrylist_archived}" "${sentrylist_previously_archived}.new"
        mv "${sentrylist_previously_archived}.new" "${sentrylist_previously_archived}"
    fi

    local cancelled=false
    if archive_cancel_requested; then cancelled=true; fi
    if [[ "$remaining_list_valid" == true ]]; then
      finish_archive_checkpoint "$archive_success" "$cancelled" "$remaining_list" \
        "$((total_count - ARCHIVE_NEW_FILES))" "$((resume_offset + ARCHIVE_NEW_FILES))" "$resume_total" \
        || log "Unable to save archive resume checkpoint"
    else
      rm -f /mutable/archive_in_progress.json || true
      log "Unable to save archive resume checkpoint"
    fi

    message+="Archived "
    if [[ $sentry_count -gt 0 && $trackmode_count -gt 0 ]]
    then
      message+="${trackmode_archived} trackmode files and ${sentry_archived} other files"
    elif [[ $sentry_count -gt 0 ]]
    then
      message+="${sentry_archived} files"
    else
      message+="${trackmode_archived} trackmode files"
    fi
    local -r end_ts=$(date --utc --date "now" +%s)
    local -r delta=$((end_ts - start_ts))
    ARCHIVE_LAST_START=$start_ts
    ARCHIVE_LAST_END=$end_ts
    ARCHIVE_LAST_ARCHIVED=$((sentry_archived + trackmode_archived))
    ARCHIVE_LAST_LEFT=$((total_count - ARCHIVE_LAST_ARCHIVED))
    if [ "$archive_success" = "true" ]; then ARCHIVE_LAST_RESULT=ok; else ARCHIVE_LAST_RESULT=failed; fi
    # Newest clip moved this cycle, by clip name (Tesla names sort by time).
    ARCHIVE_LAST_CLIP=$(awk -F/ '$NF ~ /\.mp4$/ { print $NF "\t" $0 }' "$newly_archived" 2>/dev/null |
      LC_ALL=C sort | tail -1 | cut -f2-)
    record_archive_throughput || log "WARNING: could not save the archive throughput estimate"
    message+=" in $(convert_seconds_to_nice_time $delta)"
    if [ "$archive_success" = "false" ] && [ -n "$fail_temp" ]; then
      message+=". SoC temp at failure: $fail_temp"
    fi
    if archive_cancel_requested; then
      log "Archive cancelled by user; completed transfers recorded, remaining footage preserved"
    elif [ "${ARCHIVE_DEST_FULL:-0}" = "1" ]; then
      # One notice per full episode (re-sent at most every 12 hours), even on
      # a retry: this failure needs the user, and nothing retries on a timer.
      if archive_destination_full_notice_due; then
        /root/bin/send-push-message "$NOTIFICATION_TITLE:" \
          "Archive server is out of space. ${message}. Archiving is paused: free up space on the server, then tap Sync, or it tries again the next time you get home." \
          finish archive_error "Archive server is full. Archiving is paused until there's space." \
          || log "failed to send mobile app notification"
        touch "$ARCHIVE_DEST_FULL_MARKER" || true
      else
        log "Archive destination still full: suppressing repeat notification (${message})"
      fi
    elif [ "${ARCHIVE_RETRY_ATTEMPT:-0}" = "1" ] && [ "$archive_success" = "false" ]; then
      # Still failing on a retry: log it, but don't push a failure
      # notification every minute. The eventual success (or the first
      # failure of a normal cycle) still notifies.
      log "Retry attempt failed: suppressing archive-finish notification (${message})"
    else
      local notification_category=archive_complete
      if [[ "$archive_success" == false ]]; then notification_category=archive_error; fi
      /root/bin/send-push-message "$NOTIFICATION_TITLE:" "${message}" finish "$notification_category" \
        "$(archive_finish_summary "$archive_success" "$total_count" "$((sentry_archived + trackmode_archived))" "$delta")"
      # Live activity: the copy is done but the cycle isn't. Keep it up
      # through drive processing ("Preparing…" until the processor has a
      # count); archive_clips ends it once processing and upload finish.
      if [ "${LIVE_ACTIVITY_ACTIVE:-0}" = "1" ]; then
        /root/bin/send-live-activity update processing 0 0 0 0 high || true
      fi
    fi

    # Check RTC battery health (Pi 5 only) — warn on every archive if dead/missing
    if ! archive_cancel_requested && [ "${RTC_BATTERY_ENABLED:-false}" = "true" ] && isPi5; then
      rtc_year=$(cut -d- -f1 < /sys/class/rtc/rtc0/date 2>/dev/null)
      if [ -n "$rtc_year" ] && [ "$rtc_year" -lt 2024 ]; then
        /root/bin/send-push-message "$NOTIFICATION_TITLE:" \
          "RTC battery appears dead or missing. Replace the battery on the Pi 5's J5 header to maintain accurate time." \
          warning rtc_battery "RTC battery needs attention. The clock may reset without power." || true
      fi
    fi

    if [ -e /tmp/archive-error.log ]
    then
      cat /tmp/archive-error.log >> ${LOG_FILE}
      rm /tmp/archive-error.log
    fi
  fi

  # overlayfs behavior is undefined if the lower is changed while the overlay is active, so umount first
  umount "$overlaymerged"

  # Preserve the completed-transfer ledger above, but NEVER run footage
  # cleanup after a user skip (including a request after the last copy).
  archive_cancel_requested && return 125

  if archive_is_reachable
  then
    if [ "$archive_success" = "true" ]
    then
      # A user skip protects footage across sleep/reboot as well. Only a
      # subsequent successful transfer may release that cleanup deferral.
      if ! archive_allow_cleanup_after_success; then
        log "ERROR: could not release deferred cam cleanup"
        return 1
      fi
      if travel_mode_active; then
        log "Travel Mode: deferring freespace cleanup to keep the USB gadget connected to the car"
        if [ "$total_count" -gt 0 ] || [ "$ignore_count" -gt 0 ]
        then
          mark_cam_cleanup_pending || true
        fi
      elif [ -e "$CAM_CLEANUP_PENDING" ]; then
        log "Completing deferred cam cleanup"
        clean_cam_mount freespace || ARCHIVE_ALL_STAGES_OK=0
        retire_short_recording_links "$ignorelist" "$overlaylower" || log "ERROR: failed to retire cleaned short recording links"
      elif [ "$total_count" -eq 0 ] && [ "$ignore_count" -eq 0 ]; then
        # Zero-clip home archives used to always clean+reconnect, thrashing USB.
        log "No archive or maintenance candidates; leaving USB gadget connected"
      else
        if [ "$total_count" -eq 0 ]; then
          log "$ignore_count short recording(s) require cam cleanup"
        else
          log "Archived files require cam cleanup"
        fi
        mark_cam_cleanup_pending || true
        clean_cam_mount freespace || ARCHIVE_ALL_STAGES_OK=0
        retire_short_recording_links "$ignorelist" "$overlaylower" || log "ERROR: failed to retire cleaned short recording links"
      fi
    else
      log "Skipping cleaning step after archive error"
    fi
  else
    log "Archive not reachable, assuming user drove away, skipping cleaning step"
    if [ "$archive_success" = "true" ] && { [ "$total_count" -gt 0 ] || [ "$ignore_count" -gt 0 ]; }
    then
      mark_cam_cleanup_pending || true
    fi
  fi

  # Report the real outcome so archive_clips can propagate failure to the
  # loop's fast-retry pacing (previously the trailing if/else made this
  # function return 0 even when archive-clips.sh failed).
  [ "$archive_success" = "true" ]
}

function copy_music_files () {
  log "Starting music sync..."

  ensure_music_file_is_mounted || return 1

  local music_result=0
  archive_run_command /root/bin/copy-music.sh || music_result=$?

  # Trim the empty space from the music archive.
  if ! archive_cancel_requested; then trim_free_space "$MUSIC_MOUNT" || ARCHIVE_ALL_STAGES_OK=0; fi

  unmount_music_file
  return "$music_result"
}

function has_cam_disk () {
  [ -f /backingfiles/cam_disk.bin ]
}

# Local recording readiness is independent of the archive destination.
# Keep optional music-only layouts working, but never publish zero media.
function usb_storage_ready () {
  findmnt -n --mountpoint /backingfiles -O rw >/dev/null 2>&1 || return 1
  if [[ ! "${CAM_SIZE:-0}" =~ ^0+([.]0+)?([kKmMgG][bB]?)?$ ]]; then
    [ -s /backingfiles/cam_disk.bin ] || return 1
  fi
  local image
  for image in cam music lightshow boombox; do
    if [ -f "/backingfiles/${image}_disk.bin" ] &&
       [ -s "/backingfiles/${image}_disk.bin" ] &&
       [ -r "/backingfiles/${image}_disk.bin" ] &&
       [ -w "/backingfiles/${image}_disk.bin" ]; then
      return 0
    fi
  done
  return 1
}

function wait_for_usb_storage () {
  local waited=0
  until usb_storage_ready; do
    if (( waited % 60 == 0 )); then
      log "USB storage unavailable: waiting for writable /backingfiles and a usable disk image (${waited}s)"
    fi
    sleep 10
    waited=$((waited + 10))
  done
  if (( waited > 0 )); then log "USB storage ready after ${waited}s; continuing startup"; fi
}

function connect_usb_at_startup () {
  until connect_usb_drives_to_host; do
    status_led_archive fault 2>/dev/null || true
    log "USB startup did not complete; retrying in 10 seconds"
    sleep 10
    wait_for_usb_storage
    # An API request may have timed out after successfully binding. Do not
    # interrupt that restored recording connection with another full cycle.
    if usb_gadget_is_active; then
      log "USB startup binding verified after retry"
      return 0
    fi
  done
}

function cloud_upload_step () {
  archive_cancel_requested && return 125
  # Cloud upload as a real archiveloop stage. Runs after post-archive-process,
  # inside the awake_start/awake_stop window so the car (and therefore Pi
  # power) stays alive for the duration. Polls the local API until pending
  # hits 0 or we hit a hard cap / stall. Failures (WiFi loss, API blip,
  # cloud-side error) are logged but never abort archiveloop — next cycle
  # resumes from whatever's still pending.
  local port="${SENTRYUSB_PORT:-80}"
  local api="http://127.0.0.1:${port}"

  local status_json
  if ! status_json=$(curl -sf -m 5 "$api/api/cloud/status" 2>/dev/null); then
    log "Cloud upload: API unreachable, skipping"
    return 1
  fi
  if ! echo "$status_json" | grep -q '"paired":true'; then
    log "Cloud upload: Pi not paired, skipping"
    return 0
  fi

  local pending
  pending=$(echo "$status_json" | grep -o '"pendingRouteCount":[0-9]*' | cut -d: -f2)
  [[ "$pending" =~ ^[0-9]+$ ]] || return 1
  if [ "$pending" -eq 0 ]; then
    log "Cloud upload: nothing to upload (0 pending)"
    return 0
  fi

  log "Cloud upload: starting upload of $pending route(s)..."

  # Kick the sweep. Fire-and-forget — actual progress is observed via /status.
  curl -sf -m 5 -X POST "$api/api/cloud/upload-now" -d '' > /dev/null 2>&1 || return 1

  # Hard cap = 30 min total. Stall detection = no decrease in pending for
  # 2 min ⇒ give up (cloud is rejecting, WiFi is dead, etc — next cycle retries).
  local deadline=$(( $(date +%s) + 1800 ))
  local last_pending=$pending
  local stalled_for=0
  local last_logged=$pending

  while [ "$(date +%s)" -lt "$deadline" ]; do
    archive_run_command sleep 10 || return 125
    if ! status_json=$(curl -sf -m 5 "$api/api/cloud/status" 2>/dev/null); then
      log "Cloud upload: status check failed (WiFi/API issue); retrying"
      continue
    fi
    pending=$(echo "$status_json" | grep -o '"pendingRouteCount":[0-9]*' | cut -d: -f2)
    [[ "$pending" =~ ^[0-9]+$ ]] || return 1

    if [ "$pending" -eq 0 ]; then
      log "Cloud upload: complete (all routes uploaded)"
      return 0
    fi

    if [ "$pending" -ge "$last_pending" ]; then
      stalled_for=$((stalled_for + 10))
      if [ "$stalled_for" -ge 120 ]; then
        local last_err
        last_err=$(echo "$status_json" | grep -o '"lastUploadError":"[^"]*"' | cut -d: -f2- | tr -d '"')
        log "Cloud upload: stalled at $pending pending for 2 min (lastError=${last_err:-none}); will retry next cycle"
        return 1
      fi
    else
      stalled_for=0
      last_pending=$pending
      # Log progress at most every ~25 routes to avoid spam.
      if [ $(( last_logged - pending )) -ge 25 ]; then
        log "Cloud upload: progress — $pending route(s) remaining"
        last_logged=$pending
      fi
    fi
  done

  log "Cloud upload: hit 30 min cap with $pending pending; will retry next cycle"
  return 1
}

function archive_wait_for_processor () {
  local status api="http://127.0.0.1:${SENTRYUSB_PORT:-80}"
  # The Rust processor checks the cycle request at safe boundaries. Wait
  # for its current transaction/export before unmounting its input/output.
  while true; do
    if status=$(curl -sf --max-time 5 "$api/api/drives/status"); then
      if echo "$status" | grep -q '"running":false' &&
         echo "$status" | grep -q '"archive_work_running":false'; then return 0; fi
    elif ! systemctl is-active --quiet sentryusb; then
      return 0
    fi
    sleep 1
  done
}

function archive_cancel_cleanup () {
  log "Archive cycle skipped by user; skipping footage cleanup and remaining stages"
  rm -f /mutable/archive_in_progress.json || true
  if ! printf 'deferred until successful archive\n' > "$CAM_CLEANUP_DEFERRED"; then
    log "ERROR: could not persist cam cleanup deferral"
  fi
  sync -f "${CAM_CLEANUP_DEFERRED%/*}" >> "$LOG_FILE" 2>&1 || true
  archive_wait_for_processor
  clear_archive_status
  if ! usb_gadget_is_active; then
    ensure_usb_drives_connected || log "ERROR: failed to restore USB gadget after cancellation"
  fi
  /root/bin/disconnect-archive.sh 2>> "$LOG_FILE" || true
  /root/bin/send-live-activity end cancelled || true
}

function archive_clips () {
  log "Archiving..."

  # Track whether the clip-archiving part of this cycle succeeded, so the
  # caller (run_archive_cycle) can pace another transfer attempt. Failures
  # in the post-archive extras (music, processing, cloud) don't count —
  # only clips left behind by a broken uplink justify a rapid retry.
  local clips_ok=true
  # Set by archive_teslacam_clips when it starts this cycle's Live Activity;
  # post-archive-process.sh sends processing progress only for that one.
  export LIVE_ACTIVITY_ACTIVE=0
  # This cycle's verification results, for the status file on the share.
  ARCHIVE_VERIFY_RAN=0 ARCHIVE_VERIFY_STOPPED="" ARCHIVE_VERIFY_MATCHED=0
  ARCHIVE_VERIFY_RESEND=0 ARCHIVE_VERIFY_NOSOURCE=0 ARCHIVE_VERIFY_LEFT=0 ARCHIVE_VERIFY_CONVERTED=0

  if ! archive_run_command /root/bin/connect-archive.sh
  then
    if archive_cancel_requested; then archive_cancel_cleanup; return 125; fi
    log "ERROR: connect-archive.sh failed (exit $?), skipping archive step."
    log "  ARCHIVE_SYSTEM=${ARCHIVE_SYSTEM:-unset} ARCHIVE_SERVER=${ARCHIVE_SERVER:-unset}"
    if [ "${ARCHIVE_SYSTEM:-}" = "cifs" ]; then
      log "  ARCHIVE_MOUNT=${ARCHIVE_MOUNT:-unset} SHARE_NAME=${SHARE_NAME:-unset}"
    fi
    /root/bin/disconnect-archive.sh 2>> "$LOG_FILE" || true
    return 1
  fi

  if ! has_cam_disk
  then
    log "Skipping archiving (no cam disk)"
  elif archive_teslacam_clips
  then
    log "Finished archiving."
  else
    log "Archiving failed."
    clips_ok=false
  fi

  if archive_cancel_requested; then archive_cancel_cleanup; return 125; fi

  # If the user drove away during archive, the gadget is still presented to
  # the car (clean_cam_mount was skipped inside archive_teslacam_clips). Skip
  # all post-archive cleanup — every step below cycles the USB gadget, which
  # would interrupt the car's recording. The skipped work (music sync, drive-
  # map, cloud upload) will run on the next archive cycle when the user is
  # parked at home again.
  if ! archive_is_reachable; then
    log "Archive became unreachable during clip archiving (user likely drove away); skipping music sync and post-archive processing to keep USB drive stable for the car"
    touch /tmp/flag_post_archive
    clear_archive_status
    /root/bin/disconnect-archive.sh 2>> "$LOG_FILE" || true
    # Processing is skipped, so end the Live Activity here (same pairing
    # rule as the final end below).
    if [ "${ARCHIVE_RETRY_ATTEMPT:-0}" != "1" ]; then
      /root/bin/send-live-activity end complete || true
    fi
    # In Travel Mode this is the uplink dropping mid-archive (the "Starlink
    # under a bridge" case) — report failure so fast retry can kick in.
    return 1
  fi

  if { timeout 5 [ -d "${MUSIC_ARCHIVE_MOUNT:-}" -a -d "$MUSIC_MOUNT" ]; } || \
     { [ "${ARCHIVE_SYSTEM:-none}" = "rsync" ] && [ -n "${MUSIC_SHARE_NAME:-}" ] && [ -f /backingfiles/music_disk.bin ]; }
  then
    if travel_mode_active; then
      log "Travel Mode: skipping music sync (would disconnect the USB gadget from the car)"
    elif [ "$clips_ok" = false ]; then
      # The link that just failed the clip transfer would likely fail music
      # too, with the car's drive disconnected the whole time. Music syncs
      # on the next successful cycle.
      ARCHIVE_ALL_STAGES_OK=0
      log "Skipping music sync after failed clip archive; keeping the car's USB drive connected"
    else
      log "Copying music..."
      if copy_music_files
      then
        log "Finished copying music."
      else
        log "ERROR: copy_music_files failed (exit $?)"
      fi
    fi
  else
    if [ -n "${MUSIC_SHARE_NAME:-}" ] && [ -f /backingfiles/music_disk.bin ]; then ARCHIVE_ALL_STAGES_OK=0; fi
    log "Music archive not configured or unreachable (MUSIC_ARCHIVE_MOUNT=${MUSIC_ARCHIVE_MOUNT:-unset})"
  fi

  if archive_cancel_requested; then archive_cancel_cleanup; return 125; fi

  touch /tmp/flag_post_archive  #Set post-archive flag for optional temperature logging
  clear_archive_status
  # Reconnect only when cleanup/music left the gadget down or host media is
  # dirty. Processing reads local snapshots — leave an active gadget alone.
  if travel_mode_active; then
    if ! usb_gadget_is_active; then
      log "Travel Mode: USB gadget inactive; restoring presentation once"
      ensure_usb_drives_connected || log "ERROR: failed to restore USB gadget in Travel Mode"
    else
      log "Travel Mode: USB gadget already active; skipping reconnect"
    fi
  elif [ "$clips_ok" = false ]; then
    # A retry follows within minutes: don't cycle a working drive for
    # pending user media; only restore one that is down.
    if ! usb_gadget_is_active; then
      log "Archive failed: USB gadget inactive; restoring presentation once"
      ensure_usb_drives_connected || log "ERROR: failed to restore USB gadget after failed archive"
    fi
    archive_transport_recover
  else
    ensure_usb_drives_connected || log "ERROR: failed to ensure USB gadget after archive"
  fi
  # Checksum the clips just archived against the archive server (and, if
  # turned on, release snapshots verified twice). Placed after the USB drive
  # is back with the car, so checking never keeps the car without its drive.
  # Skipped after a failed clip transfer (the link just failed) and in
  # Travel Mode (reading copies back over a mobile link costs data); the
  # queue is durable, so those clips are checked on the next good cycle.
  if [ "$clips_ok" = true ] && ! travel_mode_active; then
    verify_archived_clips || { ARCHIVE_ALL_STAGES_OK=0; log "Archive verification stopped before finishing; the rest is checked next cycle"; }
    if archive_cancel_requested; then archive_cancel_cleanup; return 125; fi
  fi
  # Tell tools reading the share what this cycle did, failures included.
  if archive_is_reachable; then
    ARCHIVE_SHARE_STATE=idle
    write_share_status || log "WARNING: could not write $SHARE_STATUS_DIR/$SHARE_STATUS_NAME to the archive"
  fi
  archive_run_command /root/bin/post-archive-process.sh || { ARCHIVE_ALL_STAGES_OK=0; log "Post-archive processing stopped (exit $?)"; }
  if archive_cancel_requested; then archive_cancel_cleanup; return 125; fi
  cloud_upload_step || ARCHIVE_ALL_STAGES_OK=0
  if archive_cancel_requested; then archive_cancel_cleanup; return 125; fi
  # Same live-activity pairing rule as in archive_teslacam_clips: retry
  # attempts never sent a start, so don't send an unmatched end.
  if [ "${ARCHIVE_RETRY_ATTEMPT:-0}" != "1" ]; then
    /root/bin/send-live-activity end complete || true
  fi
  if ! archive_is_reachable; then
    ARCHIVE_ALL_STAGES_OK=0
    log "Archive became unreachable during drive processing, user likely drove away"
  fi
  /root/bin/disconnect-archive.sh 2>> "$LOG_FILE" || ARCHIVE_ALL_STAGES_OK=0

  [ "$clips_ok" = "true" ]
}

# Write system time → RTC via /dev/rtc0 ioctl (Pi 5 only)
function rtc_sync_systohc () {
  [ -e /dev/rtc0 ] || return 1
  python3 -c "
import fcntl, struct, time
t = time.gmtime()
data = struct.pack('9i', t.tm_sec, t.tm_min, t.tm_hour, t.tm_mday, t.tm_mon-1, t.tm_year-1900, t.tm_wday, t.tm_yday, -1)
with open('/dev/rtc0', 'wb') as f:
    fcntl.ioctl(f.fileno(), 0x4024700a, data)
" 2>/dev/null
}

# Clock checkpoint for Pis without a battery-backed RTC. At boot,
# fake-hwclock sets the clock from /etc/fake-hwclock.data (a link to
# /mutable/etc/fake-hwclock.data), but it only saves that file at a clean
# shutdown or from an hourly cron job. This Pi loses power instead of
# shutting down, and minimal images have no cron, so the file kept a
# weeks-old time. Every boot then started weeks in the past until Wi-Fi time
# sync, logs were misdated, and a snapshot taken before the sync was stamped
# with the old date, sorting as the oldest snapshot. Saving the time after
# each sync, each snapshot and every hour keeps a boot at most about an hour
# behind, and never earlier than the newest snapshot.
FAKE_HWCLOCK_DATA=/etc/fake-hwclock.data

function save_clock_checkpoint () {
  # A battery-backed RTC (RTC_BATTERY_ENABLED, Pi 5) keeps time itself.
  [ "${RTC_BATTERY_ENABLED:-false}" != "true" ] || return 0
  local file now saved
  file=$(readlink -f "$FAKE_HWCLOCK_DATA" 2>/dev/null) || return 0
  [ -n "$file" ] && [ -d "${file%/*}" ] || return 0
  now=$(date -u +%s)
  # Only ever move it forward: before time sync the clock may still hold
  # the old time, and writing that back would undo a newer checkpoint.
  if [ -s "$file" ]; then
    saved=$(date -u -d "$(head -1 "$file")" +%s 2>/dev/null || echo 0)
    [ "$now" -gt "$saved" ] || return 0
  fi
  # fake-hwclock's own format: UTC "YYYY-MM-DD HH:MM:SS".
  date -u '+%Y-%m-%d %H:%M:%S' > "$file.new" 2>/dev/null && mv -f "$file.new" "$file" 2>/dev/null
}

function set_time () {
  log "Trying to set time..."
  local -r uptime_start=$(awk '{print $1}' /proc/uptime)
  local -r clocktime_start=$(date +%s.%N)
  for _ in {1..5}
  do
    if ntpdig -S time.google.com || sntp -S 129.6.15.28
    # Fall back to NIST time server if DNS resolution fails (DNS over TLS & Cert is invalid because of wrong time)
    then
      local -r uptime_end=$(awk '{print $1}' /proc/uptime)
      local -r clocktime_end=$(date +%s.%N)
      log "$(awk "BEGIN {printf \"Time adjusted by %f seconds after %f seconds\", $clocktime_end-$clocktime_start, $uptime_end-$uptime_start}")"
      save_clock_checkpoint || true
      return
    fi
    log "sntp failed, retrying..."
    sleep 2
  done
  log "Failed to set time"
}

function timesyncloop {
  echo -n timesyncloop > /proc/self/comm
  while true
  do
    if ping -c 1 -W 3 time.google.com &>/dev/null || ping -c 1 -W 3 129.6.15.28 &>/dev/null; then
      set_time
      # Sync NTP-corrected time to RTC battery (Pi never shuts down gracefully)
      if [ "${RTC_BATTERY_ENABLED:-false}" = "true" ] && isPi5; then
        rtc_sync_systohc || true
      fi
    fi
    # Hourly checkpoint even without a network: the clock still runs
    # forward from wherever it started.
    save_clock_checkpoint || true
    sleep "${TIME_SYNC_INTERVAL:-3600}"
  done
}

# Seconds since boot (CLOCK_BOOTTIME), so NTP/RTC steps can't shift the
# snapshot schedule.
function uptime_seconds {
  local up
  read -r up _ < /proc/uptime
  echo "${up%%.*}"
}

# The car keeps about an hour of RecentClips and deletes older minutes
# continuously, and SNAPSHOT_INTERVAL is meant to be how far apart two
# snapshots are (default 58 min, a 2-minute margin). This loop used to sleep
# the full interval AFTER the previous snapshot finished and then wait up to
# 90 s for an idle gap, so the real spacing was interval + idle wait + the
# previous run's fsck/scan/link time. While driving or in Sentry the car never
# idles, so the wait always burned its 90 s, and with the fsck on top the
# spacing regularly passed 60 min: the car deleted the oldest minutes before
# any snapshot caught them, leaving 1-3 minute holes in the day's footage.
# Schedule each snapshot from when the previous one STARTED, and skip the idle
# wait: a mid-write copy is safe (make_snapshot fscks the copy), as the
# boot-time snapshot already relies on.
# A snapshot gap: the newest snapshot is older than SNAPSHOT_GAP_ALERT_SECONDS
# (default 3600, the car's ~1 h RecentClips buffer). snapshotloop calls this
# after every scheduled run. The schedule itself never slips by more than
# one run; a gap means runs produced no snapshot. It logs why, once per gap
# (keyed by the newest snapshot's time), and sends one push alert per gap:
#  - the car wrote to its drive after the newest snapshot, yet no snapshot
#    kept it (runs failed or were discarded): footage may be lost;
#  - the drive isn't presented to the car, or the USB link to the car is
#    down: the car can't record to it at all;
#  - otherwise the car simply hasn't written to the drive (it isn't
#    recording, e.g. parked with Sentry Mode off), so nothing was missed.
SNAPSHOT_GAP_MARKER=/mutable/snapshot_gap_reported

# Unix time of the newest snapshot with a committed TOC (when it was taken),
# or nothing when there is none.
function newest_snapshot_unix () {
  local toc
  toc=$(LC_ALL=C find /backingfiles/snapshots -mindepth 2 -maxdepth 2 -path '*/snap-[0-9]*/snap.bin.toc' 2>/dev/null |
    LC_ALL=C sort | tail -1)
  [ -n "$toc" ] || return 1
  stat -c %Y "$toc"
}

# The USB link state to the car ("configured" when the car is using the
# drive), for the gap check.
function snapshot_gap_udc_state () {
  cat /sys/class/udc/*/state 2>/dev/null | head -1
}

function snapshot_gap_check () {
  local last now gap limit cam udc reason level=WARNING alert=false
  last=$(newest_snapshot_unix) || return 0
  now=$(date +%s)
  limit=${SNAPSHOT_GAP_ALERT_SECONDS:-3600}
  gap=$((now - last))
  if [ "$gap" -le "$limit" ]
  then
    rm -f "$SNAPSHOT_GAP_MARKER"
    return 0
  fi
  # Once per gap (the newest snapshot's time identifies it).
  [ "$(cat "$SNAPSHOT_GAP_MARKER" 2>/dev/null)" != "$last" ] || return 0
  cam=$(stat -c %Y /backingfiles/cam_disk.bin 2>/dev/null || echo 0)
  udc=$(snapshot_gap_udc_state)
  local at_last at_cam
  at_last=$(date -d "@$last" '+%H:%M' 2>/dev/null || echo "$last")
  at_cam=$(date -d "@$cam" '+%H:%M' 2>/dev/null || echo "$cam")
  if [ "$cam" -gt $((last + 120)) ]
  then
    reason="the car wrote to its drive at $at_cam, after the last snapshot, but no snapshot since has kept it"
    level=ERROR alert=true
  elif ! usb_gadget_is_active
  then
    reason="the USB drive isn't presented to the car, so the car can't record to it"
    level=ERROR alert=true
  elif [ -n "$udc" ] && [ "$udc" != configured ]
  then
    reason="the car isn't using the USB drive (USB state '$udc'); it last wrote at $at_cam"
    alert=true
  else
    reason="the car hasn't written to its drive since $at_cam, so there was nothing new to keep (it isn't recording)"
  fi
  local awake=unknown
  if car_is_awake_via_ble; then awake=yes; fi
  log "$level: snapshot gap: no snapshot for $((gap / 60)) min (last at $at_last): $reason; car awake over BLE: $awake"
  echo "$last" > "$SNAPSHOT_GAP_MARKER" 2>/dev/null || true
  if [ "$alert" = true ] || [ "$awake" = yes ]
  then
    /root/bin/send-push-message "${NOTIFICATION_TITLE:-SentryUSB}:" \
      "No snapshot for $((gap / 60)) min (last at $at_last): $reason." \
      warning snapshot_gap "No snapshot for over an hour. Recent footage may not be kept." 2>/dev/null ||
      log "failed to send snapshot gap notification"
  fi
}

# When the next scheduled snapshot is due (unix time), for the web UI.
NEXT_SNAPSHOT_FILE=/tmp/sentryusb-next-snapshot

function snapshotloop {
  echo -n snapshotloop > /proc/self/comm
  local interval="${SNAPSHOT_INTERVAL:-3480}"
  [[ "$interval" =~ ^[0-9]+$ ]] && [ "$interval" -gt 0 ] || interval=3480
  local next=$(( $(uptime_seconds) + interval ))
  local now late
  while true
  do
    now=$(uptime_seconds)
    if [ "$now" -lt "$next" ]
    then
      sleep $(( next - now ))
    else
      late=$(( now - next ))
      [ "$late" -lt 60 ] || log "snapshot is ${late}s behind schedule (previous snapshot ran long)"
    fi
    next=$(( $(uptime_seconds) + interval ))
    # Tell the web UI when the next scheduled snapshot is due (wall-clock
    # unix time, for the Snapshots page's Live row). Best effort.
    if echo $(( $(date +%s) + interval )) > "$NEXT_SNAPSHOT_FILE.new" 2>/dev/null
    then
      mv -f "$NEXT_SNAPSHOT_FILE.new" "$NEXT_SNAPSHOT_FILE" 2>/dev/null || true
    fi
    # A failed snapshot is already logged and keeps its image for recovery;
    # under errexit it must not take down this worker and its siblings.
    /root/bin/make_snapshot.sh || log "ERROR: make_snapshot.sh failed (exit $?)"
    # Say so (once per gap) when the newest snapshot is now over an hour old.
    snapshot_gap_check || true
    # The next boot's clock must not start before this snapshot.
    save_clock_checkpoint || true
    # Hash the new clips now, in the background at idle priority, so the
    # Pi's half of the archive check is done before the clips are uploaded.
    precompute_local_hashes &
    # Incrementally process new clips after each snapshot.
    # The processor skips already-processed files, so this is lightweight.
    # Runs in a subshell so the snapshot loop isn't blocked.
    if [ "${DRIVE_MAP_WHILE_AWAY:-false}" = "true" ]; then
      (
        SENTRYUSB_PORT="${SENTRYUSB_PORT:-80}"
        API_URL="http://127.0.0.1:${SENTRYUSB_PORT}"
        if curl -sf "${API_URL}/api/drives/status" > /dev/null 2>&1; then
          curl -sf -X POST "${API_URL}/api/drives/process?post_archive=1" \
            -H "Content-Type: application/json" \
            -d '{"clips_dir": "/mutable/TeslaCam/RecentClips", "throttle_ms": 30}' \
            > /dev/null 2>&1 || true
        fi
      ) &
    fi
  done
}

# True when the car has been reachable over BLE recently. Reads the
# telemetry daemon's once-a-minute heartbeat in /mutable/sentryusb-ble.log
# (state_age = seconds since the last successful BLE state sample). The
# heartbeat's own car= label is derived from cam_disk.bin mtime — the very
# signal the watchdog is judging — so it must NOT be used here (circular);
# state_age comes from the telemetry DB and is independent.
# No sqlite3 CLI exists on the Pi, hence log parsing instead of a DB query.
function car_is_awake_via_ble () {
  local f=/mutable/sentryusb-ble.log
  [ -f "$f" ] || return 1
  local now mt state_age
  now=$(date +%s)
  mt=$(stat --format=%Y "$f" 2>/dev/null) || return 1
  # Heartbeat itself stale => telemetry daemon down => awake state unknown.
  # Fail safe: report not-awake so the watchdog never cycles blind.
  (( now - mt < 180 )) || return 1
  state_age=$(tail -c 400 "$f" 2>/dev/null | tail -n 1 | sed -n 's/.*state_age=\([0-9]\{1,\}\)s.*/\1/p')
  [ -n "$state_age" ] && (( state_age <= 120 ))
}

# Snapshot everything a post-mortem needs BEFORE recovery destroys it.
# journald is volatile on these installs — this file on /mutable is the
# only place the kernel's view of a wedged gadget survives a reboot.
function dump_gadget_stall_evidence () {
  local out="$1"
  {
    echo "===== gadget stall evidence $(date) ====="
    echo "--- /sys/class/udc state ---"
    for u in /sys/class/udc/*/state; do echo "$u: $(cat "$u" 2>/dev/null)"; done
    echo "--- gadget configfs ---"
    echo "UDC: $(cat /sys/kernel/config/usb_gadget/sentryusb/UDC 2>/dev/null)"
    for l in /sys/kernel/config/usb_gadget/sentryusb/functions/mass_storage.0/lun.*/file; do
      echo "$l: $(cat "$l" 2>/dev/null)"
    done
    echo "--- cam_disk.bin ---"
    stat /backingfiles/cam_disk.bin 2>/dev/null
    echo "--- file-storage kernel thread io ---"
    for p in $(pgrep -f file-storage 2>/dev/null); do
      echo "pid $p:"; cat "/proc/$p/io" 2>/dev/null
    done
    echo "--- dmesg tail ---"
    dmesg | tail -150
  } > "$out" 2>&1 || true
}

# Detect the drive dying under the car and re-present it. On 2026-07-08 the
# car stopped writing mid-drive while configfs still reported the gadget
# bound; Tesla never retries a dropped drive on its own, so the outage
# lasted until the car power-cycled the USB port (~6 min). A disable/enable
# cycle re-enumerates the drive like a fresh plug and the car re-mounts it
# within seconds.
#
# Triggers (gadget must be bound, car must be awake via BLE):
#   1. UDC link state leaves "configured" and stays degraded >= 60s.
#   2. Car writes to cam_disk.bin were flowing this boot, then stopped
#      for >= GADGET_STALL_SECS (default 180) — and the archive is
#      UNREACHABLE. The reachability gate matters: at home, "car stopped
#      writing while awake" is what every normal arrival looks like once
#      the dashcam turns off, so trigger 2 would fire a false cycle +
#      notification on every drive home. Away from home (the incident
#      scenario) that pattern really is a stall. A real at-home stall is
#      still covered by trigger 1 plus the next archive cycle's own
#      gadget re-present.
# A car that is awake but legitimately not recording away from home can
# still trip trigger 2 once; the cycle is harmless then (drive idle,
# ~15s blip) and the rate limit keeps it from repeating.
function gadget_stall_watchdog () {
  echo -n gadgetwatchdog > /proc/self/comm
  local cam=/backingfiles/cam_disk.bin
  local stall_secs="${GADGET_STALL_SECS:-180}"
  # One cooldown between recovery cycles plus a hard per-boot cap: a real
  # stall needs one cycle; anything repeating is a deeper problem where
  # blind cycling just churns the car.
  local recovery_cooldown=600
  local max_recoveries=3
  local fresh_seen=0
  local udc_bad_since=0
  local last_recovery=0
  local recoveries=0
  local limit_logged=0

  while true
  do
    sleep "${GADGET_WATCHDOG_INTERVAL:-30}"

    # Only act while we intend to present the drive. During archiveloop's
    # own gadget-down windows (music sync, boot, lock-chime cycle) this is
    # false and the watchdog idles.
    if ! usb_gadget_is_active
    then
      fresh_seen=0
      udc_bad_since=0
      continue
    fi
    [ -f "$cam" ] || continue

    local now mtime age reason=""
    now=$(date +%s)
    mtime=$(stat --format=%Y "$cam" 2>/dev/null) || continue
    age=$(( now - mtime ))
    (( age < 90 )) && fresh_seen=1

    local udc_state
    udc_state=$(cat /sys/class/udc/*/state 2>/dev/null | head -1)
    if [ "$udc_state" = "configured" ] || [ -z "$udc_state" ]
    then
      udc_bad_since=0
    elif (( udc_bad_since == 0 ))
    then
      udc_bad_since=$now
    fi

    if [ -e /tmp/gadget_watchdog_force ]
    then
      rm -f /tmp/gadget_watchdog_force
      reason="forced via /tmp/gadget_watchdog_force (test hook)"
    elif ! car_is_awake_via_ble
    then
      continue
    elif (( udc_bad_since > 0 && now - udc_bad_since >= 60 ))
    then
      reason="UDC state '$udc_state' for $(( now - udc_bad_since ))s with recent BLE activity; the car may be asleep"
    elif (( fresh_seen == 1 && age >= stall_secs ))
    then
      # Home suppression for the write-stall trigger (see function header).
      # Reset fresh_seen so this doesn't re-probe reachability every 30s
      # until the car actually writes again.
      if archive_is_reachable
      then
        fresh_seen=0
        continue
      fi
      reason="car stopped writing for ${age}s while awake and away from home"
    else
      continue
    fi

    if (( recoveries >= max_recoveries ))
    then
      if (( limit_logged == 0 ))
      then
        limit_logged=1
        log "Gadget stall watchdog: $reason — but recovery limit reached (${max_recoveries}/boot), not cycling again this boot"
      fi
      continue
    fi
    if (( last_recovery > 0 && now - last_recovery < recovery_cooldown ))
    then
      continue
    fi

    local evidence="/mutable/gadget_stall_$(date +%Y%m%d_%H%M%S).log"
    log "Gadget stall watchdog: $reason — capturing evidence to $evidence, then re-presenting drive"
    dump_gadget_stall_evidence "$evidence"

    # Subshell exits 0 only when a cycle was actually attempted; a skip
    # (lock busy, state changed under the lock) exits 3 so the counters
    # and the push notification below don't fire for a non-event.
    if (
      # Bounded wait: if a gadget cycle elsewhere is wedged in an
      # uninterruptible configfs write (the very failure class this
      # watchdog targets), a plain flock would block forever and take
      # the watchdog down with it. Skip and retry next loop instead.
      if ! flock -w 60 209
      then
        log "Gadget stall watchdog: gadget lock busy for 60s, skipping recovery attempt"
        exit 3
      fi
      # Re-verify under the lock — the main loop may have legitimately
      # taken the gadget down between our decision and acquiring the lock.
      if usb_gadget_is_active \
         && ! findmnt --mountpoint "$CAM_MOUNT" > /dev/null \
         && ! findmnt --mountpoint "$MUSIC_MOUNT" > /dev/null
      then
        /root/bin/disable_gadget.sh || log "Gadget stall watchdog: disable_gadget failed (exit $?)"
        sleep 2
        rm -f "$EXFAT_RECLAIM_STAMP"
        if /root/bin/enable_gadget.sh
        then
          log "Gadget stall watchdog: drive re-presented to the car"
        else
          log "Gadget stall watchdog: ERROR enable_gadget failed (exit $?)"
        fi
      else
        log "Gadget stall watchdog: state changed before recovery could run, skipping cycle"
        exit 3
      fi
    ) 209>"$GADGET_CYCLE_LOCK"
    then
      /root/bin/send-push-message "$NOTIFICATION_TITLE:" \
        "USB connection may be stalled ($reason). Re-presented the drive to the car. Evidence: $evidence" \
        warning gadget_stall "USB connection unavailable. The car may be asleep. Reconnection attempted." 2>/dev/null || true
      last_recovery=$now
      recoveries=$((recoveries + 1))
      fresh_seen=0
      udc_bad_since=0
    fi
  done
}

# Mirror the kernel log to persistent storage. journald is volatile here,
# so without this a reboot destroys the only record of dwc2/mass-storage
# trouble (exactly what happened on 2026-07-08).
function kmsgmirror {
  echo -n kmsgmirror > /proc/self/comm
  local out=/mutable/kernel.log
  local n=0
  {
    echo "===== boot $(date) ====="
    dmesg --time-format iso 2>/dev/null || dmesg 2>/dev/null || true
  } >> "$out" 2>/dev/null || true
  # Trim right after the boot dump too — on a reboot-heavy box with a
  # quiet kernel the follow loop below may not see enough lines to ever
  # hit its size check, and repeated boot dumps would grow unbounded.
  if [[ "$(stat --format=%s "$out" 2>/dev/null)" -gt 2000000 ]] 2>/dev/null
  then
    tail -n 8000 "$out" > "${out}.2" 2>/dev/null && mv "${out}.2" "$out" 2>/dev/null || true
  fi
  { dmesg -W --time-format iso 2>/dev/null || dmesg -w 2>/dev/null; } | while IFS= read -r line
  do
    echo "$line" >> "$out" 2>/dev/null || true
    n=$((n + 1))
    if (( n % 200 == 0 )) && [[ "$(stat --format=%s "$out" 2>/dev/null)" -gt 2000000 ]] 2>/dev/null
    then
      tail -n 8000 "$out" > "${out}.2" 2>/dev/null && mv "${out}.2" "$out" 2>/dev/null || true
    fi
  done
}

function write_storage_cleanup_status () {
  printf '{"sampled_at":%s,"state":"%s"}\n' "$(date +%s)" "$1" > /run/sentryusb_storage_cleanup.json.tmp &&
    mv /run/sentryusb_storage_cleanup.json.tmp /run/sentryusb_storage_cleanup.json || true
}

function freespacemanager {
  echo -n freespacemanager > /proc/self/comm
  # 10G
  local reserve=10737418240
  local threepctoftotalspace
  threepctoftotalspace=$(eval "$(stat --file-system --format="echo \$((%b*%S/33))" /backingfiles/cam_disk.bin)")
  reserve=$((reserve+threepctoftotalspace))

  # Throttle marker for the storage-pressure push alert (once per 24h).
  local alert_marker=/run/sentryusb_storage_pressure_alerted
  local imutable ireserve ifree

  while true
  do
    # /mutable inode headroom threshold, mirroring manage_free_space.sh:
    # each retained clip costs a symlink inode in /mutable/TeslaCam, and
    # the inode table fills long before a multi-TB /backingfiles feels
    # block pressure (2026-08-19 field failure: 100% inode-full while
    # 71% of the bytes were free, ENOSPC on every ln/state write for a
    # day). max(20000, table/20) ≈ a week of links of recovery headroom.
    # Recomputed every cycle, not once at startup: /mutable can mount
    # after the service starts, and the rw requirement can change — on a
    # ro remount, releasing snapshots cannot delete their symlinks and
    # is pure footage loss, so the inode policy disarms.
    ireserve=0
    if findmnt -no OPTIONS --mountpoint /mutable 2>/dev/null | grep -qE '(^|,)rw(,|$)'
    then
      imutable=$(stat --file-system --format=%c /mutable 2>/dev/null || echo 0)
      if [ "$imutable" -gt 0 ]
      then
        ireserve=$((imutable / 20))
        if [ "$ireserve" -lt 20000 ]
        then
          ireserve=20000
        fi
        # INODE_RESERVE_CAP_APPLIED. Cap at a quarter of the table so the target is REACHABLE:
        # single-disk installs have ~11.8k inodes total on /mutable,
        # below the 20k floor, and shipped v3.20.0-v3.20.8 therefore
        # evicted every releasable snapshot toward a target no amount of
        # deletion could reach. Mirrors manage_free_space.sh/space.rs.
        if [ "$ireserve" -gt $((imutable / 4)) ]
        then
          ireserve=$((imutable / 4))
        fi
        if [ "$ireserve" -ge "$imutable" ]
        then
          ireserve=0
        fi
      fi
    fi

    local freespace pressure=""
    freespace=$(eval "$(stat --file-system --format="echo \$((%f*%S))" /backingfiles/cam_disk.bin)")
    if [ "$freespace" -lt "$reserve" ]
    then
      pressure="free space low"
    fi
    local inode_stalled=false
    if [ "$ireserve" -gt 0 ]
    then
      ifree=$(stat --file-system --format=%d /mutable 2>/dev/null || true)
      if [ -n "$ifree" ] && [ "$ifree" -le "$ireserve" ]
      then
        if [ -e /run/sentryusb_inode_stall ] &&            [ "$ifree" -le "$(cat /run/sentryusb_inode_stall 2>/dev/null || echo 0)" ]
        then
          # Cleanup already concluded it cannot relieve this, and free
          # inodes have not risen since. Re-invoking it every 30s would
          # only re-log the same suspension line forever (the shipped
          # build's 60-second treadmill in a different form), so stop
          # calling and let the throttled alert below carry the news.
          #
          # The freed-inode comparison is what lets recovery happen: once
          # counts rise above the latched value we DO invoke the manager
          # again, and it clears the latch. Skipping unconditionally
          # would strand the latch (and the red health row) until reboot,
          # because only the manager ever clears it.
          inode_stalled=true
        else
          pressure="${pressure:+$pressure, }clip index nearly full"
        fi
      fi
    fi
    if [ -n "$pressure" ] || [ "$inode_stalled" = "true" ]
    then
      local relieved=true
      write_storage_cleanup_status recovering
      if [ -n "$pressure" ]
      then
        /root/bin/manage_free_space.sh "$reserve" || relieved=false
      fi
      # Alert when eviction failed outright, or when a standing inode
      # stall latch means the manager is deliberately no longer trying
      # (it exits 0 in that state, but the pressure is still real).
      # Recording or archiving may stop soon and most users never open
      # the dashboard — tell them directly, at most once a day. The
      # 2026-08-19 inode exhaustion ran silently for a day precisely
      # because nothing pushed.
      if [ "$relieved" = "false" ] || [ -e /run/sentryusb_inode_stall ]
      then
        if [ ! -e "$alert_marker" ] || \
           [ "$(( $(date +%s) - $(stat --format=%Y "$alert_marker" 2>/dev/null || echo 0) ))" -ge 86400 ]
        then
          touch "$alert_marker" 2>/dev/null || true
          # `pressure` is empty when the only issue is an already-latched
          # clip index, so name that explicitly rather than sending
          # "Storage pressure ()".
          local what="${pressure:-clip index nearly full}"
          /root/bin/send-push-message "${NOTIFICATION_TITLE:-SentryUSB}:" \
            "Storage pressure ($what) could not be relieved automatically. Recording or archiving may stop — check the dashboard." \
            warning storage_pressure "Storage is nearly full. Recording or archiving may stop — check the dashboard." 2>/dev/null || true
        fi
      fi
      if [ "$relieved" = "false" ] || [ -e /run/sentryusb_inode_stall ]; then
        write_storage_cleanup_status failed
      else
        write_storage_cleanup_status recovered
      fi
      if [ "$relieved" = "false" ]
      then
        sleep 30
      fi
    else
      write_storage_cleanup_status healthy
    fi
    sleep 30
  done
}

function logrotator {
  echo -n logrotator > /proc/self/comm
  while true
  do
    if [ -s /var/log/nginx/access.log ]
    then
      mv -f /var/log/nginx/access.log /var/log/nginx/access.log.prev || true
    fi
    if [ -s /var/log/nginx/error.log ]
    then
      mv -f /var/log/nginx/error.log /var/log/nginx/error.log.prev || true
    fi
    if [ -e /var/run/nginx.pid ]
    then
      kill -USR1 "$(cat /var/run/nginx.pid)"
    fi
    sleep 1800
  done
}

# Six transport messages in ten seconds identify a burst, not a slow transfer.
function wifi_watchdog_init {
  WIFI_TRANSPORT_TIMES= WIFI_SUPPLICANT_TIMES=
  WIFI_LAST_FAULT=-1 WIFI_STORM_LATCHED=false
  WIFI_WATCHDOG_REASON=
}

function wifi_watchdog_observe {
  local line=$1 now=$2 kind= timestamps= recent= sample count=0 threshold
  case "$line" in
    *brcmfmac*CMD53*failed*|*brcmfmac*brcmf_sdio_txfail*|*brcmfmac*RXHEADER\ FAILED*|*brcmfmac*max\ tx\ seq\ number\ error*) kind=transport ;;
    *failed\ to\ enable\ fw\ supplicant*) kind=supplicant ;;
    *) return 1 ;;
  esac
  if [ "$WIFI_LAST_FAULT" -lt 0 ] || [ $((now - WIFI_LAST_FAULT)) -ge 60 ]; then
    WIFI_STORM_LATCHED=false
    WIFI_TRANSPORT_TIMES= WIFI_SUPPLICANT_TIMES=
  fi
  WIFI_LAST_FAULT=$now
  [ "$WIFI_STORM_LATCHED" = false ] || return 1
  if [ "$kind" = transport ]; then
    timestamps=$WIFI_TRANSPORT_TIMES threshold=6
  else
    timestamps=$WIFI_SUPPLICANT_TIMES threshold=2
  fi
  for sample in $timestamps; do
    if [ $((now - sample)) -le 10 ]; then
      recent="$recent $sample"
      count=$((count + 1))
    fi
  done
  recent="$recent $now"
  count=$((count + 1))
  if [ "$kind" = transport ]; then WIFI_TRANSPORT_TIMES=$recent; else WIFI_SUPPLICANT_TIMES=$recent; fi
  [ "$count" -ge "$threshold" ] || return 1
  WIFI_STORM_LATCHED=true
  # The 10-minute cooldown lives in wifi_recovery_guarded and starts only
  # when a reset really runs, so a storm skipped for Away Mode doesn't
  # suppress the next one.
  WIFI_WATCHDOG_REASON=$kind
  return 0
}

function wifi_watchdog_uptime {
  local seconds rest
  read -r seconds rest < /proc/uptime
  printf '%s\n' "${seconds%%.*}"
}

function wifi_watchdog_sanitize {
  sed -E '/[Ss][Ss][Ii][Dd]:/d; s/([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}/[MAC]/g; s/([0-9]{1,3}\.){3}[0-9]{1,3}/[IP]/g; s/([[:xdigit:]]{1,4}:){3,}[[:xdigit:]:%]+/[IP]/g; s/server [^ ]+ not responding/server [host] not responding/g'
}

function wifi_watchdog_capture {
  local destination=${WIFI_WATCHDOG_DIAGNOSTICS:-/mutable/wifi-health-latest.txt}
  (
    umask 077
    {
      printf 'Wi-Fi watchdog pre-recovery: %s\nReason: %s\n' "$(date -Is)" "$WIFI_WATCHDOG_REASON"
      printf '\nKernel transport events\n'
      timeout -k 1 3 dmesg 2>/dev/null | grep -E 'brcmfmac|mmc1|nfs: server|under-voltage|throttl' | tail -n 80 || true
      printf '\nWi-Fi link\n'
      timeout -k 1 3 iw dev wlan0 link || true
      timeout -k 1 3 iw dev wlan0 station dump || true
      timeout -k 1 2 iw dev wlan0 get power_save || true
      printf '\nInterface counters\n'
      timeout -k 1 2 ip -s link show dev wlan0 || true
      printf '\nNetworkManager state\n'
      timeout -k 1 2 nmcli -f GENERAL.STATE,GENERAL.REASON device show wlan0 || true
      printf '\nLoad and power\n'
      cat /proc/loadavg /proc/pressure/io 2>/dev/null || true
      timeout -k 1 2 vcgencmd get_throttled || true
    } 2>&1 | wifi_watchdog_sanitize | head -c 32768 > "${destination}.tmp" &&
      mv -f "${destination}.tmp" "$destination"
  ) || log 'Wi-Fi watchdog: could not save pre-recovery diagnostics'
}

# Away Mode's hotspot (ap0) runs on the same chip, and nothing here brings
# it back after a reset. A supplicant-only error doesn't prove the chip's bus
# failed, so it doesn't reset the chip in Travel Mode either. Checked before
# the cooldown starts and again right before the reset.
function wifi_watchdog_blocked {
  if [ -e "${WIFI_SYSFS:-/sys}/class/net/ap0" ] || away_mode_active; then
    log 'Wi-Fi watchdog: Away Mode hotspot is active; not resetting the Wi-Fi chip'
    return 0
  fi
  if [ "$WIFI_WATCHDOG_REASON" = supplicant ] && travel_mode_active; then
    log 'Wi-Fi watchdog: Travel Mode is on; not resetting the Wi-Fi chip for a supplicant error'
    return 0
  fi
  return 1
}

# wlan0's wiphy index. A chip reset frees the wiphy and the re-probe gets a
# new, higher one; a missing or unreadable value never counts as a change.
function wifi_watchdog_phy_index {
  local index
  index=$(cat "${WIFI_SYSFS:-/sys}/class/net/wlan0/phy80211/index" 2>/dev/null) || return 1
  [[ $index =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "$index"
}

# Ask brcmfmac to reset the chip through debugfs: its bus reset tears the
# device down and runs an MMC hardware reset, then the chip is probed again.
# No module is unloaded. Returns:
#   0  the chip came back as a new wiphy
#   1  wlan0 is there but this kernel has no reset control (nothing requested)
#   2  the reset was requested but no new wiphy appeared within 20 s
#   3  the request itself failed or timed out (its outcome is unknown)
#   4  wlan0's wiphy can't be identified (it may be mid-reset already)
# After 2, 3 or 4 a kernel reset may still be running, and unloading the
# driver under it can crash the kernel, so the caller must stop there.
function wifi_watchdog_chip_reset {
  local phy before after deadline node
  phy=$(cat "${WIFI_SYSFS:-/sys}/class/net/wlan0/phy80211/name" 2>/dev/null) || return 4
  [[ $phy =~ ^phy[0-9]+$ ]] || return 4
  before=$(wifi_watchdog_phy_index) || return 4
  node="${WIFI_DEBUGFS:-/sys/kernel/debug}/ieee80211/$phy/reset"
  [ -e "$node" ] || return 1
  timeout -k 1 5 tee "$node" <<< 1 >/dev/null 2>&1 || return 3
  deadline=$(( $(wifi_watchdog_uptime) + 20 ))
  while [ "$(wifi_watchdog_uptime)" -lt "$deadline" ]; do
    if after=$(wifi_watchdog_phy_index) && [ "$after" != "$before" ]; then
      return 0
    fi
    sleep 1
  done
  return 2
}

# Fallback for kernels without the reset control: unload and reload the
# driver, but only when no other module holds it. A vendor module
# (brcmfmac_cyw on Pi OS 6.18) is left alone: once it is unloaded, loading
# it again doesn't rebind the chip, so a failed brcmfmac unload after that
# would take Wi-Fi down until the next reboot. Those kernels have the reset
# control anyway. cfg80211 and brcmutil stay loaded.
function wifi_watchdog_module_reload {
  local modules=${WIFI_SYSFS:-/sys}/module holder
  if [ ! -d "$modules/brcmfmac" ]; then
    log 'Wi-Fi watchdog: brcmfmac is not a loaded module here; cannot reload it'
    return 1
  fi
  for holder in "$modules/brcmfmac/holders/"*; do
    [ -e "$holder" ] || continue
    log "Wi-Fi watchdog: module ${holder##*/} uses brcmfmac and this kernel has no chip reset control; not unloading the Wi-Fi driver"
    return 1
  done
  if ! timeout -k 2 8 rmmod brcmfmac >/dev/null 2>&1 || [ -d "$modules/brcmfmac" ]; then
    log 'Wi-Fi watchdog: could not unload brcmfmac; Wi-Fi driver left loaded'
    return 1
  fi
  if ! timeout -k 2 8 modprobe brcmfmac >/dev/null 2>&1 || [ ! -d "$modules/brcmfmac" ]; then
    log 'Wi-Fi watchdog: brcmfmac did not load again; Wi-Fi is down until the next reboot'
    return 1
  fi
}

function wifi_watchdog_verify_link {
  local deadline now gateway
  deadline=$(( $(wifi_watchdog_uptime) + 30 ))
  while true; do
    now=$(wifi_watchdog_uptime)
    [ "$now" -lt "$deadline" ] || return 1
    if timeout -k 1 2 iw dev wlan0 link 2>/dev/null | grep -q 'Connected to'; then
      gateway=$(timeout -k 1 2 ip -4 route show default dev wlan0 2>/dev/null | awk '$1 == "default" && $2 == "via" {print $3; exit}') || true
      if [ -n "$gateway" ] && timeout -k 1 2 ping -I wlan0 -c 1 -W 1 "$gateway" >/dev/null 2>&1; then
        return 0
      fi
    fi
    sleep 2
  done
}

# $1, when given, runs after the last mode check and right before the reset
# (it starts the cooldown); if it fails, nothing is reset.
function wifi_watchdog_recover {
  local reset_result=0 commit=${1:-}
  wifi_watchdog_capture
  if wifi_watchdog_blocked; then return 1; fi
  if [ -n "$commit" ] && ! "$commit"; then return 1; fi
  log "Wi-Fi watchdog: resetting the Wi-Fi chip after $WIFI_WATCHDOG_REASON error burst"
  wifi_watchdog_chip_reset || reset_result=$?
  case $reset_result in
    0) log 'Wi-Fi watchdog: the Wi-Fi chip reset and came back' ;;
    1)
      log 'Wi-Fi watchdog: no chip reset control on this kernel; reloading the Wi-Fi driver instead'
      if ! wifi_watchdog_module_reload; then
        log 'Wi-Fi watchdog: driver reload failed; no further attempt for this storm'
        return 1
      fi
      log 'Wi-Fi watchdog: Wi-Fi driver reloaded'
      ;;
    2)
      log 'Wi-Fi watchdog: chip reset requested, but the chip had not come back after 20 s; not unloading the driver while the reset may still be running; no further attempt for this storm'
      return 1
      ;;
    4)
      log 'Wi-Fi watchdog: wlan0 has no identifiable Wi-Fi device (it may be resetting); not touching the driver; no further attempt for this storm'
      return 1
      ;;
    *)
      log 'Wi-Fi watchdog: could not request a chip reset (outcome unknown); not unloading the driver; no further attempt for this storm'
      return 1
      ;;
  esac
  if wifi_watchdog_verify_link; then
    log 'Wi-Fi watchdog: reload completed, associated and gateway reachable; throughput and archive recovery unverified'
  else
    log 'Wi-Fi watchdog: reload completed but connection could not be verified; check diagnostics; no further attempt for this storm'
    return 1
  fi
}

function wifi_watchdog_attempt {
  wifi_recovery_guarded wifi_watchdog_recover_recorded
}

function wifi_watchdog_recover_recorded {
  # A skipped reset doesn't start the cooldown: it is recorded only after
  # the last mode check, right before the reset.
  if wifi_watchdog_blocked; then return 1; fi
  wifi_watchdog_recover wifi_recovery_record
}

# Start the shared cooldown. Called by a recovery action right before its
# real command, so an action that decides to skip doesn't block the other
# path for 10 minutes. Uses runtime/now from wifi_recovery_guarded.
function wifi_recovery_record {
  printf '%s\n' "$now" > "$runtime/sentryusb_wifi_watchdog.attempt" || {
    log 'Wi-Fi watchdog: could not record cooldown; recovery skipped'
    return 1
  }
}

# Run one Wi-Fi recovery action under the shared lock, the boot-scoped
# 10-minute cooldown and the firmware-operation guard. Both the kernel
# error watchdog and the archive transport check come through here, so
# they can never stack resets on each other. The action must call
# wifi_recovery_record before it changes anything.
function wifi_recovery_guarded {
  local runtime=${WIFI_WATCHDOG_RUNTIME_DIR:-/run}
  (
    umask 077
    flock -n 9 || { log 'Wi-Fi watchdog: another recovery is in progress'; exit 0; }
    local now last=-600 updated
    now=$(wifi_watchdog_uptime)
    if [ -r "$runtime/sentryusb_wifi_watchdog.attempt" ]; then
      read -r last < "$runtime/sentryusb_wifi_watchdog.attempt" || true
      [[ $last =~ ^[0-9]+$ ]] || last=-600
    fi
    if [ $((now - last)) -lt 600 ]; then
      log 'Wi-Fi recovery skipped: another recovery ran less than 10 minutes ago'
      exit 0
    fi
    if grep -q '"state"[[:space:]]*:[[:space:]]*"running"' /mutable/wifi-firmware/state.json 2>/dev/null; then
      updated=$(stat -c %Y /mutable/wifi-firmware/state.json 2>/dev/null) || updated=0
      if [ $(( $(date +%s) - updated )) -lt 900 ]; then
        log 'Wi-Fi watchdog: recovery skipped during firmware operation'
        exit 0
      fi
    fi
    "$@"
  ) 9>"$runtime/sentryusb_wifi_watchdog.lock"
}

# Bounded ping-only check of the rsync server. archive_is_reachable falls
# back to SSH, which is exactly what is suspect here and could hang.
function archive_server_pings {
  timeout -k 1 4 ping -q -c 1 -W 2 "$RSYNC_SERVER" >/dev/null 2>&1
}

# Fresh non-interactive SSH session to the rsync server, the same kind of
# session rsync uses. 0 = it answered; 124 = it timed out (the transport is
# suspect); anything else (auth, host key, refused, DNS) is not a Wi-Fi
# problem.
function archive_ssh_probe {
  local args=(-nT -o BatchMode=yes -o ConnectTimeout=5 -o ControlMaster=no -o ControlPath=none)
  if [ -n "${RSYNC_SSH_PORT:-}" ]; then args+=(-p "$RSYNC_SSH_PORT"); fi
  local err=${ARCHIVE_SSH_PROBE_ERR:-/tmp/archive-ssh-probe.err} rc=0
  LC_ALL=C timeout -k 2 15 ssh "${args[@]}" "$RSYNC_USER@$RSYNC_SERVER" true 2> "$err" || rc=$?
  # Same timeout forms as rsync_transport_timeout in rsync_archive/archive-clips.sh.
  if [ "$rc" = 255 ] &&
     LC_ALL=C grep -Eq '^(Timeout, server [^ ]+ not responding|Read from remote host [^ ]+: Connection timed out|ssh: connect to host [^ ]+ port [0-9]+: Connection timed out|Connection timed out during banner exchange|Connection to [^ ]+ port [0-9]+ timed out)' "$err" 2>/dev/null; then
    rc=124
  fi
  return "$rc"
}

# Prints "<interface> <connection uuid>" when the route to the archive
# server runs over a Wi-Fi station that NetworkManager manages. Ethernet,
# networkd/Armbian and anything ambiguous print nothing and return 1.
function archive_wifi_station {
  local addr dev state uuid
  command -v nmcli >/dev/null 2>&1 || return 1
  addr=$(getent ahostsv4 "$RSYNC_SERVER" 2>/dev/null | awk 'NR == 1 {print $1}') || true
  [ -n "$addr" ] || return 1
  dev=$(ip -4 -o route get "$addr" 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "dev") {print $(i + 1); exit}}') || true
  [ -n "$dev" ] && [ "$dev" != ap0 ] || return 1
  state=$(timeout -k 1 5 nmcli -t -f DEVICE,TYPE,STATE device status 2>/dev/null | awk -F: -v d="$dev" '$1 == d {print $2 ":" $3; exit}') || true
  [ "$state" = wifi:connected ] || return 1
  uuid=$(timeout -k 1 5 nmcli -g GENERAL.CON-UUID device show "$dev" 2>/dev/null) || true
  [[ $uuid =~ ^[0-9a-fA-F-]{36}$ ]] || return 1
  printf '%s %s\n' "$dev" "$uuid"
}

# Runs under wifi_recovery_guarded. One same-connection re-activation:
# NetworkManager tears the station down and associates again, which
# cleared the stuck traffic class on 2026-11-02 without a reboot. No
# explicit disconnect (that would block autoconnect if activation failed),
# no driver reload, and no AP changes.
function archive_wifi_reconnect {
  local iface=$1 uuid=$2 rc=0 started
  archive_wifi_reconnect_allowed "$iface" "$uuid" || return 0
  WIFI_WATCHDOG_REASON='archive transport stall' wifi_watchdog_capture
  # State can change while the probe and diagnostics run; check again
  # right before touching the radio.
  archive_wifi_reconnect_allowed "$iface" "$uuid" || return 0
  wifi_recovery_record || return 1
  log "Archive transport check: server answers ping but not SSH; reconnecting Wi-Fi on $iface"
  started=$(wifi_watchdog_uptime)
  timeout -k 2 35 nmcli --wait 30 connection up uuid "$uuid" ifname "$iface" >> "$LOG_FILE" 2>&1 || rc=$?
  log "Archive transport check: Wi-Fi reconnect finished (exit $rc) after $(( $(wifi_watchdog_uptime) - started ))s"
  if iw dev ap0 info >/dev/null 2>&1 || away_mode_active; then
    log 'Archive transport check: Away Mode started during the reconnect; no further Wi-Fi action'
    return 0
  fi
  if archive_ssh_probe; then
    log 'Archive transport check: SSH answers again; archive throughput unverified until the retry'
  else
    log 'Archive transport check: SSH still not answering after the Wi-Fi reconnect'
  fi
}

function archive_wifi_reconnect_allowed {
  local iface=$1 uuid=$2 current
  # Slow checks first (a few seconds each), quick state checks last, so a
  # cancel or mode change during them still stops the reconnect.
  if ! archive_server_pings; then
    log 'Archive transport check: server no longer answers ping; not reconnecting Wi-Fi'
    return 1
  fi
  current=$(timeout -k 1 5 nmcli -g GENERAL.CON-UUID device show "$iface" 2>/dev/null) || true
  if [ "$current" != "$uuid" ]; then
    log "Archive transport check: $iface changed connection; not reconnecting Wi-Fi"
    return 1
  fi
  if archive_cancel_requested || travel_mode_active; then
    log 'Archive transport check: archive cancelled or Travel Mode started; not reconnecting Wi-Fi'
    return 1
  fi
  if ! usb_gadget_is_active; then
    log 'Archive transport check: the USB drive is not presented to the car; not reconnecting Wi-Fi'
    return 1
  fi
  if iw dev ap0 info >/dev/null 2>&1 || away_mode_active; then
    log 'Archive transport check: Away Mode hotspot is active; not reconnecting Wi-Fi'
    return 1
  fi
}

# After an rsync clip transfer ended on a connection timeout (exit 75):
# tell a stuck Wi-Fi link apart from a slow or stuck server, and reconnect
# Wi-Fi only for the former. The failed cycle stays failed; the usual retry
# pacing runs the next transfer.
function archive_transport_recover {
  [ "${ARCHIVE_RSYNC_TIMEOUT:-0}" = 1 ] || return 0
  [ "${ARCHIVE_SYSTEM:-}" = rsync ] || return 0
  local rc=0 station
  if archive_cancel_requested || travel_mode_active; then return 0; fi
  if [ -n "${RSYNC_RSH:-}" ]; then
    # The probe can't reproduce a custom remote shell's connection.
    log 'Archive transport check skipped: custom RSYNC_RSH in use'
    return 0
  fi
  if ! usb_gadget_is_active; then
    log 'Archive transport check skipped: the USB drive is not presented to the car'
    return 0
  fi
  if ! archive_server_pings; then
    log 'Archive transport check skipped: server does not answer ping'
    return 0
  fi
  archive_ssh_probe || rc=$?
  case "$rc" in
    0)
      log 'Archive transport check: SSH answers; the stall was on the server side, not resetting Wi-Fi'
      return 0 ;;
    124) ;;
    *)
      log "Archive transport check: SSH failed with exit $rc (not a timeout); not resetting Wi-Fi"
      return 0 ;;
  esac
  if ! station=$(archive_wifi_station); then
    log 'Archive transport check: SSH timed out, but the route is not a NetworkManager Wi-Fi station; not resetting Wi-Fi'
    return 0
  fi
  wifi_recovery_guarded archive_wifi_reconnect ${station% *} ${station#* } || true
}

function wifichecker {
  echo -n wifichecker > /proc/self/comm
  wifi_watchdog_init
  # Only new kernel messages: a service restart must not replay an old storm.
  dmesg -W | {
    local line event_time
    while read -r line; do
      if [[ $line =~ ^\[[[:space:]]*([0-9]+)\. ]]; then
        event_time=${BASH_REMATCH[1]}
      else
        event_time=$(wifi_watchdog_uptime)
      fi
      if wifi_watchdog_observe "$line" "$event_time"; then
        wifi_watchdog_attempt || true
      fi
    done
    log 'Wi-Fi watchdog: kernel event stream ended; monitoring stopped'
  }
}

function set_sys_param() {
  local -r parampath="$1"
  local -r var="$2"
  local -r defaultval="$3"

  local -r val=${!var:-$defaultval}
  if [[ ${val} = "default" ]]
  then
    log "not setting $parampath"
  else
    echo "$val" > "$parampath" || true
  fi
}

export -f ensure_mountpoint_is_mounted
export -f retry
export -f ensure_mountpoint_is_mounted_with_retry
export -f log

echo "==============================================" >> "$LOG_FILE"
log "Starting archiveloop at $(awk '{print $1}' /proc/uptime) seconds uptime..."

# One-line boot forensics: distinguishes a car power-cut from a PMIC
# brownout or watchdog reset when reconstructing an incident later.
# power_reset is a Pi 5 PMIC flag (all zeros = clean power-on); throttled
# bit 0 = undervoltage since boot.
log "Boot reason: power_reset=$(od -An -tx1 /proc/device-tree/chosen/power/power_reset 2>/dev/null | tr -d ' \n' || true) throttled=$(vcgencmd get_throttled 2>/dev/null | cut -d= -f2 || true)"

set_sys_param /proc/sys/vm/dirty_background_bytes DIRTY_BACKGROUND_BYTES 65536
set_sys_param /proc/sys/vm/dirty_ratio DIRTY_RATIO 80
set_sys_param /sys/devices/system/cpu/cpufreq/policy0/scaling_governor CPU_GOVERNOR conservative

/root/bin/temperature_monitor &

# The cam-disk workers used to be spawned only when cam_disk.bin existed
# at startup, so a late SSD enumeration (slow USB bridge, transient
# "SSD not found") left the service "active" for the whole boot with no
# snapshots, no free-space/inode management, and no gadget watchdog.
# Wait for the disk instead; when it is present at boot (the normal
# case) the workers start immediately, exactly as before.
#
# Supervise, don't just spawn: these workers are infinite loops, so any
# exit is abnormal (OOM kill, crash). Losing freespacemanager silently
# would re-open the very failure it watches for — links accumulating
# until /mutable is inode-full with the service still "active". Restart
# the trio together; the 10s pause keeps a crash-looping worker from
# spinning the CPU.
function camdiskworkers {
  echo -n camdiskworkers > /proc/self/comm
  until has_cam_disk && usb_storage_ready
  do
    sleep 10
  done
  local snap_pid fsm_pid gsw_pid
  while true
  do
    snapshotloop &
    snap_pid=$!
    freespacemanager &
    fsm_pid=$!
    gadget_stall_watchdog &
    gsw_pid=$!
    # `|| true` is load-bearing: the script runs under -e, and wait -n
    # returns the dead worker's nonzero status — without the guard the
    # supervisor itself dies before it can log, reap, or restart.
    wait -n || true
    log "cam-disk worker exited unexpectedly; restarting snapshot/space/watchdog workers"
    kill "$snap_pid" "$fsm_pid" "$gsw_pid" 2>/dev/null || true
    wait 2>/dev/null || true
    sleep 10
  done
}

# A previous instance may have died mid-reclaim with the cam partition still
# mounted; release it now. If that fails, every fsck refuses to run and
# every connect refuses to present the drive (retrying the release) until
# it is gone.
# The car may have had the drive since any earlier reclaim.
rm -f "$EXFAT_RECLAIM_STAMP"
release_exfat_reclaim_mount "Unmounting $EXFAT_RECLAIM_MOUNT left by an interrupted reclaim" ||
  log "ERROR: disk images stay unpresented until $EXFAT_RECLAIM_MOUNT is released"

if ! has_cam_disk
then
  log "cam disk not present yet; snapshot/space/watchdog workers will start when it appears"
fi
camdiskworkers &
logrotator &
wifichecker &
timesyncloop &
kmsgmirror &

# Mount ordering does not guarantee a successful mount. Keep the web/API
# available while storage is missing; the archive worker waits here and
# resumes automatically if the mount/image becomes available later.
wait_for_usb_storage

# Travel Mode crash-restart guard: the service runs with Restart=always, so
# any archiveloop crash re-enters this startup path with the system still in
# whatever state the crash left it. The configfs gadget survives process
# death — after a service restart (as opposed to a reboot) the car is still
# connected and writing through it. Running the normal startup sequence in
# that state would fsck-repair cam_disk.bin while the car writes to it (two
# writers on one block device), run a cleaning pass, and cycle the gadget:
# exactly the mid-trip disconnect Travel Mode exists to prevent. Skip it all
# and leave the gadget untouched — archiving reads snapshots, not the live
# image, so nothing downstream needs this. After a real reboot UDC is empty
# (usb_gadget_is_active fails), so the full sequence still runs and the car
# re-enumerates the drive as it always does after boot.
if travel_mode_active && usb_gadget_is_active
then
  log "Travel Mode: USB gadget still bound at startup (service restart) — keeping it connected; skipping boot-time fsck, cleaning and gadget cycle"
  status_led_archive ready
  # a crashed run may have left a stale in-progress marker
  clear_archive_status
  if has_cam_disk
  then
    # default (fsck) mode is safe here: it runs on the reflink copy, never
    # the live image — same as every mid-loop snapshot while the car records
    /root/bin/make_snapshot.sh || log "ERROR: make_snapshot.sh failed (exit $?)"
  fi
else
  # Cleanup/connect below check images only after successful USB teardown.
  if has_cam_disk
  then
    # always remove files that fsck recoverd
    if [ -e "$CAM_CLEANUP_PENDING" ]
    then
      log "Completing cam cleanup deferred from an interrupted archive"
      clean_cam_mount freespace || log "ERROR: boot cam cleanup (freespace) failed"
    else
      clean_cam_mount boot || log "ERROR: boot cam cleanup failed"
    fi
  fi

  # Present the drive to the car BEFORE the boot snapshot. The snapshot is
  # a reflink copy of the live image — safe while the car writes, exactly
  # like every mid-loop snapshot — and taking it here used to cost the car
  # ~50 extra seconds without a drive on every power-on. The lock chime is
  # synced inside connect (before enable), so the car still sees a single
  # plug-in with everything already in place.
  connect_usb_at_startup
  status_led_archive ready

  if has_cam_disk
  then
    # Snapshot immediately — no waitforidle. In sentry mode the car never
    # idles for the 5s gap, so waitforidle would burn its full 90s cap on
    # every boot AND widen the window in which the car can rotate away
    # clips before this snapshot captures them. A mid-write copy is fine:
    # make_snapshot fscks the copy (default mode), and a partial in-flight
    # clip was always possible across the power-loss boundary anyway.
    /root/bin/make_snapshot.sh || log "ERROR: boot make_snapshot.sh failed (exit $?)"
    save_clock_checkpoint || true
  fi
fi

if archive_is_reachable
then
  status_led_archive working

  set_time

  # Seed RTC with NTP-corrected time on first boot
  if [ "${RTC_BATTERY_ENABLED:-false}" = "true" ] && isPi5; then
    rtc_sync_systohc || true
  fi

  # A large clock step can cause NetworkManager to drop the WiFi
  # connection (it thinks the DHCP lease expired). Re-verify and recover.
  if ! archive_is_reachable; then
    log "Network lost after time adjustment, waiting for recovery..."
    wait_for_archive_to_be_reachable
  fi

  # Travel Mode: skip keep-awake. On the road the car is driving or in
  # Sentry (won't sleep), so it's unnecessary. awake_stop is NOT gated:
  # it is Travel Mode-aware internally (skips the Sentry-OFF command,
  # still reaps the nudge loop / BLE lock), so calling it unconditionally
  # covers the case where Travel Mode was enabled mid-cycle after
  # awake_start already spawned the nudge loop.
  archive_cycle_begin
  if ! travel_mode_active; then
    /root/bin/awake_start || true
  fi

  run_archive_cycle

  auto_update_after_archive || log "Automatic update handoff failed"
  /root/bin/awake_stop || true

  status_led_archive ready

  # archive_clips already ensured when needed; do not force another full cycle.
  if archive_is_reachable && ! travel_mode_active; then
    ensure_usb_drives_connected || log "ERROR: failed to ensure USB gadget after archive cycle"
  fi

  archive_cycle_end
  if [ "${ARCHIVE_CYCLE_CANCELLED:-0}" = 1 ]; then archive_cancel_cleanup; fi
  wait_after_archive_cycle
fi

while true
do
  status_led_archive ready

  wait_for_archive_to_be_reachable

  status_led_archive working

  set_time

  # Sync NTP-corrected time to RTC battery
  if [ "${RTC_BATTERY_ENABLED:-false}" = "true" ] && isPi5; then
    rtc_sync_systohc || true
  fi

  # A large clock step can cause NetworkManager to drop the WiFi
  # connection (it thinks the DHCP lease expired). Re-verify and recover.
  if ! archive_is_reachable; then
    log "Network lost after time adjustment, waiting for recovery..."
    wait_for_archive_to_be_reachable
  fi

  # Travel Mode: skip keep-awake; awake_stop stays unconditional
  # (see rationale at the first archive above).
  archive_cycle_begin
  if ! travel_mode_active; then
    /root/bin/awake_start || true
  fi

  archive_run_command sleep "${ARCHIVE_DELAY:-20}" || true

  # take a snapshot before archive_clips starts deleting files
  if has_cam_disk && ! archive_cancel_requested
  then
    if ! /root/bin/make_snapshot.sh; then
      log "ERROR: make_snapshot.sh failed (exit $?)"
    fi
  fi

  run_archive_cycle

  auto_update_after_archive || log "Automatic update handoff failed"
  /root/bin/awake_stop || true

  status_led_archive ready

  if archive_is_reachable && ! travel_mode_active; then
    ensure_usb_drives_connected || log "ERROR: failed to ensure USB gadget after archive cycle"
  fi

  archive_cycle_end
  if [ "${ARCHIVE_CYCLE_CANCELLED:-0}" = 1 ]; then archive_cancel_cleanup; fi
  wait_after_archive_cycle

  check_if_usb_gadget_is_mounted
done
